# =============================================================================
# prime-ltd.su — generated redirects (do not edit by hand)
# Source: src/data/blog-redirects.json + cases-redirects.json
# Regenerate: node scripts/generate-blog-htaccess.mjs
# Posts: 830 · Pages: 11 · Projects: 42
# =============================================================================

# Branded Astro 404 (dist/404.html)
ErrorDocument 404 /404.html

# --- Security headers (keep in generator — file is fully rewritten) ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# --- Legal docs: PNG → lighter WebP ---
RewriteRule ^docs/politics-prime-ltd\.png$ /docs/politics-prime-ltd.webp [R=301,L]
RewriteRule ^docs/cookies-prime-ltd\.png$ /docs/cookies-prime-ltd.webp [R=301,L]
RewriteRule ^docs/rules-recommendation-prime-ltd\.png$ /docs/rules-recommendation-prime-ltd.webp [R=301,L]

# --- Content images: legacy jpg/png/gif → webp (if webp exists) ---
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} ^/(.+)\.(jpe?g|png|gif)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/%1.webp -f
RewriteRule ^(.+)\.(jpe?g|png|gif)$ /$1.webp [R=301,L,NC]

# --- Legacy service / utility pages (old WP) ---
RewriteRule ^contact/?$ /kontakty/ [R=301,L]
RewriteRule ^tehnicheskaya-podderzhka-sayta-obsluzhivanie-i-soprovozhdenie-proektov/?$ /tehpodderzhka-sayta/ [R=301,L]
RewriteRule ^projects/?$ /keysy/ [R=301,L]
RewriteRule ^vakansii/?$ /partnerstvo/ [R=301,L]
RewriteRule ^nashi-servisy/?$ / [R=301,L]
RewriteRule ^bannernaya-reklama/?$ /kontekstnaya-reklama/ [R=301,L]
RewriteRule ^integratsiya-s-marketpleysami/?$ /razrabotka-saytov/ [R=301,L]
RewriteRule ^feed/?$ /blog/rss.xml [R=301,L]
RewriteRule ^blog/feed/?$ /blog/rss.xml [R=301,L]
RewriteRule ^sitemap\.xml/?$ /sitemap-index.xml [R=301,L]
RewriteRule ^sitemap_index\.xml/?$ /sitemap-index.xml [R=301,L]

# --- Legacy WP portfolio: /project/{slug}/ → /keysy/... ---
