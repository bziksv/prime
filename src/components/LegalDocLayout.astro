---
import SiteSeo from "./SiteSeo.astro";
import type { Locale } from "../i18n/locales";

interface Props {
  title: string;
  description: string;
  path: string;
  locale?: Locale;
}

const { title, description, path, locale = "en" } = Astro.props;
const year = new Date().getFullYear();
const htmlLang = locale === "ru" ? "ru" : locale === "es" ? "es" : "en";
const ogLocale = locale === "ru" ? "ru_RU" : locale === "es" ? "es_ES" : "en_US";
const homeHref = locale === "ru" ? "/" : `/${locale}/`;
const nav =
  locale === "es"
    ? {
        back: "← Inicio en español",
        aria: "Documentos legales",
        consent: "Consentimiento",
        privacy: "Política de privacidad",
        cookies: "Política de cookies",
        recommendations: "Tecnologías de recomendación",
        consentHref: "/es/legal/consent/",
        privacyHref: "/es/legal/privacy/",
        cookiesHref: "/es/legal/cookies/",
        recommendationsHref: "/es/legal/recommendations/",
      }
    : locale === "ru"
      ? {
          back: "← На главную",
          aria: "Правовые документы",
          consent: "Согласие на обработку ПДн / Consent to personal data processing",
          privacy: "Политика обработки персональных данных / Privacy policy",
          cookies: "Политика cookie / Cookie policy",
          recommendations: "Рекомендательные технологии / Recommendation technologies",
          consentHref: "/legal/consent/",
          privacyHref: "/legal/privacy/",
          cookiesHref: "/legal/cookies/",
          recommendationsHref: "/legal/recommendations/",
        }
      : {
          back: "← English homepage",
          aria: "Legal documents",
          consent: "Consent to personal data processing",
          privacy: "Privacy policy",
          cookies: "Cookie policy",
          recommendations: "Recommendation technologies",
          consentHref: "/en/legal/consent/",
          privacyHref: "/en/legal/privacy/",
          cookiesHref: "/en/legal/cookies/",
          recommendationsHref: "/en/legal/recommendations/",
        };

const operatorMeta =
  locale === "ru"
    ? "Оператор: ООО «ПРАЙМ» (PRIME LLC) · Воронеж, Россия ·"
    : locale === "es"
      ? "Operador: PRIME LLC (ООО «ПРАЙМ») · Vorónezh, Rusia ·"
      : "Operator: PRIME LLC (ООО «ПРАЙМ») · Voronezh, Russia ·";
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <SiteSeo
      title={title}
      description={description}
      path={path}
      locale={ogLocale}
      siteName={locale === "ru" ? "ПРАЙМ" : "PRIME"}
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        --legal-bg: #0f1419;
        --legal-panel: #171d25;
        --legal-text: #e8eef5;
        --legal-muted: #9aa8b8;
        --legal-accent: #2ec4b6;
        --legal-border: rgba(255, 255, 255, 0.08);
      }
      * {
        box-sizing: border-box;
      }
      body.legal-page {
        margin: 0;
        min-height: 100vh;
        font-family: "Plus Jakarta Sans", system-ui, sans-serif;
        background:
          radial-gradient(900px 420px at 12% -10%, rgba(46, 196, 182, 0.12), transparent 60%),
          var(--legal-bg);
        color: var(--legal-text);
        line-height: 1.55;
      }
      .legal-shell {
        width: min(1120px, calc(100% - 2rem));
        margin: 0 auto;
        padding: 1.5rem 0 3rem;
      }
      .legal-top {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 1.5rem;
      }
      .legal-brand {
        font-family: "Space Grotesk", sans-serif;
        font-weight: 700;
        letter-spacing: 0.02em;
        color: var(--legal-text);
        text-decoration: none;
      }
      .legal-brand em {
        font-style: normal;
        color: var(--legal-accent);
      }
      .legal-back {
        color: var(--legal-accent);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
      }
      .legal-back:hover {
        text-decoration: underline;
      }
      .legal-card {
        background: var(--legal-panel);
        border: 1px solid var(--legal-border);
        border-radius: 16px;
        padding: 1.5rem 1.35rem 1.75rem;
      }
      @media (min-width: 700px) {
        .legal-card {
          padding: 2rem 2.25rem 2.25rem;
        }
      }
      .legal-card h1 {
        margin: 0 0 0.5rem;
        font-family: "Space Grotesk", sans-serif;
        font-size: clamp(1.35rem, 3vw, 1.85rem);
        line-height: 1.25;
      }
      .legal-card .legal-lead {
        margin: 0 0 1.25rem;
        color: var(--legal-muted);
        font-size: 0.95rem;
      }
      .legal-card h2 {
        margin: 1.5rem 0 0.55rem;
        font-size: 1.05rem;
        font-family: "Space Grotesk", sans-serif;
      }
      .legal-card p,
      .legal-card li {
        color: #d5dde7;
        font-size: 0.95rem;
      }
      .legal-card p {
        margin: 0 0 0.75rem;
      }
      .legal-card ul {
        margin: 0 0 0.85rem;
        padding-left: 1.15rem;
      }
      .legal-card li + li {
        margin-top: 0.35rem;
      }
      .legal-card a {
        color: var(--legal-accent);
      }
      .legal-card h3 {
        margin: 1.15rem 0 0.45rem;
        font-size: 0.98rem;
        font-family: "Space Grotesk", sans-serif;
      }
      .legal-card table {
        width: 100%;
        border-collapse: collapse;
        table-layout: fixed;
        margin: 0.75rem 0 1rem;
        font-size: 0.82rem;
      }
      .legal-card th,
      .legal-card td {
        border: 1px solid var(--legal-border);
        padding: 0.55rem 0.65rem;
        text-align: left;
        vertical-align: top;
        color: #d5dde7;
        white-space: normal;
        overflow-wrap: anywhere;
        word-break: break-word;
      }
      .legal-card th {
        background: rgba(255, 255, 255, 0.06);
        color: var(--legal-text);
        font-weight: 600;
      }
      /* 2-col terms: term narrow, definition gets the rest */
      .legal-card table:not(:has(th:nth-child(3))) th:first-child,
      .legal-card table:not(:has(th:nth-child(3))) td:first-child {
        width: 32%;
      }
      .legal-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        margin: 0.75rem 0 1.25rem;
        padding-bottom: 0.25rem;
        border: 1px solid var(--legal-border);
        border-radius: 10px;
        background: rgba(0, 0, 0, 0.18);
      }
      .legal-scroll table {
        margin: 0;
        min-width: 0;
      }
      #prilozhenie-1 {
        scroll-margin-top: 1.5rem;
      }
      .legal-meta {
        margin-top: 1.75rem;
        padding-top: 1rem;
        border-top: 1px solid var(--legal-border);
        color: var(--legal-muted);
        font-size: 0.85rem;
      }
      .legal-nav {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1rem;
        margin-top: 1.25rem;
        font-size: 0.9rem;
      }
      .legal-nav a {
        color: var(--legal-accent);
        text-decoration: none;
        font-weight: 600;
      }
      .legal-nav a:hover {
        text-decoration: underline;
      }
      .legal-foot {
        margin-top: 1.25rem;
        color: var(--legal-muted);
        font-size: 0.8rem;
        text-align: center;
      }
    </style>
  </head>
  <body class="legal-page">
    <div class="legal-shell">
      <div class="legal-top">
        <a class="legal-brand" href={homeHref}>{locale === "ru" ? "ПРАЙ" : "PRIM"}<em>{locale === "ru" ? "М" : "E"}</em></a>
        <a class="legal-back" href={homeHref}>{nav.back}</a>
      </div>
      <article class="legal-card">
        <slot />
        <nav class="legal-nav" aria-label={nav.aria}>
          <a href={nav.consentHref}>{nav.consent}</a>
          <a href={nav.privacyHref}>{nav.privacy}</a>
          <a href={nav.cookiesHref}>{nav.cookies}</a>
          <a href={nav.recommendationsHref}>{nav.recommendations}</a>
        </nav>
        <p class="legal-meta">
          {operatorMeta}
          <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
        </p>
      </article>
      <p class="legal-foot">© 2015–{year} PRIME</p>
    </div>
  </body>
</html>
