---
import { caseCategories } from "../data/cases";
import type { CaseCategoryId } from "../data/cases";
import {
  casesIndexPath,
  categoryPath,
  localizeCategory,
} from "../i18n/cases";
import type { Locale } from "../i18n/locales";

interface Props {
  active?: CaseCategoryId | "all";
  locale?: Locale;
}

const { active = "all", locale = "ru" } = Astro.props;
const allHref = casesIndexPath(locale);
const cats = caseCategories.map((c) => localizeCategory(c, locale));
const ariaLabel = locale === "en" ? "Case categories" : "Категории кейсов";
const allLabel = locale === "en" ? "All work" : "Все кейсы";
---

<nav class="k-filters" aria-label={ariaLabel}>
  <a
    href={allHref}
    class:list={["k-filter", active === "all" && "is-active"]}
    aria-current={active === "all" ? "page" : undefined}
  >
    {allLabel}
  </a>
  {
    cats.map((c) => (
      <a
        href={categoryPath(c.id, locale)}
        class:list={["k-filter", active === c.id && "is-active"]}
        style={`--k-accent:${c.accent}`}
        aria-current={active === c.id ? "page" : undefined}
      >
        {c.title}
      </a>
    ))
  }
</nav>
