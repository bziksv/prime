---
/**
 * Checkbox label: «Даю согласие на обработку персональных данных.»
 * Both «согласие» and «персональных данных» are links.
 */
import { getLegalDocs } from "../data/legal";
import type { Locale } from "../i18n/locales";

interface Props {
  locale?: Locale;
  before: string;
  consent: string;
  mid: string;
  data: string;
}

const { locale = "ru", before, consent, mid, data } = Astro.props;
const docs = getLegalDocs(locale);
const linkAttrs = {
  class: "cookie-link",
  target: "_blank",
  rel: "nofollow noopener noreferrer",
} as const;
---

<span>
  {before}{" "}
  <a {...linkAttrs} href={docs.consent}>{consent}</a>
  {" "}{mid}{" "}
  <a {...linkAttrs} href={docs.privacy}>{data}</a>.
</span>
