            class="home-locale-offer"
            hidden
            role="dialog"
            aria-label={t.localeOfferTitle}
            data-locale-offer
            data-offer-target="en"
            data-offer-href="/en/"
          >
            <div class="home-locale-offer__inner">
              <div>
                <strong>{t.localeOfferTitle}</strong>
                <p>{t.localeOfferText}</p>
              </div>
              <div class="home-locale-offer__actions">
                <a class="v6-btn home-btn-glow" href="/en/" data-locale-offer-accept data-locale-set="en"
