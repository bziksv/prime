---
import { v6Icons } from "../data/v6-media";

interface Props {
  active?: "home" | "partnerstvo" | "cases" | "kontakty" | "blog";
  serviceActive?: string;
}

const { active, serviceActive } = Astro.props;

const services = [
  { title: "Продвижение сайта", href: "/prodvizhenie-sayta/", key: "seo" },
  { title: "Контекстная реклама", href: "/kontekstnaya-reklama/", key: "ads" },
  { title: "Разработка сайтов", href: "/razrabotka-saytov/", key: "web" },
  { title: "Управление репутацией", href: "/upravlenie-reputaciej/", key: "orm" },
  { title: "Аудит сайта", href: "/audit-sayta/", key: "audit" },
  { title: "Техподдержка сайта", href: "/tehpodderzhka-sayta/", key: "support" },
  { title: "Сквозная аналитика", href: "/skvoznaya-analitika/", key: "analytics" },
  { title: "Продвижение по трафику", href: "/prodvizhenie-sayta-po-trafiku/", key: "traffic" },
];

const navTop = [
  { label: "О компании", href: "/#about", key: "home" },
];

const navBottom = [
  { label: "Наши кейсы", href: "/keysy/", key: "cases" },
  { label: "Блог", href: "/blog/", key: "blog" },
  { label: "Партнерство", href: "/partnerstvo/", key: "partnerstvo" },
  { label: "Контакты", href: "/kontakty/", key: "kontakty" },
];
---

<a class="v6-skip" href="#main">К содержанию</a>
<aside id="v6-sidebar" class="v6-sidebar" aria-label="Навигация сайта">
  <div class="v6-sidebar__head">
    <a href="/" class="v6-sidebar__logo">
      <img src={v6Icons.logoMark} alt="" width="44" height="44" />
      <span class="v6-sidebar__brand">
        <span class="v6-sidebar__name">ПРАЙМ</span>
        <span class="v6-sidebar__tagline">Интернет-маркетинг</span>
      </span>
    </a>
    <div class="v6-sidebar__stripe" aria-hidden="true"></div>
  </div>

  <nav class="v6-nav">
    {
      navTop.map((item) => (
        <a
          href={item.href}
          class={active === item.key ? "is-active" : undefined}
          aria-current={active === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
    <details class="v6-nav__group" open>
      <summary>Наши услуги</summary>
      <div class="v6-nav__sub">
        {services.map((s) => (
          <a
            href={s.href}
            class={serviceActive === s.key ? "is-active" : undefined}
            aria-current={serviceActive === s.key ? "page" : undefined}
          >
            {s.title}
          </a>
        ))}
      </div>
    </details>
    {
      navBottom.map((item) => (
        <a
          href={item.href}
          class={active === item.key ? "is-active" : undefined}
          aria-current={active === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="v6-sidebar__foot">
    <a href="tel:+74732030124">+7 (473) 203-01-24</a>
    <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
    <div class="v6-sidebar__social">
      <a href="https://vk.com/primeltd" target="_blank" rel="noopener" aria-label="VK">VK</a>
      <a href="https://t.me/bziksv" target="_blank" rel="noopener" aria-label="Telegram">TG</a>
    </div>
  </div>
</aside>

<div id="v6-backdrop" class="v6-backdrop" aria-hidden="true"></div>
