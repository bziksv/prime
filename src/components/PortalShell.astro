---
import { v6Icons } from "../data/v6-media";
import { contacts } from "../data/contacts";
import {
  getHomeContent,
  homePath,
  homeServiceHref,
} from "../i18n/home-content";
import { partnerPath } from "../i18n/partnerstvo-content";
import { contactsPath } from "../i18n/contacts-content";
import { blogIndexPath } from "../i18n/blog";
import { casesIndexPath } from "../i18n/cases";
import type { Locale } from "../i18n/locales";

interface Props {
  active?: "home" | "partnerstvo" | "cases" | "kontakty" | "blog";
  serviceActive?: string;
  locale?: Locale;
}

const { active, serviceActive, locale = "ru" } = Astro.props;
const t = getHomeContent(locale);
const path = homePath(locale);
const showPhone = locale === "ru";

const navBottom = [
  { label: t.navCases, href: casesIndexPath(locale), key: "cases" as const },
  { label: t.navBlog, href: blogIndexPath(locale), key: "blog" as const },
  { label: t.navPartnership, href: partnerPath(locale), key: "partnerstvo" as const },
  { label: t.navContacts, href: contactsPath(locale), key: "kontakty" as const },
];
---

<a class="v6-skip" href="#main">{t.skipToContent}</a>
<aside id="v6-sidebar" class="v6-sidebar" aria-label={t.navAria}>
  <div class="v6-sidebar__head">
    <a href={path} class="v6-sidebar__logo">
      <img src={v6Icons.logoMark} alt="" width="44" height="44" />
      <span class="v6-sidebar__brand">
        <span class="v6-sidebar__name">{t.brandName}</span>
        <span class="v6-sidebar__tagline">{t.brandTagline}</span>
      </span>
    </a>
    <div class="v6-sidebar__stripe" aria-hidden="true"></div>
  </div>

  <nav class="v6-nav">
    <a
      href={locale === "ru" ? "/#about" : "/en/#about"}
      class={active === "home" ? "is-active" : undefined}
      aria-current={active === "home" ? "page" : undefined}
    >
      {t.navAbout}
    </a>
    <details class="v6-nav__group" open>
      <summary>{t.navServices}</summary>
      <div class="v6-nav__sub">
        {
          t.services.map((s) => (
            <a
              href={homeServiceHref(s.cat, locale)}
              class={serviceActive === s.cat ? "is-active" : undefined}
              aria-current={serviceActive === s.cat ? "page" : undefined}
            >
              {s.title}
            </a>
          ))
        }
      </div>
    </details>
    {
      navBottom.map((item) => (
        <a
          href={item.href}
          class={active === item.key ? "is-active" : undefined}
          aria-current={active === item.key ? "page" : undefined}
        >
          {item.label}
        </a>
      ))
    }
  </nav>

  <div class="v6-sidebar__foot">
    {showPhone ? <a href={contacts.phoneHref}>{contacts.phone}</a> : null}
    <a href={contacts.emailHref}>{contacts.email}</a>
    <div class="v6-sidebar__social">
      <!--noindex--><a href="https://vk.com/primeltd" target="_blank" rel="nofollow noopener noreferrer" aria-label="VK">VK</a><!--/noindex-->
      <!--noindex--><a href="https://t.me/bziksv" target="_blank" rel="nofollow noopener noreferrer" aria-label="Telegram">TG</a><!--/noindex-->
    </div>
  </div>
</aside>

<div id="v6-backdrop" class="v6-backdrop" aria-hidden="true"></div>
