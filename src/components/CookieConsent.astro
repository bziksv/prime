---
import { legalDocs } from "../data/legal";

const linkAttrs = {
  class: "cookie-link",
  target: "_blank",
  rel: "nofollow noopener noreferrer",
} as const;
---

<aside
  id="v6-cookie-bar"
  class="v6-cookie-bar"
  role="dialog"
  aria-label="Уведомление о cookie"
  hidden
>
  <div class="v6-cookie-bar__stripe" aria-hidden="true"></div>
  <div class="v6-cookie-bar__inner">
    <div class="v6-cookie-bar__copy">
      <p class="v6-cookie-bar__title">Cookies и рекомендации</p>
      <p class="v6-cookie-bar__text">
        Используем{" "}
        <a {...linkAttrs} href={legalDocs.cookies}>cookie-файлы</a>
        {" "}и{" "}
        <a {...linkAttrs} href={legalDocs.recommendations}>рекомендательные технологии</a>
        {" "}для работы сайта, рекламы и статистики. Продолжая пользоваться сайтом, вы соглашаетесь
        с обработкой данных согласно{" "}
        <a {...linkAttrs} href={legalDocs.privacy}>политике конфиденциальности</a>.
      </p>
    </div>
    <button type="button" class="v6-cookie-bar__btn" id="v6-cookie-accept">Принять</button>
  </div>
</aside>
