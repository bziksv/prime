---
import { getLegalDocs } from "../data/legal";
import YandexMetrika from "./YandexMetrika.astro";
import type { Locale } from "../i18n/locales";

interface Props {
  locale?: Locale;
}

const { locale = "ru" } = Astro.props;
const docs = getLegalDocs(locale);

const linkAttrs = {
  class: "cookie-link",
  target: "_blank",
  rel: "nofollow noopener noreferrer",
} as const;

const copy =
  locale === "ru"
    ? {
        aria: "Уведомление о cookie",
        title: "Cookies и рекомендации",
        beforeCookies: "Используем",
        cookies: "cookie-файлы",
        mid: "для работы сайта, рекламы и статистики. Продолжая использовать сайт, вы даёте",
        consent: "согласие на обработку персональных данных",
        and2: "и подтверждаете, что ознакомлены с",
        privacy: "политикой обработки персональных данных",
        and3: "и",
        recommendationsRules: "правилами применения рекомендательных технологий",
        accept: "Принять",
      }
    : locale === "es"
      ? {
          aria: "Aviso de cookies",
          title: "Cookies y recomendaciones",
          beforeCookies: "Usamos",
          cookies: "cookies",
          mid: "para el sitio, la publicidad y la analítica. Al continuar usando el sitio, das tu",
          consent: "consentimiento para el tratamiento de datos personales",
          and2: "y confirmas que conoces la",
          privacy: "política de tratamiento de datos personales",
          and3: "y las",
          recommendationsRules: "normas de uso de las tecnologías de recomendación",
          accept: "Aceptar",
        }
      : {
          aria: "Cookie notice",
          title: "Cookies and recommendations",
          beforeCookies: "We use",
          cookies: "cookies",
          mid: "for the site, ads and analytics. By continuing to use the site, you give your",
          consent: "consent to personal data processing",
          and2: "and confirm that you have read the",
          privacy: "personal data processing policy",
          and3: "and the",
          recommendationsRules: "rules for recommendation technologies",
          accept: "Accept",
        };
---

<aside
  id="v6-cookie-bar"
  class="v6-cookie-bar"
  role="dialog"
  aria-label={copy.aria}
  hidden
>
  <div class="v6-cookie-bar__stripe" aria-hidden="true"></div>
  <div class="v6-cookie-bar__inner">
    <div class="v6-cookie-bar__copy">
      <p class="v6-cookie-bar__title">{copy.title}</p>
      <p class="v6-cookie-bar__text">
        {copy.beforeCookies}{" "}
        <a {...linkAttrs} href={docs.cookies}>{copy.cookies}</a>{" "}{copy.mid}{" "}
        <a {...linkAttrs} href={docs.consent}>{copy.consent}</a>
        {" "}{copy.and2}{" "}
        <a {...linkAttrs} href={docs.privacy}>{copy.privacy}</a>
        {" "}{copy.and3}{" "}
        <a {...linkAttrs} href={docs.recommendations}>{copy.recommendationsRules}</a>.
      </p>
    </div>
    <button type="button" class="v6-cookie-bar__btn" id="v6-cookie-accept">{copy.accept}</button>
  </div>
</aside>

{locale === "ru" ? <YandexMetrika /> : null}
