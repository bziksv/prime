---
interface Alternate {
  hreflang: string;
  path: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  /** ISO date (YYYY-MM-DD or full) for og:article */
  publishedTime?: string;
  modifiedTime?: string;
  /** og:locale, default ru_RU */
  locale?: string;
  /** og:site_name */
  siteName?: string;
  /** hreflang alternates for this URL */
  alternates?: Alternate[];
}

const {
  title,
  description,
  path,
  image = "/images/v6/og-cover.webp",
  type = "website",
  noindex = false,
  publishedTime,
  modifiedTime,
  locale = "ru_RU",
  siteName = "ПРАЙМ",
  alternates = [],
} = Astro.props;

const origin = Astro.site?.origin ?? "https://prime-ltd.su";
const url = new URL(path.startsWith("/") ? path : `/${path}`, origin).href;
const imageUrl = image.startsWith("http") ? image : new URL(image, origin).href;

function toIsoDay(value?: string): string | undefined {
  if (!value) return undefined;
  const d = new Date(value);
  if (Number.isNaN(d.getTime())) return value;
  return d.toISOString();
}

const publishedIso = toIsoDay(publishedTime);
const modifiedIso = toIsoDay(modifiedTime || publishedTime);
---

<meta
  name="google-site-verification"
  content="CPRZwnaQaHuL9CdQ6_ShuiTHQ_pGQcSeIRXc0OczX3g"
/>
<link rel="canonical" href={url} />
<link rel="apple-touch-icon" href="/images/v6/apple-touch-icon.png" sizes="180x180" />
{
  alternates.map((alt) => (
    <link
      rel="alternate"
      hreflang={alt.hreflang}
      href={new URL(alt.path.startsWith("/") ? alt.path : `/${alt.path}`, origin).href}
    />
  ))
}
{noindex ? <meta name="robots" content="noindex" /> : null}
<meta property="og:type" content={type} />
<meta property="og:locale" content={locale} />
<meta property="og:site_name" content={siteName} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={imageUrl} />
{
  type === "article" && publishedIso ? (
    <meta property="article:published_time" content={publishedIso} />
  ) : null
}
{
  type === "article" && modifiedIso ? (
    <meta property="article:modified_time" content={modifiedIso} />
  ) : null
}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
