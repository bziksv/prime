---
import CaseGrid from "../CaseGrid.astro";
import type { CaseStudy } from "../../data/cases";
import {
  casePath,
  casesIndexPath,
  categoryPath,
  getCaseUi,
  getLocalizedCategory,
  getRelatedCasesLocalized,
  isCaseTranslated,
} from "../../i18n/cases";
import { homePath } from "../../i18n/home-content";
import { contactsPath } from "../../i18n/contacts-content";
import { caseJsonLd } from "../../lib/case-jsonld";
import type { Locale } from "../../i18n/locales";
import CasesLayout from "../../layouts/CasesLayout.astro";

interface Props {
  locale: Locale;
  item: CaseStudy;
}

const { locale, item } = Astro.props;
const ui = getCaseUi(locale);
const cat = getLocalizedCategory(item.category, locale)!;
const related = getRelatedCasesLocalized(item, locale);
const hasStory = Boolean(
  item.painLead ||
    item.pains?.length ||
    item.plainSpeak?.length ||
    item.sections?.length ||
    item.journeyLead,
);
const serviceLine = [cat.short, ...item.services]
  .filter((s, i, arr) => arr.findIndex((x) => x.toLowerCase() === s.toLowerCase()) === i)
  .join(" · ");
const painText = item.painLead || item.challenge;
const journeyText = item.journeyLead || ui.journeyDefault;
const outcomeText = item.outcomeLead || ui.outcomeDefault;

let chapter = 1;
const nPain = String(chapter++).padStart(2, "0");
const nJourney = String(chapter++).padStart(2, "0");
const nPlain = item.plainSpeak?.length ? String(chapter++).padStart(2, "0") : null;
const nSteps = item.sections?.length ? String(chapter++).padStart(2, "0") : null;
const nOutcome = String(chapter++).padStart(2, "0");

const pagePath = casePath(item, locale);
const ruPath = casePath(item, "ru");
const enPath = casePath(item, "en");
const hasAlternate = isCaseTranslated(item.slug, "en");
const alternatePath =
  hasAlternate ? (locale === "en" ? ruPath : enPath) : undefined;

const pageDescription = `${item.metric} ${item.metricLabel}. ${item.summary}`;
const caseLd = caseJsonLd({
  name: item.title,
  description: pageDescription,
  path: pagePath,
  image: item.cover,
  client: item.client,
  providerName: ui.footerBrand,
  origin: Astro.site?.origin ?? "https://prime-ltd.su",
});

const contactsHref = contactsPath(locale);
---

<CasesLayout
  title={`${item.title} ${ui.pageTitleSuffix}`}
  description={pageDescription}
  path={pagePath}
  image={item.cover}
  locale={locale}
  alternatePath={alternatePath}
  ctaHref={contactsHref}
  breadcrumb={[
    { label: ui.breadcrumbHome, href: homePath(locale) },
    { label: ui.breadcrumbCases, href: casesIndexPath(locale) },
    { label: cat.title, href: categoryPath(cat.id, locale) },
    { label: item.client },
  ]}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(caseLd)} />
  <article class="k-case k-case--story" style={`--k-accent:${cat.accent}`}>
    <header class="k-case-head k-case-head--visual k-reveal">
      <div class="k-case-head__copy">
        <p class="k-case-head__line">{serviceLine}</p>
        <h1>{item.title}</h1>
        <p class="k-case-head__lead">{item.summary}</p>
        <div class="k-case-head__bar">
          <p class="k-case-head__metric">
            <strong>{item.metric}</strong>
            <span>{item.metricLabel}</span>
          </p>
          <ul class="k-case-head__meta">
            <li>
              <span>{ui.client}</span>
              <strong>{item.client}</strong>
            </li>
            <li>
              <span>{ui.industry}</span>
              <strong>{item.industry}</strong>
            </li>
            <li>
              <span>{ui.period}</span>
              <strong>{item.period}</strong>
            </li>
            {
              item.siteUrl && (
                <li>
                  <span>{ui.site}</span>
                  <strong>
                    <a href={item.siteUrl} target="_blank" rel="noopener">
                      {item.siteUrl.replace(/^https?:\/\//, "")}
                    </a>
                  </strong>
                </li>
              )
            }
          </ul>
        </div>
      </div>
      <figure class="k-case-head__visual">
        <button
          type="button"
          class="k-zoom k-case-head__frame"
          data-lightbox
          data-src={item.cover}
          data-alt={item.coverAlt}
          data-caption={item.coverAlt}
          aria-label={`${ui.zoomAria}: ${item.coverAlt}`}
        >
          <span class="k-frame__chrome" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
          <span class="k-case-head__shot">
            <img src={item.cover} alt={item.coverAlt} />
          </span>
        </button>
        <figcaption>{item.siteUrl ? ui.liveView : item.coverAlt}</figcaption>
      </figure>
    </header>

    {
      item.intro && (
        <section class="k-story-band k-reveal">
          <p class="k-story-kicker">{ui.aboutClient}</p>
          <p class="k-story-lead">{item.intro}</p>
        </section>
      )
    }

    <section class="k-story k-reveal" aria-labelledby="story-pain">
      <div class="k-story__head">
        <span class="k-story__n">{nPain}</span>
        <div>
          <h2 id="story-pain">{ui.painHeading}</h2>
          <p>{painText}</p>
        </div>
      </div>

      <div class:list={["k-split", !item.before && !item.cover && "k-split--solo"]}>
        <div class="k-split__copy">
          {
            item.pains && item.pains.length > 0 ? (
              <ol class="k-pain-list">
                {item.pains.map((p) => (
                  <li>
                    <h3>{p.title}</h3>
                    <p>{p.text}</p>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="k-story-body">{item.challenge}</p>
            )
          }
        </div>
        {
          (item.before || item.cover) && (
            <figure class="k-split__media">
              <button
                type="button"
                class="k-zoom k-frame"
                data-lightbox
                data-src={item.before?.src ?? item.cover}
                data-alt={item.before?.alt ?? item.coverAlt}
                data-caption={item.before?.caption ?? item.coverAlt}
                aria-label={`${ui.zoomAria}: ${item.before?.alt ?? item.coverAlt}`}
              >
                <span class="k-frame__chrome" aria-hidden="true">
                  <i></i><i></i><i></i>
                </span>
                <img
                  src={item.before?.src ?? item.cover}
                  alt={item.before?.alt ?? item.coverAlt}
                />
              </button>
              <figcaption>{item.before?.caption ?? ui.startingPoint}</figcaption>
            </figure>
          )
        }
      </div>
    </section>

    <section class="k-story k-reveal" aria-labelledby="story-journey">
      <div class="k-story__head">
        <span class="k-story__n">{nJourney}</span>
        <div>
          <h2 id="story-journey">{ui.journeyHeading}</h2>
          <p>{journeyText}</p>
        </div>
      </div>
      <ol class="k-journey">
        {
          item.approach.map((step, i) => (
            <li>
              <span class="k-journey__n">{String(i + 1).padStart(2, "0")}</span>
              <p>{step}</p>
            </li>
          ))
        }
      </ol>
    </section>

    {
      item.plainSpeak && item.plainSpeak.length > 0 && (
        <section class="k-story k-reveal" aria-labelledby="story-plain">
          <div class="k-story__head">
            <span class="k-story__n">{nPlain}</span>
            <div>
              <h2 id="story-plain">{ui.plainSpeakHeading}</h2>
              <p>{ui.plainSpeakLead}</p>
            </div>
          </div>
          <div class="k-plain-grid">
            {item.plainSpeak.map((row) => (
              <article class="k-plain">
                <div class="k-plain__side k-plain__side--tech">
                  <span class="k-plain__label">{ui.plainJargonLabel}</span>
                  <p>{row.jargon}</p>
                </div>
                <div class="k-plain__side k-plain__side--human">
                  <span class="k-plain__label">{ui.plainHumanLabel}</span>
                  <p>{row.plain}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      )
    }

    {
      item.sections && item.sections.length > 0 ? (
        <section class="k-story k-reveal" aria-labelledby="story-steps">
          <div class="k-story__head">
            <span class="k-story__n">{nSteps}</span>
            <div>
              <h2 id="story-steps">{ui.stepsHeading}</h2>
              <p>{ui.stepsLead}</p>
            </div>
          </div>
          <div class="k-chapters">
            {item.sections.map((s, i) => (
              <article class:list={["k-chapter", i % 2 === 1 && "k-chapter--flip"]}>
                <div class="k-chapter__copy">
                  <span class="k-chapter__n">{String(i + 1).padStart(2, "0")}</span>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
                {s.image && (
                  <figure
                    class:list={[
                      "k-chapter__media",
                      s.fit === "contain" && "k-chapter__media--contain",
                    ]}
                  >
                    <button
                      type="button"
                      class="k-zoom k-frame"
                      data-lightbox
                      data-src={s.image}
                      data-alt={s.title}
                      data-caption={s.title}
                      aria-label={`${ui.zoomAria}: ${s.title}`}
                    >
                      <span class="k-frame__chrome" aria-hidden="true">
                        <i></i><i></i><i></i>
                      </span>
                      <img src={s.image} alt={s.title} loading="lazy" />
                    </button>
                  </figure>
                )}
              </article>
            ))}
          </div>
        </section>
      ) : (
        !hasStory &&
        item.cover && (
          <figure class="k-case-cover k-reveal">
            <button
              type="button"
              class="k-zoom"
              data-lightbox
              data-src={item.cover}
              data-alt={item.coverAlt}
              data-caption={item.coverAlt}
              aria-label={`${ui.zoomAria}: ${item.coverAlt}`}
            >
              <img src={item.cover} alt={item.coverAlt} />
            </button>
            <figcaption>{item.coverAlt}</figcaption>
          </figure>
        )
      )
    }

    {
      item.gallery && item.gallery.length > 0 && (
        <section class="k-story k-story--evidence k-reveal" aria-labelledby="story-proof">
          <div class="k-story__head">
            <span class="k-story__n">·</span>
            <div>
              <h2 id="story-proof">{ui.evidenceHeading}</h2>
              <p>{ui.evidenceLead}</p>
            </div>
          </div>
          <div class="k-proof">
            {item.gallery.slice(0, 4).map((g) => (
              <figure class:list={["k-proof__item", g.fit === "contain" && "k-proof__item--contain"]}>
                <button
                  type="button"
                  class="k-zoom k-frame"
                  data-lightbox
                  data-src={g.src}
                  data-alt={g.alt}
                  data-caption={g.caption ?? g.alt}
                  aria-label={`${ui.openAria}: ${g.alt}`}
                >
                  <span class="k-frame__chrome" aria-hidden="true">
                    <i></i><i></i><i></i>
                  </span>
                  <img src={g.src} alt={g.alt} loading="lazy" />
                </button>
                {(g.caption || g.alt) && <figcaption>{g.caption ?? g.alt}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <section class="k-story k-story--outcome k-reveal" aria-labelledby="story-outcome">
      <div class="k-story__head">
        <span class="k-story__n">{nOutcome}</span>
        <div>
          <h2 id="story-outcome">{ui.outcomeHeading}</h2>
          <p>{outcomeText}</p>
        </div>
      </div>

      <div class="k-outcome">
        {
          item.highlights && item.highlights.length > 0 && (
            <div>
              <h3>{ui.highlightsHeading}</h3>
              <ul class="k-case-checks">
                {item.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            </div>
          )
        }
        <div>
          <h3>{ui.resultsHeading}</h3>
          <div class="k-case-kpi">
            {item.results.map((r) => (
              <div>
                <strong>{r.value}</strong>
                <span>{r.label}</span>
              </div>
            ))}
          </div>
          {
            item.quote && (
              <blockquote class="k-case-quote">
                <p>«{item.quote.text}»</p>
                <footer>
                  <strong>{item.quote.author}</strong> — {item.quote.role}
                </footer>
              </blockquote>
            )
          }
        </div>
      </div>
    </section>

    <section class="k-case-cta k-reveal">
      <h2>{item.ctaTitle ?? ui.ctaDefaultTitle}</h2>
      <p>{item.ctaText ?? ui.ctaDefaultText}</p>
      <div class="k-case-cta__actions">
        <a class="k-btn k-btn--primary" href={contactsHref}>{ui.ctaSubmit}</a>
        <a class="k-btn k-btn--ghost" href={categoryPath(cat.id, locale)}>
          {ui.ctaMore} {cat.short}
        </a>
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="k-case-block k-reveal">
          <header class="k-case-block__head">
            <h2>{ui.relatedHeading}</h2>
            <p>{ui.relatedLead}</p>
          </header>
          <CaseGrid cases={related} locale={locale} />
        </section>
      )
    }
  </article>
</CasesLayout>
