---
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import { v6Icons } from "../data/v6-media";

interface Props {
  title: string;
  description: string;
  breadcrumb: { label: string; href?: string }[];
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  title,
  description,
  breadcrumb,
  ctaHref = "/#cta",
  ctaLabel = "Оставить заявку",
} = Astro.props;
---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="keysy">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell active="cases" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">☰</button>
          <p class="v6-breadcrumb">
            {
              breadcrumb.map((b, i) => (
                <span>
                  {i > 0 && " · "}
                  {b.href ? <a href={b.href}>{b.label}</a> : <strong>{b.label}</strong>}
                </span>
              ))
            }
          </p>
          <a href={ctaHref} class="v6-btn">{ctaLabel}</a>
        </header>

        <div class="v6-content">
          <slot />
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Кейсы · SEO · контекст · разработка</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <dialog class="k-lightbox" id="k-lightbox" aria-label="Просмотр изображения">
      <div class="k-lightbox__stage">
        <button type="button" class="k-lightbox__close" data-lightbox-close aria-label="Закрыть">
          ×
        </button>
        <button type="button" class="k-lightbox__nav k-lightbox__nav--prev" data-lightbox-prev aria-label="Предыдущее">
          ‹
        </button>
        <img class="k-lightbox__img" alt="" />
        <button type="button" class="k-lightbox__nav k-lightbox__nav--next" data-lightbox-next aria-label="Следующее">
          ›
        </button>
      </div>
      <p class="k-lightbox__cap" hidden></p>
    </dialog>

    <CookieConsent />
    <script>
      import "../scripts/cases.ts";
    </script>
  </body>
</html>
