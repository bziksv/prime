---
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import DevLangSwitch from "../components/DevLangSwitch.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import { v6Icons } from "../data/v6-media";
import { breadcrumbJsonLd } from "../lib/breadcrumb-jsonld";
import { getCaseUi } from "../i18n/cases";
import { contactsPath } from "../i18n/contacts-content";
import { localeMeta, type Locale } from "../i18n/locales";
import "../styles/home.css";

interface Props {
  title: string;
  description: string;
  path: string;
  image?: string;
  breadcrumb: { label: string; href?: string }[];
  ctaHref?: string;
  ctaLabel?: string;
  locale?: Locale;
  /** RU↔EN alternate when a translation exists */
  alternatePath?: string;
}

const {
  title,
  description,
  path,
  image,
  breadcrumb,
  locale = "ru",
  alternatePath,
  ctaHref = contactsPath(locale),
  ctaLabel,
} = Astro.props;

const ui = getCaseUi(locale);
const htmlLang = localeMeta[locale].hreflang;
const ogLocale = locale === "en" ? "en_US" : locale === "es" ? "es_ES" : "ru_RU";
const resolvedCtaLabel = ctaLabel ?? ui.ctaTop;
const keysyLangTail = path.includes("/keysy")
  ? path.replace(/^\/(en|es)/, "") || path
  : "/keysy/";
const langHrefs = {
  ru: keysyLangTail,
  en: `/en${keysyLangTail}`,
  es: `/es${keysyLangTail}`,
};

const crumbsLd = breadcrumbJsonLd(breadcrumb, {
  origin: Astro.site?.origin ?? "https://prime-ltd.su",
  currentPath: path,
});

const keysyTail = path.replace(/^\/(en|es)/, "") || path;
const alternates = path.includes("/keysy")
  ? [
      { hreflang: "ru", path: keysyTail },
      { hreflang: "en", path: `/en${keysyTail}` },
      { hreflang: "es", path: `/es${keysyTail}` },
      { hreflang: "x-default", path: keysyTail },
    ]
  : alternatePath != null
    ? [
        { hreflang: "ru", path: locale === "ru" ? path : alternatePath },
        { hreflang: "en", path: locale === "en" ? path : alternatePath },
        { hreflang: "x-default", path: locale === "ru" ? path : alternatePath },
      ]
    : [];
---

<!doctype html>
<html lang={htmlLang} data-concept="v6" data-page="keysy" data-locale={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <SiteSeo
      title={title}
      description={description}
      path={path}
      image={image}
      locale={ogLocale}
      siteName={ui.footerBrand}
      alternates={alternates}
    />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell active="cases" locale={locale} />

      <main id="main" class="v6-main">
        <header class="v6-topbar">
          <button
            id="v6-burger"
            type="button"
            class="v6-burger"
            aria-label={ui.menuLabel}
            aria-controls="v6-sidebar"
            aria-expanded="false">☰</button
          >
          <p class="v6-breadcrumb">
            {
              breadcrumb.map((b, i) => (
                <span>
                  {i > 0 && " · "}
                  {b.href ? <a href={b.href}>{b.label}</a> : <strong>{b.label}</strong>}
                </span>
              ))
            }
          </p>
          <div class="home-topbar-actions">
            <DevLangSwitch
              locale={locale}
              ariaLabel={ui.langSwitchAria}
              hrefs={langHrefs}
            />
            <a href={ctaHref} class="v6-btn">{resolvedCtaLabel}</a>
          </div>
        </header>

        <div class="v6-content">
          <slot />
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>{ui.footerBrand}</strong>
            <p>{ui.footerTagline}</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} {ui.footerCopy}</p>
          <CookieFooterNotice locale={locale} />
        </footer>
      </main>
    </div>

    <dialog class="k-lightbox" id="k-lightbox" aria-label={ui.lightboxAria}>
      <div class="k-lightbox__shell">
        <header class="k-lightbox__top">
          <p class="k-lightbox__count" data-lightbox-count></p>
          <button type="button" class="k-lightbox__close" data-lightbox-close aria-label={ui.lightboxClose}>
            {ui.lightboxClose}
          </button>
        </header>

        <div class="k-lightbox__stage">
          <button
            type="button"
            class="k-lightbox__nav k-lightbox__nav--prev"
            data-lightbox-prev
            aria-label={ui.lightboxPrev}
          >
            <span aria-hidden="true">‹</span>
          </button>
          <div class="k-lightbox__frame">
            <div class="k-lightbox__chrome" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <div class="k-lightbox__viewport">
              <img class="k-lightbox__img" alt="" />
            </div>
          </div>
          <button
            type="button"
            class="k-lightbox__nav k-lightbox__nav--next"
            data-lightbox-next
            aria-label={ui.lightboxNext}
          >
            <span aria-hidden="true">›</span>
          </button>
        </div>

        <footer class="k-lightbox__bottom">
          <p class="k-lightbox__cap" data-lightbox-cap></p>
          <div class="k-lightbox__thumbs" data-lightbox-thumbs></div>
        </footer>
      </div>
    </dialog>

    <CookieConsent locale={locale} />
    <script>
      import "../scripts/cases.ts";
      import "../scripts/locale-offer.ts";
    </script>
  </body>
</html>
