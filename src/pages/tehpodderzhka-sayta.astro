---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/tehpodderzhka.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import {
  supportWhy,
  supportServices,
  supportRoles,
  supportTariffs,
  supportPerks,
} from "../data/support-service";
---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="support">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Техподдержка и сопровождение сайта: доработки, контент, дизайн, оплаты, ускорение. Тарифы от 3 до 50 часов с персональным PM и мониторингом."
    />
    <title>Техподдержка сайта — ПРАЙМ</title>
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preload" as="image" href="/images/v6/photos/support-hero.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell serviceActive="support" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Техподдержка сайта</strong>
          </p>
          <a href="#support-cta" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content">
          <section class="p-hero">
            <div class="p-hero__bg" aria-hidden="true" data-parallax-support-bg></div>
            <div class="p-hero__veil" aria-hidden="true"></div>

            <div class="p-hero__copy">
              <p class="p-brand">ПРАЙ<em>М</em></p>
              <h1>
                Техподдержка сайта — сопровождение <span>без штата на зарплате</span>
              </h1>
              <p class="p-hero__lead">
                Доработки, контент, дизайн, оплаты и ускорение. Пул часов
                специалистов + персональный PM и мониторинг доступности.
              </p>
              <div class="p-hero__actions">
                <a href="#tariffs" class="p-btn p-btn--primary">Смотреть тарифы</a>
                <a href="#support-cta" class="p-btn p-btn--ghost">Получить консультацию</a>
              </div>
            </div>

            <div class="p-hero__ops" aria-hidden="true">
              <div class="p-status">
                <span class="p-status__pulse"></span>
                <div>
                  <strong>UPTIME · OK</strong>
                  <span>сайт на сопровождении</span>
                </div>
              </div>
              <div class="p-meters" data-support-meters>
                <div class="p-meter">
                  <div class="p-meter__top">
                    <span>availability</span>
                    <em>99.9%</em>
                  </div>
                  <div class="p-meter__bar"><i></i></div>
                </div>
                <div class="p-meter">
                  <div class="p-meter__top">
                    <span>hours pool</span>
                    <em>ready</em>
                  </div>
                  <div class="p-meter__bar"><i></i></div>
                </div>
                <div class="p-meter">
                  <div class="p-meter__top">
                    <span>tasks / week</span>
                    <em>steady</em>
                  </div>
                  <div class="p-meter__bar"><i></i></div>
                </div>
              </div>
            </div>
          </section>

          <section class="p-section p-reveal">
            <div class="p-section__head">
              <h2>Почему выгоднее отдать сайт в профильную команду</h2>
              <p>
                Найм «своих» часто дороже и медленнее — особенно когда нет опыта
                контролировать IT-работы.
              </p>
            </div>
            <div class="p-why">
              {
                supportWhy.map((item, i) => (
                  <article>
                    <span class="p-why__n">0{i + 1}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="p-section p-reveal">
            <div class="p-section__head">
              <h2>Что входит в поддержку</h2>
              <p>От мелких правок до переноса CMS и ускорения — в рамках часов тарифа.</p>
            </div>
            <div class="p-services">
              {supportServices.map((s) => <div class="p-service">{s}</div>)}
            </div>
          </section>

          <div class="p-perks p-reveal">
            {
              supportPerks.map((perk) => (
                <article class="p-perk">
                  <h3>{perk.title}</h3>
                  <p>{perk.text}</p>
                </article>
              ))
            }
          </div>

          <section class="p-section p-reveal" id="tariffs">
            <div class="p-section__head">
              <h2>Тарифные планы</h2>
              <p>
                В каждый тариф входят часы работы специалистов:
                {supportRoles.map((r, i) => (
                  <>
                    {i === 0 ? " " : i === supportRoles.length - 1 ? " и " : ", "}
                    {r.toLowerCase()}
                  </>
                ))}
                .
              </p>
            </div>
            <div class="p-tariffs">
              {
                supportTariffs.map((t) => (
                  <article
                    class:list={["p-tariff", t.featured && "p-tariff--featured"]}
                  >
                    {t.featured && <span class="p-tariff__badge">Хит</span>}
                    <h3 class="p-tariff__name">{t.name}</h3>
                    <p class="p-tariff__price">{t.price}</p>
                    <p class="p-tariff__hours">
                      {t.hours} {t.hours === 3 ? "часа" : "часов"} / месяц
                    </p>
                    <p>PM + мониторинг сайта в каждом тарифе</p>
                    <div class="p-tariff__roles">
                      {supportRoles.map((r) => (
                        <span>{r}</span>
                      ))}
                    </div>
                    <a href="#support-cta" class="p-btn p-btn--line">Оставить заявку</a>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="support-cta" class="p-cta p-reveal">
            <div>
              <h2>Нужен сайт на сопровождении?</h2>
              <p>
                Перезвоним и проконсультируем по тарифу: подберём объём часов под
                ваши задачи — без раздувания штата.
              </p>
              <div class="p-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="support-form" class="p-form">
              <input type="text" name="name" placeholder="Ваше имя" required />
              <input type="tel" name="phone" placeholder="Телефон" required />
              <input type="url" name="site" placeholder="Адрес сайта" />
              <select name="tariff">
                <option value="">Интересующий тариф</option>
                {supportTariffs.map((t) => <option>{t.name} · {t.price}</option>)}
                <option>Не знаю — нужна консультация</option>
              </select>
              <textarea
                name="message"
                rows="3"
                placeholder="Какие задачи на сопровождении?"></textarea>
              <label class="p-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с нашей{" "}
                  <a
                    class="cookie-link"
                    href={legalDocs.privacy}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    >политикой</a
                  >.
                </span>
              </label>
              <button type="submit" class="p-btn p-btn--primary">Отправить заявку</button>
              <p id="support-form-hint" class="p-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Техподдержка · сопровождение · мониторинг</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/tehpodderzhka.ts";
    </script>
  </body>
</html>
