---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/kontakty.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import { contacts, contactServices } from "../data/contacts";

const pageTitle = "Контакты — ПРАЙМ";
const pageDescription = `Контакты ПРАЙМ: ${contacts.address}, ${contacts.phone}, ${contacts.email}`;

const localBusinessJsonLd = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "ПРАЙМ",
  url: "https://prime-ltd.su/",
  image: `https://prime-ltd.su${v6Icons.logoMark}`,
  email: contacts.email,
  telephone: contacts.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: contacts.addressShort,
    addressLocality: contacts.city,
    postalCode: contacts.postal,
    addressCountry: "RU",
  },
  areaServed: "RU",
  sameAs: contacts.socials.map((s) => s.href),
};

const contactPageJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: pageTitle,
  url: "https://prime-ltd.su/kontakty/",
  description: pageDescription,
  mainEntity: {
    "@type": "Organization",
    name: "ПРАЙМ",
    url: "https://prime-ltd.su/",
  },
};
---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="kontakty">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <SiteSeo
      title={pageTitle}
      description={pageDescription}
      path="/kontakty/"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(contactPageJsonLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell active="kontakty" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Контакты</strong>
          </p>
          <a href="#contact-form" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content">
          <section class="c-hero">
            <p class="c-hero__kicker">Связаться с нами</p>
            <h1>Контакты</h1>
            <p class="c-hero__lead">
              Офис в Воронеже. Ответим на звонок или письмо — разберём задачу и
              предложим формат работы.
            </p>
          </section>

          <div class="c-grid">
            <section class="v6-card">
              <div class="v6-card-head">
                <h2>Наш адрес и телефон</h2>
                <p>Офис в Воронеже · звонок, почта или форма</p>
              </div>
              <dl class="c-info">
                <div class="c-info__item">
                  <dt>Адрес</dt>
                  <dd>{contacts.address}</dd>
                </div>
                <div class="c-info__item">
                  <dt>Телефон</dt>
                  <dd>
                    <a href={contacts.phoneHref}>{contacts.phone}</a>
                  </dd>
                </div>
                <div class="c-info__item">
                  <dt>Эл. почта</dt>
                  <dd>
                    <a href={contacts.emailHref}>{contacts.email}</a>
                  </dd>
                </div>
                <div class="c-info__item">
                  <dt>Соцсети</dt>
                  <dd>
                    <div class="c-info__social">
                      {
                        contacts.socials.map((s) => (
                          <a href={s.href} target="_blank" rel="noopener">
                            {s.label}
                          </a>
                        ))
                      }
                    </div>
                  </dd>
                </div>
              </dl>
              <ul class="c-points">
                {contacts.points.map((p) => <li>{p}</li>)}
              </ul>
            </section>

            <section id="contact-form" class="v6-card c-form-card">
              <div class="v6-card-head">
                <h2>Остались вопросы или предложения?</h2>
                <p>Коротко опишите задачу — перезвоним в рабочий день</p>
              </div>
              <form id="v6-form" class="v6-form">
                <input type="text" name="name" placeholder="Ваше имя" required />
                <input type="tel" name="phone" placeholder="Телефон" required />
                <input type="email" name="email" placeholder="Email (необязательно)" />
                <select name="service">
                  <option value="">Выберите услугу</option>
                  {contactServices.map((s) => <option value={s}>{s}</option>)}
                </select>
                <textarea name="message" rows="4" placeholder="Сообщение (необязательно)"
                ></textarea>
                <label class="v6-form__check">
                  <input type="checkbox" name="agree" required />
                  <span>
                    Согласен на обработку персональных данных в соответствии с нашей{" "}
                    <a
                      class="cookie-link"
                      href={legalDocs.privacy}
                      target="_blank"
                      rel="nofollow noopener noreferrer">политикой</a
                    >.
                  </span>
                </label>
                <button type="submit" class="v6-btn">Отправить</button>
              </form>
              <p id="v6-form-hint" class="v6-form-hint" hidden></p>
            </section>
          </div>

          <section class="v6-card" style="padding:0;overflow:hidden">
            <div class="v6-card-head" style="padding:1.25rem 1.35rem 0.5rem">
              <h2>{contacts.mapTitle}</h2>
              <p>{contacts.addressShort}, {contacts.city}</p>
            </div>
            <div class="c-map" aria-label={contacts.mapTitle}>
              <iframe
                class="c-map__frame"
                title={contacts.mapTitle}
                src={contacts.mapEmbed}
                width="100%"
                height="420"
                allowfullscreen
                loading="lazy"
                style="border:0;display:block"
              ></iframe>
            </div>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Интернет-маркетинг · контакты</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/concept-v6.ts";
    </script>
  </body>
</html>
