---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/home.css";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import {
  v6Photos,
  v6Icons,
  v6ModuleBanners,
  v6ServiceIcons,
  v6PartnerLogos,
  v6IndustriesFeatured,
  v6ClientBrands,
  v6Process,
  v6Faq,
  v6PartnershipCerts,
} from "../data/v6-media";
import { legalDocs } from "../data/legal";
import { casesForHome, casePath } from "../data/cases";
import { contacts } from "../data/contacts";

const homeTitle = "ПРАЙМ — интернет-маркетинг";
const homeDescription =
  "ПРАЙМ — интернет-маркетинг для бизнеса по всей России. SEO с оплатой по факту, контекст, разработка сайтов и аналитика.";

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "ПРАЙМ",
  url: "https://prime-ltd.su/",
  logo: `https://prime-ltd.su${v6Icons.logoMark}`,
  email: contacts.email,
  telephone: contacts.phone,
  address: {
    "@type": "PostalAddress",
    streetAddress: contacts.addressShort,
    addressLocality: contacts.city,
    postalCode: contacts.postal,
    addressCountry: "RU",
  },
  sameAs: contacts.socials.map((s) => s.href),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "ПРАЙМ",
  url: "https://prime-ltd.su/",
  description: homeDescription,
  publisher: { "@type": "Organization", name: "ПРАЙМ" },
};

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: v6Faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const navTop = [{ label: "О компании", href: "#about" }];

const navBottom = [
  { label: "Наши кейсы", href: "/keysy/" },
  { label: "Блог", href: "/blog/" },
  { label: "Партнерство", href: "/partnerstvo/" },
  { label: "Контакты", href: "/kontakty/" },
];

const serviceHrefs: Record<string, string> = {
  seo: "/prodvizhenie-sayta/",
  ads: "/kontekstnaya-reklama/",
  web: "/razrabotka-saytov/",
  orm: "/upravlenie-reputaciej/",
  audit: "/audit-sayta/",
  support: "/tehpodderzhka-sayta/",
  analytics: "/skvoznaya-analitika/",
  traffic: "/prodvizhenie-sayta-po-trafiku/",
};

const services = [
  {
    title: "Продвижение сайта",
    desc: "Выводим в ТОП-10 по ключевым словам. Оплата по факту нахождения фраз.",
    cat: "seo",
  },
  {
    title: "Контекстная реклама",
    desc: "Реклама в поисковых системах и у партнёров. Снижаем цену за переход, растим звонки.",
    cat: "ads",
  },
  {
    title: "Разработка сайтов",
    desc: "Современные коммерческие сайты: услуги и товары под заявки и продажи.",
    cat: "web",
  },
  {
    title: "Управление репутацией",
    desc: "Отзывы на Яндекс и Google Картах, сторонние отзовики. Улучшаем образ бренда.",
    cat: "orm",
  },
  {
    title: "Аудит сайта",
    desc: "Проверка на требования поисковых систем — находим, что мешает росту в выдаче.",
    cat: "audit",
  },
  {
    title: "Техподдержка сайта",
    desc: "Доработки, контент, оплата, счётчики и постоянное сопровождение проекта.",
    cat: "support",
  },
  {
    title: "Сквозная аналитика",
    desc: "Связка рекламы, сайта и CRM — видно, какой канал даёт заявки и продажи.",
    cat: "analytics",
  },
  {
    title: "Продвижение по трафику",
    desc: "Рост посещаемости с оплатой за переходы клиентов из поисковых систем.",
    cat: "traffic",
  },
];

---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="home">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={homeDescription} />
    <title>{homeTitle}</title>
    <SiteSeo
      title={homeTitle}
      description={homeDescription}
      path="/"
      image={v6Icons.ogCover}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Блог ПРАЙМ"
      href="/blog/rss.xml"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <link rel="preload" as="image" href={v6Photos.heroOffice} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="v6-app">
      <aside id="v6-sidebar" class="v6-sidebar" aria-label="Навигация сайта">
        <div class="v6-sidebar__head">
          <a href="/" class="v6-sidebar__logo">
            <img src={v6Icons.logoMark} alt="" width="44" height="44" />
            <span class="v6-sidebar__brand">
              <span class="v6-sidebar__name">ПРАЙМ</span>
              <span class="v6-sidebar__tagline">Интернет-маркетинг</span>
            </span>
          </a>
          <div class="v6-sidebar__stripe" aria-hidden="true"></div>
        </div>

        <nav class="v6-nav">
          {
            navTop.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
          <details class="v6-nav__group" open>
            <summary>Наши услуги</summary>
            <div class="v6-nav__sub">
              {services.map((s) => (
                <a href={serviceHrefs[s.cat] ?? `#svc-${s.cat}`}>{s.title}</a>
              ))}
            </div>
          </details>
          {
            navBottom.map((item) => (
              <a href={item.href}>{item.label}</a>
            ))
          }
        </nav>

        <div class="v6-sidebar__foot">
          <a href="tel:+74732030124">+7 (473) 203-01-24</a>
          <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
          <div class="v6-sidebar__social">
            <a href="https://vk.com/primeltd" target="_blank" rel="noopener" aria-label="VK">VK</a>
            <a href="https://t.me/bziksv" target="_blank" rel="noopener" aria-label="Telegram">TG</a>
          </div>
        </div>
      </aside>

      <div id="v6-backdrop" class="v6-backdrop" aria-hidden="true"></div>

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">
            ☰
          </button>
          <p class="v6-breadcrumb">
            <strong>Главная</strong>
          </p>
          <a href="#cta" class="v6-btn home-btn-glow">Оставить заявку</a>
        </header>

        <div class="v6-content">
          <section
            class="home-hero"
            id="hero"
            data-home-hero
            style={`--home-hero-bg: url(${v6Photos.heroOffice})`}
          >
            <div class="home-hero__bg" aria-hidden="true" data-home-bg></div>
            <div class="home-hero__veil" aria-hidden="true"></div>

            <div class="home-hero__mesh" aria-hidden="true">
              <svg class="home-mesh" viewBox="0 0 640 420" preserveAspectRatio="xMidYMid slice">
                <defs>
                  <radialGradient id="home-mesh-glow" cx="50%" cy="40%" r="55%">
                    <stop offset="0%" stop-color="rgba(32,184,208,0.32)"></stop>
                    <stop offset="100%" stop-color="rgba(32,184,208,0)"></stop>
                  </radialGradient>
                </defs>
                <circle class="home-mesh__aura" cx="420" cy="170" r="150" fill="url(#home-mesh-glow)"
                ></circle>
                <g class="home-mesh__links">
                  <path d="M80 70 L180 120 L290 90 L400 150 L520 110"></path>
                  <path d="M120 220 L210 180 L310 240 L430 200 L560 260"></path>
                  <path d="M180 120 L210 180 L290 90 L310 240 L400 150 L430 200"></path>
                </g>
                <g fill="rgba(241,245,249,0.35)">
                  <circle cx="80" cy="70" r="3.5"></circle>
                  <circle class="home-mesh__hot" cx="180" cy="120" r="4.5"></circle>
                  <circle cx="290" cy="90" r="3.5"></circle>
                  <circle class="home-mesh__hot home-mesh__hot--2" cx="400" cy="150" r="5"></circle>
                  <circle cx="520" cy="110" r="3.5"></circle>
                  <circle cx="120" cy="220" r="3"></circle>
                  <circle class="home-mesh__hot home-mesh__hot--3" cx="210" cy="180" r="4"></circle>
                  <circle cx="310" cy="240" r="3.5"></circle>
                  <circle cx="430" cy="200" r="4"></circle>
                  <circle cx="560" cy="260" r="3.5"></circle>
                </g>
                <circle class="home-mesh__ping" cx="210" cy="180" r="4"></circle>
                <circle class="home-mesh__ping home-mesh__ping--2" cx="400" cy="150" r="4"></circle>
                <circle class="home-mesh__ping home-mesh__ping--3" cx="180" cy="120" r="4"></circle>
              </svg>
            </div>

            <div class="home-hero__copy">
              <p class="home-brand">ПРАЙ<em>М</em></p>
              <h1>Интернет-маркетинг для бизнеса <span>по всей России</span></h1>
              <p class="home-hero__lead">
                SEO с оплатой по факту в ТОП-10, контекст, сайты и сквозная аналитика —
                с прозрачной экономикой и понятными отчётами.
              </p>
              <div class="home-hero__kpis">
                <div>
                  <strong>
                    <img class="v6-kpi-badge" src={v6Icons.checkPrime} alt="" width="28" height="28" />
                    10+ лет
                  </strong>
                  <span>на рынке · с 2015</span>
                </div>
                <div>
                  <strong>
                    <img class="v6-kpi-badge" src={v6Icons.badgeTop100} alt="" width="28" height="28" />
                    TOP-100
                  </strong>
                  <span>агентств по РФ</span>
                </div>
                <div>
                  <strong>
                    <img class="v6-kpi-badge" src={v6Icons.badgeTop5} alt="" width="28" height="28" />
                    TOP-5
                  </strong>
                  <span>агентств · CMS Magazine</span>
                </div>
              </div>
              <div class="home-hero__actions">
                <a href="#cta" class="v6-btn home-btn-glow">Бесплатная консультация</a>
                <a href="#services" class="v6-btn v6-btn--outline">Все услуги</a>
              </div>
            </div>

            <div class="home-hero__panel" aria-hidden="true">
              <div class="home-hub">
                <div class="home-hub__head">
                  <span class="home-hub__live"><i></i> LIVE HUB</span>
                  <span>seo → ads → web → leads</span>
                </div>

                <div class="home-hub__node is-active" data-home-node="0">
                  <span class="home-hub__dot"></span>
                  <div>
                    <strong>SEO</strong>
                    <span>ТОП-10 · оплата по факту</span>
                  </div>
                  <em class="home-hub__hit">hit</em>
                </div>
                <div class="home-hub__wire">
                  <i class="home-hub__packet"></i>
                  <i class="home-hub__packet home-hub__packet--delay"></i>
                </div>

                <div class="home-hub__node" data-home-node="1">
                  <span class="home-hub__dot"></span>
                  <div>
                    <strong>Контекст</strong>
                    <span>Директ · Ads · CPL</span>
                  </div>
                  <em class="home-hub__hit">hit</em>
                </div>
                <div class="home-hub__wire home-hub__wire--2">
                  <i class="home-hub__packet"></i>
                </div>

                <div class="home-hub__node" data-home-node="2">
                  <span class="home-hub__dot"></span>
                  <div>
                    <strong>Сайт</strong>
                    <span>заявки · звонки · CRM</span>
                  </div>
                  <em class="home-hub__hit">hit</em>
                </div>
                <div class="home-hub__wire home-hub__wire--3">
                  <i class="home-hub__packet"></i>
                  <i class="home-hub__packet home-hub__packet--delay"></i>
                </div>

                <div class="home-hub__node" data-home-node="3">
                  <span class="home-hub__dot"></span>
                  <div>
                    <strong>Результат</strong>
                    <span>лиды · продажи · отчёт</span>
                  </div>
                  <em class="home-hub__hit">ok</em>
                </div>

                <div class="home-hub__stats">
                  <div>
                    <span>Лиды</span>
                    <strong data-home-leads>42</strong>
                  </div>
                  <div>
                    <span>CPL</span>
                    <strong data-home-cpl>380 ₽</strong>
                  </div>
                  <div>
                    <span>ТОП</span>
                    <strong data-home-top>128</strong>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section id="about" class="v6-card v6-about-strip v6-reveal">
            <div class="v6-about-strip__copy">
              <h2>О компании</h2>
              <p>
                ПРАЙМ — агентство интернет-маркетинга с 2015 года. Ведём проекты по всей
                России: от аудита и стратегии до заявок, звонков и продаж. Фокус на
                измеримом результате — позиции, трафик, CPL и связка с CRM.
              </p>
              <ul class="v6-about-strip__list">
                <li>Более 10 лет на рынке — без смены вывески</li>
                <li>Официальные партнёры Яндекс и Google</li>
                <li>SEO с оплатой по факту нахождения фраз в ТОП-10</li>
              </ul>
            </div>
            <div class="v6-about-strip__certs">
              {
                v6PartnershipCerts.map((c) => (
                  <div class="v6-cert-mini">
                    <img src={c.logo} alt="" height="28" />
                    <div>
                      <strong>{c.title}</strong>
                      <span>{c.desc}</span>
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <section id="services" class="v6-card v6-reveal">
            <div class="v6-card-head">
              <h2>Наши услуги</h2>
              <p>Комплекс или отдельно — под задачи бизнеса</p>
            </div>
            <div class="v6-services">
              {
                services.map((s) => (
                  <a
                    href={serviceHrefs[s.cat] ?? "#cta"}
                    class="v6-service"
                    id={`svc-${s.cat}`}
                  >
                    <img class="v6-service__cover" src={v6ModuleBanners[s.cat]} alt="" loading="lazy" />
                    <div class="v6-service__body">
                      <img class="v6-service__icon" src={v6ServiceIcons[s.cat]} alt="" width="48" height="40" />
                      <h3>{s.title}</h3>
                      <p>{s.desc}</p>
                    </div>
                  </a>
                ))
              }
            </div>
          </section>

          <section class="v6-card v6-flagship v6-flagship--media v6-reveal">
            <div class="v6-flagship__main">
              <p class="v6-eyebrow">Флагман · с 2015</p>
              <h2>Продвижение сайта с оплатой по факту</h2>
              <p class="v6-muted v6-muted--lg">
                Модель, с которой мы работаем больше десяти лет: выводим в ТОП-10
                по ключевым словам. Платите за фразы, которые реально закрепились
                в выдаче — без абонентской «воды».
              </p>
              <a href="/prodvizhenie-sayta/" class="v6-btn v6-btn--spaced home-btn-glow">Узнать условия</a>
            </div>
            <div class="v6-flagship__visual">
              <img src={v6Icons.seoReport} alt="Отчёт по позициям" width="280" height="180" />
              <img class="v6-flagship__serp" src={v6Icons.serpMock} alt="Пример выдачи" width="280" height="120" />
            </div>
          </section>

          <section class="v6-card v6-reveal">
            <div class="v6-card-head">
              <h2>Как мы работаем</h2>
              <p>Четыре шага от аудита до роста заявок</p>
            </div>
            <div class="v6-process">
              {
                v6Process.map((step) => (
                  <article class="v6-process__item">
                    <span class="v6-process__num">{step.step}</span>
                    <h3>{step.title}</h3>
                    <p>{step.desc}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section id="cases" class="v6-card v6-reveal">
            <div class="v6-card-head">
              <h2>Наши достижения</h2>
              <p>По версии CMS Magazine и результатам клиентов</p>
            </div>
            <div class="v6-stats v6-stats--media">
              <div class="v6-stat-card">
                <img class="v6-stat-card__bg" src={v6Photos.heroWorkspace} alt="" loading="lazy" />
                <img class="v6-stat-card__badge" src={v6Icons.badgeTop5} alt="" width="36" height="36" />
                <strong>TOP-5</strong>
                <span>интернет-маркетинг · CMS Magazine</span>
              </div>
              <div class="v6-stat-card">
                <img class="v6-stat-card__bg" src={v6Photos.flagSeo} alt="" loading="lazy" />
                <img class="v6-stat-card__badge" src={v6Icons.badgeTop100} alt="" width="36" height="36" />
                <strong>TOP-100</strong>
                <span>агентств по РФ</span>
              </div>
              <div class="v6-stat-card">
                <img class="v6-stat-card__bg" src={v6Photos.heroTeam} alt="" loading="lazy" />
                <img class="v6-stat-card__badge" src={v6Icons.checkPrime} alt="" width="36" height="36" />
                <strong>70+</strong>
                <span>клиентов в разных отраслях</span>
              </div>
            </div>
            <div class="v6-cases-grid">
              {
                casesForHome().map((c) => (
                  <a href={casePath(c)} class="v6-case-card">
                    <img src={c.cover} alt="" loading="lazy" />
                    <div class="v6-case-card__body">
                      <span class="v6-case-card__metric">{c.metric}</span>
                      <h3>{c.client}</h3>
                      <p>{c.summary}</p>
                      <em>
                        {c.services.slice(0, 2).join(" · ")} · {c.period}
                      </em>
                    </div>
                  </a>
                ))
              }
            </div>
            <p class="v6-muted v6-note">
              * Рейтинг CMS Magazine — один из старейших сервисов оценки в рунете;
              на его показатели опираются и гос. тендеры.
            </p>
            <div class="v6-cases-actions">
              <a class="v6-btn home-btn-glow" href="/keysy/">Все кейсы</a>
            </div>
          </section>

          <section id="partners" class="v6-card v6-clients v6-reveal">
            <div class="v6-card-head">
              <h2>Наши клиенты</h2>
              <p>Более 70 компаний — от автодилеров до медицины и ритейла</p>
            </div>
            <div class="v6-clients__rail">
              {
                v6ClientBrands.map((b) => (
                  <figure class="v6-client-logo">
                    <img src={b.image} alt={b.name} loading="lazy" />
                  </figure>
                ))
              }
            </div>
            <div class="v6-clients__foot">
              <p>Официальные партнёры поисковых систем</p>
              <div class="v6-clients__certs">
                {v6PartnerLogos.map((src) => <img src={src} alt="" height="28" />)}
              </div>
            </div>
          </section>

          <section class="v6-card v6-industries-block v6-reveal">
            <div class="v6-card-head">
              <h2>Продвижение по направлениям бизнеса</h2>
              <p>Отраслевой опыт — детали уточняйте по телефону</p>
            </div>
            <div class="v6-industries-mosaic">
              {
                v6IndustriesFeatured.map((ind) => (
                  <a href="#cta" class="v6-ind-tile">
                    <img src={ind.image} alt="" loading="lazy" />
                    <span>{ind.name}</span>
                  </a>
                ))
              }
            </div>
          </section>

          <section class="v6-card v6-reveal">
            <div class="v6-card-head">
              <h2>Частые вопросы</h2>
            </div>
            <div class="v6-faq">
              {
                v6Faq.map((item) => (
                  <details class="v6-faq__item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))
              }
            </div>
          </section>

          <section id="cta" class="v6-card v6-cta-card v6-reveal">
            <div class="v6-card-head">
              <h2>Оставить заявку</h2>
              <p>
                За 10+ лет рынок агентств сильно проредился — многие закрылись.
                Мы на месте: те же принципы, измеримый результат.
              </p>
            </div>
            <div class="v6-cta-layout">
              <div class="v6-cta__visual">
                <img src={v6Photos.contactOffice} alt="Офис ПРАЙМ" loading="lazy" />
                <div class="v6-cta__contacts">
                  <a href="tel:+74732030124">+7 (473) 203-01-24</a>
