---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/trafik.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import {
  trafficIntro,
  trafficFit,
  trafficSteps,
  trafficOutcomes,
  trafficIncludes,
  trafficPlans,
  trafficPricingNote,
} from "../data/traffic-service";
---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="traffic">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Продвижение сайта по трафику: оплата за переходы из поиска по списку фраз. Регионы от 3 ₽, Москва и СПб от 5 ₽ за переход. Базовый трафик до старта не учитывается."
    />
    <title>Продвижение по трафику — ПРАЙМ</title>
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preload" as="image" href="/images/v6/photos/traffic-hero.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Teko:wght@400;500;600&family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell serviceActive="traffic" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Продвижение по трафику</strong>
          </p>
          <a href="#traffic-cta" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content">
          <section class="t-hero">
            <div class="t-hero__bg" aria-hidden="true" data-parallax-traffic-bg></div>
            <div class="t-hero__veil" aria-hidden="true"></div>

            <div class="t-hero__copy">
              <p class="t-brand">ПРАЙ<em>М</em></p>
              <h1>
                Продвижение по трафику — платите за <span>переходы из поиска</span>
              </h1>
              <p class="t-hero__lead">
                Рост посещаемости по списку ключевых фраз. Базовый трафик до
                старта не учитывается — оплата за прирост из выдачи.
              </p>
              <div class="t-hero__actions">
                <a href="#traffic-cta" class="t-btn t-btn--primary">Хочу в ТОП</a>
                <a href="#pricing" class="t-btn t-btn--ghost">Смотреть цены</a>
              </div>
            </div>

            <div class="t-hero__viz" aria-hidden="true">
              <div class="t-counter">
                <p class="t-counter__label">visits / growth</p>
                <p class="t-counter__value" data-traffic-counter>+128%</p>
                <p class="t-counter__hint">модель оплаты за прирост, не за «воздух»</p>
              </div>
              <div class="t-wave">
                <span></span><span></span><span></span><span></span>
                <span></span><span></span><span></span><span></span>
              </div>
            </div>
          </section>

          <section class="t-intro t-reveal">
            <div>
              <p>{trafficIntro.lead}</p>
              <p>{trafficIntro.result}</p>
              <p>{trafficIntro.note}</p>
            </div>
            <div class="t-intro__chip">
              Pay per visit
              <span>из поиска · по списку фраз</span>
            </div>
          </section>

          <section class="t-section t-reveal">
            <div class="t-section__head">
              <h2>Для каких сайтов подходит</h2>
              <p>Там, где важнее объём целевых визитов, чем узкий ТОП по десятку фраз.</p>
            </div>
            <div class="t-fit">
              {
                trafficFit.map((f) => (
                  <article>
                    <h3>{f.title}</h3>
                    <p>{f.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="t-section t-reveal">
            <div class="t-section__head">
              <h2>Как мы работаем</h2>
              <p>От целей и аудита до внутренней и внешней оптимизации.</p>
            </div>
            <div class="t-steps">
              {
                trafficSteps.map((s) => (
                  <article class="t-step">
                    <span class="t-step__n">{s.n}</span>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="t-section t-reveal">
            <div class="t-section__head">
              <h2>Что получите в результате</h2>
              <p>Охват, конверсия и экономически прозрачная модель оплаты.</p>
            </div>
            <div class="t-outcomes">
              {
                trafficOutcomes.map((o) => (
                  <article class="t-outcome">
                    <h3>{o.title}</h3>
                    <p>{o.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="t-section t-reveal">
            <div class="t-section__head">
              <h2>Что входит в работу</h2>
              <p>Семантика, стоп-слова, тексты, техника и внешний контур.</p>
            </div>
            <div class="t-includes">
              {trafficIncludes.map((item) => <div class="t-include">{item}</div>)}
            </div>
          </section>

          <section class="t-section t-reveal" id="pricing">
            <div class="t-section__head">
              <h2>Стоимость услуг</h2>
              <p>
                Расценки зависят от направления и конкуренции в регионе.
              </p>
            </div>
            <div class="t-plans">
              {
                trafficPlans.map((p) => (
                  <article
                    class:list={["t-plan", p.featured && "t-plan--featured"]}
                  >
                    {p.featured && <span class="t-plan__badge">Столицы</span>}
                    <h3>{p.title}</h3>
                    <p class="t-plan__price">{p.price}</p>
                    <p class="t-plan__unit">{p.unit}</p>
                    <div class="t-plan__min">
                      <strong>{p.min}</strong>
                      {p.minLabel}
                    </div>
                    <a href="#traffic-cta" class="t-btn t-btn--line">Оставить заявку</a>
                  </article>
                ))
              }
            </div>
            <p class="t-note">{trafficPricingNote}</p>
          </section>

          <section id="traffic-cta" class="t-cta t-reveal">
            <div>
              <h2>Заинтересовало продвижение по трафику?</h2>
              <p>
                Оставьте заявку — менеджер уточнит детали и подготовит
                индивидуальное коммерческое предложение.
              </p>
              <div class="t-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="traffic-form" class="t-form">
              <input type="text" name="name" placeholder="Ваше имя" required />
              <input type="tel" name="phone" placeholder="Телефон" required />
              <input type="url" name="site" placeholder="Адрес сайта" required />
              <select name="region">
                <option value="">Регион продвижения</option>
                <option>Регионы РФ</option>
                <option>Москва / МО</option>
                <option>Санкт-Петербург / ЛО</option>
                <option>Несколько регионов</option>
              </select>
              <textarea
                name="message"
                rows="3"
                placeholder="Ниша и примерно какой трафик хотите"></textarea>
              <label class="t-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с нашей{" "}
                  <a
                    class="cookie-link"
                    href={legalDocs.privacy}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    >политикой</a
                  >.
                </span>
              </label>
              <button type="submit" class="t-btn t-btn--mint">Отправить заявку</button>
              <p id="traffic-form-hint" class="t-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Продвижение по трафику · оплата за переходы</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/trafik.ts";
    </script>
  </body>
</html>
