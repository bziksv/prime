---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/trafik.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import {
  trafficFit,
  trafficSteps,
  trafficOutcomes,
  trafficIncludes,
  trafficPlans,
  trafficPricingNote,
  trafficStats,
  trafficMarquee,
  trafficDemoKeys,
  trafficNos,
  trafficFaq,
} from "../data/traffic-service";
import { breadcrumbJsonLd } from "../lib/breadcrumb-jsonld";
import { serviceJsonLd } from "../lib/service-jsonld";

const chartBars = [18, 22, 28, 34, 42, 48, 55, 62, 71, 78, 86, 94];

const pageTitle = "Продвижение по трафику — ПРАЙМ";
const pageDescription =
  "Продвижение сайта по трафику: оплата за переходы из поиска по списку фраз. Регионы от 3 ₽, Москва и СПб от 5 ₽ за переход. Базовый трафик до старта не учитывается.";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: trafficFaq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
const crumbsLd = breadcrumbJsonLd(
  [
    { label: "Главная", href: "/" },
    { label: "Продвижение по трафику" },
  ],
  {
    origin: Astro.site?.origin ?? "https://prime-ltd.su",
    currentPath: "/prodvizhenie-sayta-po-trafiku/",
  },
);

const serviceLd = serviceJsonLd({
  name: "Продвижение по трафику",
  description: pageDescription,
  path: "/prodvizhenie-sayta-po-trafiku/",
  serviceType: "Продвижение сайта по трафику",
  origin: Astro.site?.origin ?? "https://prime-ltd.su",
});

---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="traffic">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <SiteSeo
      title={pageTitle}
      description={pageDescription}
      path="/prodvizhenie-sayta-po-trafiku/"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preload" as="image" href="/images/v6/photos/traffic-hero.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Teko:wght@400;500;600&family=Work+Sans:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell serviceActive="traffic" />

      <main id="main" class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню" aria-controls="v6-sidebar" aria-expanded="false">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Продвижение по трафику</strong>
          </p>
          <a href="#traffic-cta" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content">
          <section class="t-hero" data-t-hero>
            <div class="t-hero__atmosphere" aria-hidden="true">
              <div class="t-hero__bg" data-t-bg></div>
              <div class="t-hero__veil"></div>
              <div class="t-hero__mesh" data-t-mesh></div>
              <p class="t-hero__giant">VISITS</p>
            </div>

            <div class="t-hero__copy">
              <p class="t-brand">ПРАЙ<em>М</em></p>
              <p class="t-kicker">Pay per visit · только прирост из поиска</p>
              <h1>
                Платите за <span>переходы</span>, а не за «воздух» в отчётах
              </h1>
              <p class="t-hero__lead">
                Рост посещаемости по списку ключевых фраз. Базовый трафик до старта
                не учитывается — в счёт идёт только прирост из выдачи.
              </p>
              <div class="t-hero__actions">
                <a href="#traffic-cta" class="t-btn t-btn--primary">Хочу в рост</a>
                <a href="#pricing" class="t-btn t-btn--ghost">Смотреть цены</a>
              </div>
            </div>

            <aside class="t-meter" data-t-meter aria-label="Демо оплаты за прирост трафика">
              <header class="t-meter__head">
                <span class="t-meter__live"><i></i> live growth</span>
                <span class="t-meter__proto">PRIME · TRAFFIC</span>
              </header>

              <div class="t-meter__keys" data-t-keys>
                {
                  trafficDemoKeys.map((k, i) => (
                    <span class="t-meter__key" data-t-key style={`--i:${i}`} hidden>
                      {k}
                    </span>
                  ))
                }
              </div>

              <div class="t-meter__chart" data-t-chart>
                <div class="t-meter__baseline" data-t-baseline>
                  <span>baseline</span>
                  <strong data-t-base-val>1 240</strong>
                </div>
                <div class="t-meter__bars" aria-hidden="true">
                  {
                    chartBars.map((h, i) => (
                      <i style={`--h:${h}%; --i:${i}`} data-t-bar></i>
                    ))
                  }
                </div>
                <svg class="t-meter__spark" viewBox="0 0 240 64" preserveAspectRatio="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="t-spark-fill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="rgba(45,212,191,0.45)" />
                      <stop offset="100%" stop-color="rgba(45,212,191,0)" />
                    </linearGradient>
                  </defs>
                  <path data-t-area fill="url(#t-spark-fill)" d="" />
                  <polyline data-t-line fill="none" points="" />
                </svg>
              </div>

              <div class="t-meter__stats">
                <div>
                  <span>visits / month</span>
                  <strong><em data-t-visits>1 240</em></strong>
                </div>
                <div>
                  <span>billable Δ</span>
                  <strong class="t-meter__delta">+<em data-t-delta>0</em></strong>
                </div>
                <div>
                  <span>to pay</span>
                  <strong data-t-pay>0 ₽</strong>
                </div>
              </div>

              <p class="t-meter__note" data-t-note>
                База до старта = 0 ₽ · платите только за прирост
              </p>
            </aside>
          </section>

          <section class="t-stats t-reveal" data-t-stats>
            {
              trafficStats.map((s, i) => (
                <div class="t-stat" style={`--i:${i}`}>
                  <strong>
                    {"display" in s && s.display ? (
                      s.display
                    ) : (
                      <>
                        <span data-count={s.value}>0</span>
                        {s.suffix}
                      </>
                    )}
                  </strong>
                  <span>{s.label}</span>
                </div>
              ))
            }
          </section>

          <div class="t-marquee t-reveal" aria-hidden="true">
            <div class="t-marquee__track">
              {[...trafficMarquee, ...trafficMarquee].map((q) => (
                <span>{q}</span>
              ))}
            </div>
          </div>

          <section class="t-section t-reveal">
            <div class="t-section__head">
              <p class="t-kicker">Fit</p>
              <h2>Для каких сайтов подходит</h2>
              <p>Там, где важнее объём целевых визитов, чем узкий ТОП по десятку фраз.</p>
            </div>
            <div class="t-fit">
              {
                trafficFit.map((f, i) => (
                  <article style={`--i:${i}`}>
                    <span class="t-fit__n">0{i + 1}</span>
                    <h3>{f.title}</h3>
                    <p>{f.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="t-section t-reveal" id="timeline">
            <div class="t-section__head">
              <p class="t-kicker">Процесс</p>
              <h2>Как мы работаем</h2>
              <p>От целей и аудита до внутренней и внешней оптимизации.</p>
            </div>
            <div class="t-timeline" data-t-timeline>
              <div class="t-timeline__rail" aria-hidden="true">
                <span class="t-timeline__fill" data-t-timeline-fill></span>
              </div>
              <ol class="t-timeline__list">
                {
                  trafficSteps.map((s, i) => (
                    <li class="t-timeline__item" data-t-timeline-item style={`--i:${i}`}>
                      <span class="t-timeline__dot" aria-hidden="true"></span>
                      <span class="t-timeline__n">{s.n}</span>
                      <div>
                        <h3>{s.title}</h3>
                        <p>{s.text}</p>
                      </div>
                    </li>
                  ))
                }
              </ol>
            </div>
          </section>

          <section class="t-section t-reveal">
            <div class="t-section__head">
              <p class="t-kicker">Результат</p>
              <h2>Что получите</h2>
              <p>Охват, конверсия и экономически прозрачная модель оплаты.</p>
            </div>
            <div class="t-outcomes">
              {
                trafficOutcomes.map((o, i) => (
                  <article class="t-outcome" style={`--i:${i}`}>
                    <span class="t-outcome__tag">{o.metric}</span>
                    <h3>{o.title}</h3>
                    <p>{o.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="t-section t-reveal">
            <div class="t-section__head">
              <p class="t-kicker">Состав</p>
              <h2>Что входит в работу</h2>
              <p>Семантика, стоп-слова, тексты, техника и внешний контур.</p>
            </div>
            <div class="t-includes">
              {
                trafficIncludes.map((item, i) => (
                  <div class="t-include" style={`--i:${i}`}>
                    {item}
                  </div>
                ))
              }
            </div>
          </section>

          <section class="t-section t-reveal" id="pricing">
            <div class="t-section__head">
              <p class="t-kicker">Цены</p>
              <h2>Стоимость услуг</h2>
              <p>Расценки зависят от направления и конкуренции в регионе.</p>
            </div>
            <div class="t-plans" data-t-plans>
              {
                trafficPlans.map((p) => (
                  <article
                    class:list={["t-plan", p.featured && "t-plan--featured", p.featured && "is-selected"]}
                    data-t-plan={p.id}
                    data-title={p.title}
                    data-price={p.price}
                    tabindex="0"
                    role="button"
                    aria-pressed={p.featured ? "true" : "false"}
                  >
                    {p.featured && <span class="t-plan__badge">Столицы</span>}
                    <h3>{p.title}</h3>
                    <p class="t-plan__price">{p.price}</p>
                    <p class="t-plan__unit">{p.unit}</p>
                    <div class="t-plan__min">
                      <strong>{p.min}</strong>
                      {p.minLabel}
                    </div>
                    <a href="#traffic-cta" class="t-btn t-btn--line" data-t-plan-cta>
                      Выбрать · {p.price}
                    </a>
                  </article>
                ))
              }
            </div>
            <p class="t-note">{trafficPricingNote}</p>
          </section>

          <section class="t-section t-reveal">
            <div class="t-section__head">
              <p class="t-kicker">Честно</p>
              <h2>Чего не путаем и не обещаем</h2>
              <p>Чтобы модель «оплата за переходы» не смешивалась с ТОП-10.</p>
            </div>
            <div class="t-nos">
              {
                trafficNos.map((item) => (
                  <article class="t-no">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="t-section t-reveal" id="faq">
            <div class="t-section__head">
              <p class="t-kicker">FAQ</p>
              <h2>Частые вопросы</h2>
              <p>Отличие от ТОП, базовый трафик, первые месяцы и цена за переход.</p>
            </div>
            <div class="t-faq">
              {
                trafficFaq.map((item) => (
                  <details class="t-faq__item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))
              }
            </div>
          </section>

          <section id="traffic-cta" class="t-cta t-reveal">
            <div>
              <h2>Продвижение по трафику — интересно?</h2>
              <p>
                Оставьте заявку — менеджер уточнит детали и подготовит
                индивидуальное коммерческое предложение.
              </p>
              <p class="t-cta__pick" data-t-pick>
                Выбран тариф: <strong>Москва и Санкт-Петербург · от 5 ₽</strong>
              </p>
              <div class="t-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="traffic-form" class="t-form">
              <label class="visually-hidden" for="traffic-name">Ваше имя</label>
              <input
                id="traffic-name"
                type="text"
                name="name"
                placeholder="Ваше имя"
                autocomplete="name"
                required
              />
              <label class="visually-hidden" for="traffic-phone">Телефон</label>
              <input
                id="traffic-phone"
                type="tel"
                name="phone"
                placeholder="Телефон"
                autocomplete="tel"
                required
              />
              <label class="visually-hidden" for="traffic-site">Адрес сайта</label>
              <input
                id="traffic-site"
                type="url"
                name="site"
                placeholder="Адрес сайта"
                autocomplete="url"
                required
              />
              <label class="visually-hidden" for="traffic-region">Регион продвижения</label>
              <select id="traffic-region" name="region" data-t-region required>
                <option value="" disabled>Регион продвижения</option>
                <option value="region">Регионы РФ · от 3 ₽</option>
                <option value="capital" selected>Москва / СПб · от 5 ₽</option>
                <option value="multi">Несколько регионов</option>
              </select>
              <label class="visually-hidden" for="traffic-message">Ниша и трафик</label>
              <textarea
                id="traffic-message"
                name="message"
                rows="3"
                placeholder="Ниша и примерно какой трафик хотите"
              ></textarea>
              <label class="t-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с нашей{" "}
                  <a
                    class="cookie-link"
                    href={legalDocs.privacy}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    >политикой</a
                  >.
                </span>
              </label>
              <button type="submit" class="t-btn t-btn--mint">Отправить заявку</button>
              <p id="traffic-form-hint" class="t-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Продвижение по трафику · оплата за переходы</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </main>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/trafik.ts";
    </script>
  </body>
</html>
