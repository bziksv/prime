---
import "../../styles/concept-v6.css";
import "../../styles/concept-v6-media.css";
import "../../styles/cases.css";
import CasesLayout from "../../layouts/CasesLayout.astro";
import CaseFilters from "../../components/CaseFilters.astro";
import CaseGrid from "../../components/CaseGrid.astro";
import { caseStudies, caseCategories } from "../../data/cases";

const featured = caseStudies
  .filter((c) => c.featured)
  .sort((a, b) => {
    const rank = (slug: string) => {
      if (slug === "insortex") return 0;
      if (slug === "almamed") return 1;
      return 2;
    };
    return rank(a.slug) - rank(b.slug);
  });
---

<CasesLayout
  title="Наши кейсы — ПРАЙМ"
  description="Актуальные кейсы ПРАЙМ: SEO, контекст, сайты и боты для мессенджеров. Свежие результаты по позициям, заявкам, CPL и ROI — не архив десятилетней давности."
  path="/keysy/"
  breadcrumb={[{ label: "Главная", href: "/" }, { label: "Кейсы" }]}
>
  <section class="k-hero" data-k-hero>
    <div class="k-hero__grid" data-k-grid aria-hidden="true"></div>
    <div class="k-hero__glow" data-k-glow aria-hidden="true"></div>
    <div class="k-hero__orb k-hero__orb--1" data-k-depth="0.55" aria-hidden="true"></div>
    <div class="k-hero__orb k-hero__orb--2" data-k-depth="0.9" aria-hidden="true"></div>
    <div class="k-hero__inner">
      <p class="k-kicker">Актуальные кейсы · не архив</p>
      <h1>Показываем <em>свежее</em> — цифры, а не слайды из прошлого</h1>
      <p class="k-hero__lead">
        SEO, Директ, сайты и боты: живые проекты с понятной экономикой —
        позиции, заявки, CPL и ROI. Без десятилетнего портфолио «для галочки» —
        только то, что актуально сейчас.
      </p>
    </div>
    <div class="k-hero__stats">
      <div class="k-hero__stat">
        <strong>{caseStudies.length}+</strong>
        <span>актуальных разборов</span>
      </div>
      <div class="k-hero__stat">
        <strong>{caseCategories.length}</strong>
        <span>направления услуг</span>
      </div>
      <div class="k-hero__stat">
        <strong>70+</strong>
        <span>клиентов в работе</span>
      </div>
    </div>
    <div class="k-hero__stripe" aria-hidden="true"></div>
  </section>

  <CaseFilters active="all" />

  {
    featured.length > 0 && (
      <section class="k-panel k-reveal">
        <div class="k-panel__head">
          <h2>Свежие сильные результаты</h2>
          <p>Актуальные кейсы с метрикой на обложке — показываем только свежее</p>
        </div>
        <CaseGrid cases={featured} featuredFirst />
      </section>
    )
  }

  <section class="k-panel k-reveal">
    <div class="k-panel__head">
      <h2>Все актуальные кейсы</h2>
      <p>Фильтр по SEO, контексту, сайтам или ботам — только свежие разборы</p>
    </div>
    <CaseGrid cases={caseStudies.filter((c) => !c.featured)} initialVisible={9} step={9} />
  </section>

  <section class="k-cta k-reveal">
    <h2>Нужен такой же результат?</h2>
    <p>
      С 2015 на рынке: за 10+ лет немало агентств закрылось — мы на месте.
      Разберём нишу за 30 минут и подскажем формат: SEO, Директ, сайт или бот.
    </p>
    <div class="k-cta__actions">
      <a class="k-btn k-btn--primary" href="/kontakty/">Оставить заявку</a>
      <a class="k-btn k-btn--ghost" href="tel:+74732030124">+7 (473) 203-01-24</a>
    </div>
  </section>
</CasesLayout>
