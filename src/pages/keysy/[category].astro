---
import "../../styles/concept-v6.css";
import "../../styles/concept-v6-media.css";
import "../../styles/cases.css";
import CasesCategoryView from "../../components/cases/CasesCategoryView.astro";
import {
  caseCategories,
  getCategory,
  getCasesByCategory,
  type CaseCategoryId,
} from "../../data/cases";
import { casesIndexPath } from "../../i18n/cases";

export function getStaticPaths() {
  return caseCategories.map((c) => ({ params: { category: c.slug } }));
}

const { category } = Astro.params;
const cat = getCategory(category!);
if (!cat) {
  return Astro.redirect(casesIndexPath("ru"));
}

const cases = getCasesByCategory(cat.id as CaseCategoryId);
---

<CasesCategoryView locale="ru" cat={cat} cases={cases} />
