---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/kontekst.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import { getCasesByCategory } from "../data/cases";
import {
  adsNotFit,
  adsSteps,
  adsEdges,
  adsProsCons,
  adsPricing,
  adsPricingTiers,
  adsPricingInclude,
  adsOutcomes,
  adsFaq,
} from "../data/ads-service";
import { breadcrumbJsonLd } from "../lib/breadcrumb-jsonld";
import { serviceJsonLd } from "../lib/service-jsonld";

const adsCases = getCasesByCategory("ads").slice(0, 4);

const pageTitle = "Контекстная реклама — ПРАЙМ";
const pageDescription =
  "Контекстная реклама в Яндекс.Директе и Google Ads: стратегия, минус-слова, UTM, ставки. Ведение от 6 000 ₽ — по медиабюджету, не процент от пополнения. Два отдельных счёта.";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: adsFaq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
const crumbsLd = breadcrumbJsonLd(
  [
    { label: "Главная", href: "/" },
    { label: "Контекстная реклама" },
  ],
  {
    origin: Astro.site?.origin ?? "https://prime-ltd.su",
    currentPath: "/kontekstnaya-reklama/",
  },
);

const serviceLd = serviceJsonLd({
  name: "Контекстная реклама",
  description: pageDescription,
  path: "/kontekstnaya-reklama/",
  serviceType: "Контекстная реклама",
  origin: Astro.site?.origin ?? "https://prime-ltd.su",
});

---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="ads">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <SiteSeo
      title={pageTitle}
      description={pageDescription}
      path="/kontekstnaya-reklama/"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preload" as="image" href="/images/v6/photos/ads-hero.webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell serviceActive="ads" />

      <main id="main" class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню" aria-controls="v6-sidebar" aria-expanded="false">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Контекстная реклама</strong>
          </p>
          <a href="#ads-cta" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content">
          <section class="a-hero">
            <div class="a-hero__copy">
              <p class="a-brand">ПРАЙ<em>М</em></p>
              <h1>
                Контекстная реклама — клиенты из поиска <span>уже сегодня</span>
              </h1>
              <p class="a-hero__lead">
                Яндекс.Директ и Google Ads: стратегия, объявления, минус-слова и
                ставки. Ведение — фиксированная сумма от медиабюджета: от 6&nbsp;000&nbsp;₽
                в месяц. Медиабюджет и услуги — разными счетами.
              </p>
              <div class="a-hero__actions">
                <a href="#ads-cta" class="a-btn a-btn--primary">Получить консультацию</a>
                <a href="#pricing" class="a-btn a-btn--ghost">Сколько стоит ведение</a>
              </div>
              <ul class="a-hero__points">
                <li>До 100&nbsp;000&nbsp;₽ бюджета — ведение от 6&nbsp;000&nbsp;₽</li>
                <li>100–300&nbsp;000&nbsp;₽ — 12&nbsp;000&nbsp;₽</li>
                <li>Свыше 300&nbsp;000&nbsp;₽ — 20&nbsp;000&nbsp;₽</li>
              </ul>
            </div>
            <div class="a-hero__visual" data-parallax-ads>
              <div class="a-hero__photo" aria-hidden="true" data-parallax-ads-bg></div>
              <div class="a-bids" aria-hidden="true">
                <div class="a-bid">
                  <strong>Директ</strong>
                  <span class="a-bid__bar"><i style="--w:78%"></i></span>
                  <span>поиск</span>
                </div>
                <div class="a-bid">
                  <strong>Google</strong>
                  <span class="a-bid__bar"><i style="--w:62%"></i></span>
                  <span>Ads</span>
                </div>
                <div class="a-bid">
                  <strong>Ставка ↓</strong>
                  <span class="a-bid__bar"><i style="--w:48%"></i></span>
                  <span>оптимизация</span>
                </div>
              </div>
            </div>
          </section>

          <section class="a-section a-reveal">
            <div class="a-section__head">
              <h2>Кому контекст не подойдёт</h2>
              <p>
                Честно на берегу: если узнаёте себя — сначала бизнес и продукт,
                потом реклама.
              </p>
            </div>
            <div class="a-stop">
              {
                adsNotFit.map((item, i) => (
                  <article>
                    <span class="a-stop__mark">стоп 0{i + 1}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="a-section a-reveal" id="process">
            <div class="a-section__head">
              <h2>Всё в порядке? Как работаем</h2>
              <p>
                От заявки до отработанного канала продаж — без «запустили и
                пропали».
              </p>
            </div>
            <div class="a-rail">
              {
                adsSteps.map((s) => (
                  <article class="a-rail__item">
                    <span class="a-rail__n">{s.n}</span>
                    <div>
                      <h3>{s.title}</h3>
                      <p>{s.text}</p>
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="a-section a-reveal">
            <div class="a-section__head">
              <h2>Чем отличаемся</h2>
              <p>Не только «настроили Директ» — инфраструктура под результат.</p>
            </div>
            <div class="a-edges">
              {
                adsEdges.map((e) => (
                  <article class="a-edge">
                    <h3>{e.title}</h3>
                    <p>{e.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="a-section a-reveal">
            <div class="a-section__head">
              <h2>Плюсы и честные минусы</h2>
              <p>Контекст быстрый и прозрачный — но не волшебная кнопка.</p>
            </div>
            <div class="a-balance">
              <div class="a-balance__col a-balance__col--pro">
                <h3>Плюсы</h3>
                <ul>
                  {adsProsCons.pros.map((t) => <li>{t}</li>)}
                </ul>
              </div>
              <div class="a-balance__col a-balance__col--con">
                <h3>Минусы</h3>
                <ul>
                  {adsProsCons.cons.map((t) => <li>{t}</li>)}
                </ul>
              </div>
            </div>
          </section>

          <section class="a-price a-reveal" id="pricing">
            <div class="a-price__intro">
              <p class="a-price__eyebrow">Тарифы ведения</p>
              <h2>Сколько стоит ведение рекламы</h2>
              <p>{adsPricing.note}</p>
              <div class="a-invoices">
                <div class="a-invoice">
                  <span>Счёт 1 · услуги ПРАЙМ</span>
                  <em>ведение кампаний</em>
                </div>
                <div class="a-invoice">
                  <span>Счёт 2 · Яндекс / Google</span>
                  <em>медиабюджет</em>
                </div>
              </div>
            </div>

            <div class="a-tiers">
              {
                adsPricingTiers.map((t) => (
                  <article class:list={["a-tier", t.accent && "a-tier--accent"]}>
                    <p class="a-tier__budget">{t.budget}</p>
                    <p class="a-tier__hint">{t.budgetHint}</p>
                    <p class="a-tier__for">{t.forWhom}</p>
                    <p class="a-tier__fee">
                      <strong>{t.fee}</strong>
                      <span>{t.feeNote}</span>
                    </p>
                    <a href="#ads-cta" class="a-btn a-btn--tier">Запросить ведение</a>
                  </article>
                ))
              }
            </div>

            <div class="a-price__include">
              <h3>Что входит в ведение</h3>
              <ul>
                {adsPricingInclude.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </section>

          {
            adsCases.length > 0 && (
              <section class="a-section a-reveal">
                <div class="a-section__head">
                  <h2>Кейсы по контексту</h2>
                  <p>
                    Доверяйте не благодарственным письмам — реальным проектам.
                  </p>
                </div>
                <div class="a-cases">
                  {adsCases.map((c) => (
                    <a href={`/keysy/${c.category}/${c.slug}/`} class="a-case">
                      <span class="a-case__media" aria-hidden="true">
                        <img src={c.cover} alt="" loading="lazy" />
                      </span>
                      <span class="a-case__shade" aria-hidden="true" />
                      <span class="a-case__copy">
                        <strong>{c.client}</strong>
                        <span>
                          {c.metric} · {c.metricLabel}
                        </span>
                      </span>
                    </a>
                  ))}
                </div>
                <p style="margin-top:1.25rem">
                  <a class="a-btn a-btn--line" href="/keysy/ads/">
                    Все кейсы по контексту
                  </a>
                </p>
              </section>
            )
          }

          <section class="a-section a-reveal">
            <div class="a-section__head">
              <h2>Что получаете на практике</h2>
              <p>Не «показы ради отчёта», а управляемый канал заявок из поиска.</p>
            </div>
            <div class="a-outcomes">
              {
                adsOutcomes.map((item) => (
                  <article class="a-outcome">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="a-section a-reveal" id="faq">
            <div class="a-section__head">
              <h2>Частые вопросы</h2>
              <p>Тарифы, системы, сроки и сайт под рекламу.</p>
            </div>
            <div class="a-faq">
              {
                adsFaq.map((item) => (
                  <details class="a-faq__item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))
              }
            </div>
          </section>

          <section id="ads-cta" class="a-cta a-reveal">
            <div class="a-cta__copy">
              <div>
                <h2>Хотите заявки из поиска уже сейчас?</h2>
                <p>
                  Напишите нишу и ориентир по медиабюджету — подскажем тариф ведения
                  и реалистичный план запуска в Директе и Google Ads.
                </p>
                <ul class="a-cta__points">
                  <li>Тариф ведения по медиабюджету — без % от пополнения</li>
                  <li>Два счёта: услуги ПРАЙМ и медиабюджет отдельно</li>
                  <li>Запуск в Яндекс.Директе и Google Ads</li>
                  <li>Минус-слова, UTM и оптимизация ставок</li>
                </ul>
              </div>
              <div class="a-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="ads-form" class="a-form">
              <label class="visually-hidden" for="ads-name">Ваше имя</label>
              <input
                id="ads-name"
                type="text"
                name="name"
                placeholder="Ваше имя"
                autocomplete="name"
                required
              />
              <label class="visually-hidden" for="ads-phone">Телефон</label>
              <input
                id="ads-phone"
                type="tel"
                name="phone"
                placeholder="Телефон"
                autocomplete="tel"
                required
              />
              <label class="visually-hidden" for="ads-site">Адрес сайта</label>
              <input
                id="ads-site"
                type="url"
                name="site"
                placeholder="Адрес сайта"
                autocomplete="url"
              />
              <label class="visually-hidden" for="ads-system">Рекламная система</label>
              <select id="ads-system" name="system">
                <option value="">Интересует</option>
                <option>Яндекс.Директ</option>
                <option>Google Ads</option>
                <option>Обе системы</option>
              </select>
              <label class="visually-hidden" for="ads-budget">Медиабюджет в месяц</label>
              <select id="ads-budget" name="budget">
                <option value="">Медиабюджет в месяц</option>
                <option>до 100 000 ₽</option>
                <option>100–300 000 ₽</option>
                <option>свыше 300 000 ₽</option>
                <option>Пока не определили</option>
              </select>
              <label class="visually-hidden" for="ads-message">Ниша и задача</label>
              <textarea
                id="ads-message"
                name="message"
                rows="3"
                placeholder="Ниша и задача — коротко"
              ></textarea>
              <label class="a-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с нашей{" "}
                  <a
                    class="cookie-link"
                    href={legalDocs.privacy}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    >политикой</a
                  >.
                </span>
              </label>
              <button type="submit" class="a-btn a-btn--ink">Отправить заявку</button>
              <p id="ads-form-hint" class="a-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Контекстная реклама · Директ и Google Ads</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </main>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/kontekst.ts";
    </script>
  </body>
</html>
