---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/reputaciya.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import {
  ormProblem,
  ormPillars,
  ormPlatforms,
  ormSteps,
  ormOutcomes,
  ormNos,
  ormFaq,
  ormPricing,
} from "../data/orm-service";

const pageTitle = "Управление репутацией — ПРАЙМ";
const pageDescription =
  "Управление репутацией: аудит, стратегия, мониторинг негатива и формирование позитивного имиджа на Яндекс и Google Картах и отзовиках. Без накрутки отзывов.";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: ormFaq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="orm">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <SiteSeo
      title={pageTitle}
      description={pageDescription}
      path="/upravlenie-reputaciej/"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preload" as="image" href="/images/v6/photos/orm-hero.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500;1,9..144,600&family=Outfit:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell serviceActive="orm" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Управление репутацией</strong>
          </p>
          <a href="#orm-cta" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content">
          <section class="o-hero">
            <div class="o-hero__bg" aria-hidden="true" data-parallax-orm-bg></div>
            <div class="o-hero__veil" aria-hidden="true"></div>

            <div class="o-hero__copy">
              <p class="o-brand">ПРАЙ<em>М</em></p>
              <h1>
                Управление репутацией — вернуть <span>доверие</span> в ваши руки
              </h1>
              <p class="o-hero__lead">
                Пока довольные молчат, негатив рисует портрет компании. Налаживаем
                процессы, мониторинг и честный баланс отзывов.
              </p>
              <div class="o-hero__actions">
                <a href="#orm-cta" class="o-btn o-btn--primary">Получить консультацию</a>
                <a href="#pillars" class="o-btn o-btn--ghost">Что делаем</a>
              </div>
            </div>

            <div class="o-hero__score" aria-hidden="true">
              <div class="o-score">
                <p class="o-score__label">Баланс доверия</p>
                <p class="o-score__value" data-orm-score>4.8</p>
                <div class="o-score__stars">
                  <span></span><span></span><span></span><span></span><span></span>
                </div>
                <p class="o-score__hint">не рейтинг «нарисуем» — система, которая держит</p>
              </div>
              <div class="o-reviews">
                <div class="o-review">
                  <strong>Довольный клиент</strong>
                  Обычно молчит — пока его не попросить рассказать.
                </div>
                <div class="o-review">
                  <strong>Негатив</strong>
                  Пишет первым и громко — и задаёт тон в выдаче.
                </div>
                <div class="o-review">
                  <strong>Наша задача</strong>
                  Вернуть объективную картину и процессы внутри.
                </div>
              </div>
            </div>
          </section>

          <section class="o-section o-reveal">
            <div class="o-section__head">
              <h2>Порочный круг негатива</h2>
              <p>Почему «всё нормально у нас» не видно тем, кто выбирает вас в сети.</p>
            </div>
            <div class="o-story">
              <div class="o-story__main">
                <p>{ormProblem.lead}</p>
                <p>{ormProblem.distort}</p>
                <p>{ormProblem.cycle}</p>
              </div>
              <div class="o-story__side">
                <article>
                  <h3>Доверие у меньшинства</h3>
                  <p>{ormProblem.trust}</p>
                </article>
                <article>
                  <h3>Нужен механизм</h3>
                  <p>
                    Не «залить пятёрками», а стратегия, обучение команды и
                    ежедневная работа с площадками.
                  </p>
                </article>
              </div>
            </div>
          </section>

          <section class="o-section o-reveal" id="pillars">
            <div class="o-section__head">
              <h2>Персональные консультации — и система, с которой вы работаете</h2>
              <p>
                Четыре направления внутреннего управления репутацией — от аудита
                до позитивного имиджа.
              </p>
            </div>
            <div class="o-pillars">
              {
                ormPillars.map((p) => (
                  <article class="o-pillar">
                    <span class="o-pillar__n">{p.n}</span>
                    <h3>{p.title}</h3>
                    <p>{p.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="o-section o-reveal">
            <div class="o-section__head">
              <h2>Где репутация решает</h2>
              <p>Карты, отзовики и поиск — точки, где клиент решает до звонка.</p>
            </div>
            <div class="o-platforms">
              {
                ormPlatforms.map((p) => (
                  <article class="o-platform">
                    <h3>{p.title}</h3>
                    <p>{p.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="o-section o-reveal">
            <div class="o-section__head">
              <h2>Как выстраиваем работу</h2>
              <p>От картины «как есть» до процессов, которые живут без хаоса.</p>
            </div>
            <div class="o-steps">
              {
                ormSteps.map((s) => (
                  <article class="o-step">
                    <span class="o-step__n">Шаг {s.n}</span>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="o-section o-reveal">
            <div class="o-section__head">
              <h2>Что меняется на практике</h2>
              <p>Не «звёздочки ради отчёта», а система, которую видно клиенту и команде.</p>
            </div>
            <div class="o-outcomes">
              {
                ormOutcomes.map((item) => (
                  <article class="o-outcome">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="o-section o-reveal">
            <div class="o-section__head">
              <h2>Чего не делаем</h2>
              <p>Чтобы не путать управление репутацией с серыми схемами.</p>
            </div>
            <div class="o-nos">
              {
                ormNos.map((item) => (
                  <article class="o-no">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="o-price o-reveal">
            <div>
              <h2>{ormPricing.title}</h2>
              <p>{ormPricing.text}</p>
            </div>
            <p class="o-price__mark">После разбора ниши и площадок</p>
          </section>

          <section class="o-section o-reveal" id="faq">
            <div class="o-section__head">
              <h2>Частые вопросы</h2>
              <p>Коротко о сроках, площадках и том, с чего начать.</p>
            </div>
            <div class="o-faq">
              {
                ormFaq.map((item) => (
                  <details class="o-faq__item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))
              }
            </div>
          </section>

          <section id="orm-cta" class="o-cta o-reveal">
            <div class="o-cta__copy">
              <div>
                <h2>Готовы вернуть баланс отзывов?</h2>
                <p>
                  Оставьте заявку — разберём текущий фон и предложим план: аудит,
                  процессы или сопровождение.
                </p>
                <ul class="o-cta__points">
                  <li>Аудит карт и отзовиков без «накрутки»</li>
                  <li>Работа с негативом и рост позитива</li>
                  <li>Процессы для команды — ответы и контроль</li>
                  <li>Разбор ниши за 30 минут · без обязательств</li>
                </ul>
              </div>
              <div class="o-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="orm-form" class="o-form">
              <input type="text" name="name" placeholder="Ваше имя" required />
              <input type="tel" name="phone" placeholder="Телефон" required />
              <input type="text" name="brand" placeholder="Название компании / бренд" />
              <select name="focus">
                <option value="">Что приоритетнее</option>
                <option>Аудит и стратегия</option>
                <option>Работа с негативом</option>
                <option>Рост положительных отзывов</option>
                <option>Обучение команды</option>
                <option>Комплекс</option>
              </select>
              <textarea
                name="message"
                rows="3"
                placeholder="Где болит сильнее — карты, отзовики, поиск?"></textarea>
              <label class="o-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с нашей{" "}
                  <a
                    class="cookie-link"
                    href={legalDocs.privacy}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    >политикой</a
                  >.
                </span>
              </label>
              <button type="submit" class="o-btn o-btn--primary">Отправить заявку</button>
              <p id="orm-form-hint" class="o-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Управление репутацией · отзывы · доверие</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/reputaciya.ts";
    </script>
  </body>
</html>
