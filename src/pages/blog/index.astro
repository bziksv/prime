---
import "../../styles/concept-v6.css";
import "../../styles/concept-v6-media.css";
import "../../styles/blog.css";
import PortalShell from "../../components/PortalShell.astro";
import CookieConsent from "../../components/CookieConsent.astro";
import CookieFooterNotice from "../../components/CookieFooterNotice.astro";
import SiteSeo from "../../components/SiteSeo.astro";
import { v6Icons } from "../../data/v6-media";
import {
  blogPosts,
  formatReadingTime,
  formatViews,
  getBaseViews,
  getBlogCategories,
  getReadingMinutes,
} from "../../data/blog";
import { getBlogMigrationProgress } from "../../data/blog-migration";
import { breadcrumbJsonLd } from "../../lib/breadcrumb-jsonld";

const categories = getBlogCategories();
const featured = blogPosts[0];
/** Дашборд миграции только в `astro dev` — на проде (build) не рендерится. */
const showMigrateDashboard = import.meta.env.DEV;
const migration = showMigrateDashboard ? getBlogMigrationProgress() : null;

const blogDescription = `Блог ПРАЙМ: ${blogPosts.length} статей про SEO, семантику, контекст, SMM и интернет-маркетинг — практика агентства.`;
const blogOgImage = (featured?.cover || "").split("?")[0] || undefined;
const crumbsLd = breadcrumbJsonLd(
  [
    { label: "Главная", href: "/" },
    { label: "Блог" },
  ],
  {
    origin: Astro.site?.origin ?? "https://prime-ltd.su",
    currentPath: "/blog/",
  },
);
---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="blog">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={blogDescription} />
    <title>Блог — ПРАЙМ</title>
    <SiteSeo
      title="Блог — ПРАЙМ"
      description={blogDescription}
      path="/blog/"
      image={blogOgImage}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Блог ПРАЙМ"
      href="/blog/rss.xml"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell active="blog" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню" aria-controls="v6-sidebar" aria-expanded="false">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Блог</strong>
          </p>
          <a href="/kontakty/" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content" data-blog-index>
          <section class="b-hero">
            <p class="b-hero__kicker">Материалы агентства</p>
            <h1>Блог</h1>
            <p class="b-hero__lead">
              Практические статьи по SEO и маркетингу — из опыта проектов ПРАЙМ.
            </p>

            <div class="b-search" role="search">
              <label class="b-search__label" for="blog-search-input">Поиск по блогу</label>
              <div class="b-search__row">
                <span class="b-search__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
                    <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                  </svg>
                </span>
                <input
                  id="blog-search-input"
                  type="search"
                  data-blog-search
                  placeholder="Семантика, аудит, структура сайта…"
                  autocomplete="off"
                  spellcheck="false"
                  enterkeyhint="search"
                />
                <kbd class="b-search__kbd">⌘K</kbd>
                <button type="button" class="b-search__clear" data-blog-search-clear hidden aria-label="Очистить">
                  ×
                </button>
              </div>
              <p class="b-search__hint">
                Ищет по заголовкам, разделам и тексту · понимает опечатки и синонимы
              </p>
            </div>
          </section>

          {
            showMigrateDashboard && migration ? (
          <section class="b-migrate" aria-label="Прогресс переноса блога (только localhost)">
            <div class="b-migrate__head">
              <div>
                <p class="b-migrate__kicker">Миграция со старого сайта</p>
                <h2 class="b-migrate__title">Перенос и новый формат</h2>
                <p class="b-migrate__lead">
                  Перенос на Astro и «новый формат» — разные вещи. Тексты уже тащим,
                  целевую вёрстку статей ещё не делали.
                </p>
              </div>
              <p class="b-migrate__local-badge" title="Блок виден только в astro dev, на проде отсутствует">
                <span aria-hidden="true">●</span>
                LOCAL ONLY · не на проде
              </p>
            </div>

            <div class="b-migrate__tracks">
              <div class="b-migrate__track">
                <div class="b-migrate__track-label">
                  <span>Перенесено</span>
                  <strong>{migration.migrated} / {migration.eligible}</strong>
                </div>
                <div
                  class="b-migrate__bar"
                  role="progressbar"
                  aria-valuemin="0"
                  aria-valuemax={migration.eligible}
                  aria-valuenow={migration.migrated}
                  aria-label={`Перенесено ${migration.migrated} из ${migration.eligible}`}
                >
                  <span style={`width: ${Math.max(migration.migratePct, migration.migrated ? 2 : 0)}%`}></span>
                </div>
              </div>
              <div class="b-migrate__track">
                <div class="b-migrate__track-label">
                  <span>Новый формат</span>
                  <strong>{migration.newFormat} / {migration.eligible}</strong>
                </div>
                <div
                  class="b-migrate__bar b-migrate__bar--format"
                  role="progressbar"
                  aria-valuemin="0"
                  aria-valuemax={migration.eligible}
                  aria-valuenow={migration.newFormat}
                  aria-label={`В новом формате ${migration.newFormat} из ${migration.eligible}`}
                >
                  <span style={`width: ${Math.max(migration.formatPct, migration.newFormat ? 2 : 0)}%`}></span>
                </div>
              </div>
            </div>

            <div class="b-migrate__stats">
              <div class="b-migrate__stat b-migrate__stat--done">
                <strong>{migration.migrated}</strong>
                <span>перенесено на Astro</span>
              </div>
              <div class="b-migrate__stat b-migrate__stat--format">
                <strong>{migration.newFormat}</strong>
                <span>в новом формате</span>
              </div>
              <div class="b-migrate__stat">
                <strong>{migration.left}</strong>
                <span>ещё перенести</span>
              </div>
              <div class="b-migrate__stat">
                <strong>{migration.eligible}</strong>
                <span>пригодных в чеклисте</span>
              </div>
            </div>
            <p class="b-migrate__note">
              Skip / мусор в чеклисте: {migration.skip}. Этот дашборд рендерится только
              в <code>astro dev</code> — в production-сборке блока нет.
            </p>

            <div class="b-migrate__cats" aria-label="Рубрики в чеклисте">
              {
                migration.byCategory.slice(0, 8).map((c) => (
                  <span class="b-migrate__chip">
                    {c.name} <em>{c.count}</em>
                  </span>
                ))
              }
              {
                migration.byCategory.length > 8 ? (
                  <span class="b-migrate__chip b-migrate__chip--more">
                    +{migration.byCategory.length - 8} ещё
                  </span>
                ) : null
              }
            </div>

            <div class="b-migrate__articles" data-migrate-articles>
              <div class="b-migrate__articles-head">
                <h3 class="b-migrate__articles-title">Перенесённые статьи</h3>
                <div class="b-migrate__articles-meta">
                  <span class="b-migrate__local-badge b-migrate__local-badge--sm">
                    LOCAL ONLY
                  </span>
                  <span class="b-migrate__articles-count" data-migrate-count>
                    {migration.articles.length}
                  </span>
                </div>
              </div>

              <div class="b-migrate__tools">
                <label class="b-migrate__search">
                  <span class="visually-hidden">Поиск по перенесённым статьям</span>
                  <input
                    type="search"
                    data-migrate-search
                    placeholder="Семантика, Instagram, охват…"
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <button
                    type="button"
                    class="b-migrate__search-clear"
                    data-migrate-search-clear
                    hidden
                    aria-label="Очистить поиск"
                  >
                    ×
                  </button>
                </label>
                <label class="b-migrate__sort">
                  <span class="visually-hidden">Сортировка</span>
                  <select data-migrate-sort>
                    <option value="relevance">По релевантности</option>
                    <option value="title-asc" selected>Название А→Я</option>
                    <option value="title-desc">Название Я→А</option>
                    <option value="words-desc">Слов: больше → меньше</option>
                    <option value="words-asc">Слов: меньше → больше</option>
                    <option value="date-desc">Сначала новые</option>
                    <option value="date-asc">Сначала старые</option>
                  </select>
                </label>
              </div>
              <p class="b-migrate__tools-hint" data-migrate-status>
                Умный поиск: смысл, опечатки и синонимы · сортировка без пагинации
              </p>

              <div class="b-migrate__articles-scroll" tabindex="0">
                <table class="b-migrate__table">
                  <thead>
                    <tr>
                      <th scope="col">
                        <button type="button" class="b-migrate__th-btn" data-migrate-sort-btn="title">
                          Название
                        </button>
                      </th>
                      <th scope="col">Ссылка</th>
                      <th scope="col">
                        <button type="button" class="b-migrate__th-btn" data-migrate-sort-btn="words">
                          Слов
                        </button>
                      </th>
                    </tr>
                  </thead>
                  <tbody data-migrate-tbody>
                    {
                      migration.articles.map((a) => (
                        <tr
                          data-slug={a.slug}
                          data-title={a.title}
                          data-words={a.words}
                          data-date={a.date}
                          data-category={a.category}
                        >
                          <td>
                            <a href={a.href}>{a.title}</a>
                          </td>
                          <td>
                            <a class="b-migrate__path" href={a.href}>{a.href}</a>
                          </td>
                          <td>
                            <span class="b-migrate__words">
                              {a.words.toLocaleString("ru-RU")}
                            </span>
                          </td>
                        </tr>
                      ))
                    }
                  </tbody>
                </table>
                <p class="b-migrate__empty" data-migrate-empty hidden>
                  Ничего не нашли. Попробуйте другое слово или очистите поиск.
                </p>
              </div>
            </div>
          </section>
            ) : null
          }

          <div class="b-toolbar">
            <div class="b-cats" role="group" aria-label="Рубрики">
              <button
                type="button"
                class="b-cat is-active"
                data-blog-cat="all"
                aria-pressed="true"
              >
                Все <span>{blogPosts.length}</span>
              </button>
              {
                categories.map((c) => (
                  <button
                    type="button"
                    class="b-cat"
                    data-blog-cat={c.name}
                    aria-pressed="false"
                  >
                    {c.name} <span>{c.count}</span>
                  </button>
                ))
              }
            </div>
            <p class="b-status" data-blog-status></p>
          </div>

          {
            featured ? (
              <a
                href={`/blog/${featured.slug}/`}
                class="b-featured"
                data-blog-featured
                data-slug={featured.slug}
                data-category={featured.category}
              >
                <div class="b-featured__media">
                  <img src={featured.cover} alt="" loading="eager" />
                </div>
                <div class="b-featured__body">
                  <div class="b-featured__meta">
                    <span class="b-featured__cat">{featured.category}</span>
                    <span class="b-meta-chip">{formatReadingTime(getReadingMinutes(featured))}</span>
                    <span class="b-meta-chip">{formatViews(getBaseViews(featured))} просм.</span>
                  </div>
                  <h2>{featured.title}</h2>
                  <p>{featured.excerpt}</p>
                  <span class="b-read">
                    Читать статью
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </div>
              </a>
            ) : null
          }

          <div class="b-grid" data-blog-grid></div>
          <div class="b-more" data-blog-more hidden>
            <button type="button" class="b-more__btn" data-blog-more-btn>
              Показать ещё
            </button>
            <p class="b-more__meta" data-blog-more-meta></p>
          </div>
          <p class="b-empty" data-blog-empty hidden></p>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Блог · SEO · маркетинг</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <CookieConsent />
    <script>
      import "../../scripts/concept-v6.ts";
      import "../../scripts/blog-ui.ts";
    </script>
  </body>
</html>
