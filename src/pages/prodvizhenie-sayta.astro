---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/prodvizhenie.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import { getCasesByCategory } from "../data/cases";
import {
  seoPillars,
  seoOutcomes,
  seoSteps,
  seoAdvantages,
  seoTariffs,
  seoRegions,
  seoPlainSpeak,
  seoDemoRanks,
  seoNos,
  seoFaq,
} from "../data/seo-service";

const seoCases = getCasesByCategory("seo").slice(0, 4);

const marquee = [
  { t: "ТОП-10", e: "по факту" },
  { t: "Яндекс", e: "Google" },
  { t: "Семантика", e: "без мусора" },
  { t: "Аудит", e: "до старта" },
  { t: "Отчёты", e: "прозрачно" },
  { t: "С 2015", e: "на рынке" },
];
const marqueeLoop = [...marquee, ...marquee];

const chapters = [
  { id: "about", label: "Суть" },
  { id: "work", label: "Работа" },
  { id: "result", label: "Результат" },
  { id: "start", label: "Старт" },
  { id: "pricing", label: "Тарифы" },
  { id: "advantages", label: "Плюсы" },
  ...(seoCases.length > 0 ? [{ id: "cases", label: "Кейсы" }] : []),
  { id: "faq", label: "FAQ" },
  { id: "seo-cta", label: "Заявка" },
];

const pageTitle = "Продвижение сайта — ПРАЙМ";
const pageDescription =
  "SEO-продвижение сайта с оплатой по факту ТОП-10. Аналитика, аудит, внутренняя и внешняя оптимизация. Подготовка ~1 мес., выход в ТОП планово 2–6 мес. Тарифы для регионов, Москвы и СПб.";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: seoFaq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="seo">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <SiteSeo
      title={pageTitle}
      description={pageDescription}
      path="/prodvizhenie-sayta/"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preload" as="image" href="/images/v6/photos/seo-hero.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell serviceActive="seo" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Продвижение сайта</strong>
          </p>
          <a href="#seo-cta" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content" data-s-page>
          <div class="s-progress" aria-hidden="true">
            <i data-s-progress></i>
          </div>

          <div class="s-night">
          <section class="s-hero" data-parallax-hero data-s-hero>
            <div class="s-hero__photo" aria-hidden="true" data-parallax-hero-bg></div>
            <div class="s-hero__orb s-hero__orb--1" aria-hidden="true" data-s-orb></div>
            <div class="s-hero__orb s-hero__orb--2" aria-hidden="true" data-s-orb></div>
            <div class="s-hero__grid" aria-hidden="true"></div>
            <p class="s-hero__giant" aria-hidden="true">TOP</p>

            <div class="s-hero__inner">
              <p class="s-brand">ПРАЙ<em>М</em></p>
              <p class="s-kicker">Pay per TOP-10 · без абонентской «воды»</p>
              <h1>Продвижение сайта с оплатой <span>по факту ТОП-10</span></h1>
              <p class="s-hero__lead">
                Выводим в первую десятку по ключевым запросам. Платите за фразы,
                которые реально закрепились в выдаче.
              </p>
              <div class="s-hero__actions">
                <a href="#seo-cta" class="s-btn s-btn--primary">Получить расчёт</a>
                <a href="#pricing" class="s-btn s-btn--ghost">Смотреть тарифы</a>
              </div>
              <a href="#about" class="s-hero__scroll" data-s-scroll-hint>
                <span>Листать</span>
                <i aria-hidden="true"></i>
              </a>
            </div>

            <aside class="s-rank" data-s-rank aria-label="Демо оплаты по факту ТОП-10">
              <header class="s-rank__head">
                <span class="s-rank__live"><i></i> live ranks</span>
                <span class="s-rank__proto">PRIME · SERP</span>
              </header>

              <ul class="s-rank__list">
                {
                  seoDemoRanks.map((r, i) => (
                    <li
                      class="s-rank__row"
                      data-s-rank-row
                      data-from={r.from}
                      data-to={r.to}
                      style={`--i:${i}`}
                    >
                      <span class="s-rank__pos" data-s-rank-pos>#{r.from}</span>
                      <span class="s-rank__q">{r.q}</span>
                      <span class="s-rank__badge" data-s-rank-badge>out</span>
                    </li>
                  ))
                }
              </ul>

              <div class="s-rank__stats">
                <div>
                  <span>in TOP-10</span>
                  <strong><em data-s-rank-in>0</em> / {seoDemoRanks.length}</strong>
                </div>
                <div>
                  <span>billable</span>
                  <strong data-s-rank-bill>0 фраз</strong>
                </div>
              </div>
              <p class="s-rank__note" data-s-rank-note>
                Вне ТОП-10 = 0 ₽ · платите только за закреплённые фразы
              </p>
            </aside>

            <div class="s-hero__stripe" aria-hidden="true"></div>
          </section>

          <div class="s-marquee" aria-hidden="true">
            <div class="s-marquee__track">
              {
                marqueeLoop.map((m) => (
                  <span>
                    {m.t}
                    <em>{m.e}</em>
                  </span>
                ))
              }
            </div>
          </div>

          <section class="s-model s-reveal">
            <div>
              <h2>Не танцы с бубном — проектная работа</h2>
              <p>
                SEO — часть интернет-маркетинга: при соблюдении технологии вы
                получаете рост позиций, трафика и продаж. Чем больше сайт — тем
                сложнее работа. Ниже — что именно делаем.
              </p>
            </div>
            <div class="s-model__metrics">
              <div class="s-model__metric">
                <strong>ТОП-10</strong>
                <span>оплата по факту фраз</span>
              </div>
              <div class="s-model__metric">
                <strong>4 мес.</strong>
                <span>стартовый период тарифа</span>
              </div>
              <div class="s-model__metric">
                <strong>с 2015</strong>
                <span>модель на практике</span>
              </div>
            </div>
          </section>
          </div>

          <nav class="s-chapters" data-s-chapters aria-label="Разделы страницы">
            <div class="s-chapters__inner">
              <div class="s-chapters__scroller">
                <div class="s-chapters__track" data-s-chapters-track>
                  <span class="s-chapters__thumb" data-s-chapters-thumb aria-hidden="true"></span>
                  {
                    chapters.map((c, i) => (
                      <a
                        href={`#${c.id}`}
                        class="s-chapters__link"
                        data-s-chapter={c.id}
                        data-i={i}
                      >
                        {c.label}
                      </a>
                    ))
                  }
                </div>
              </div>
            </div>
          </nav>

          <div class="s-day">
          <section class="s-section s-reveal" id="about" data-s-section>
            <div class="s-section__head">
              <h2>Что это и зачем вам</h2>
              <p>
                Комплекс внутренней и внешней оптимизации для вывода в ТОП-10 —
                больше посещений, заявок и звонков. Для максимального охвата
                рекомендуем связку с контекстной рекламой.
              </p>
            </div>
            <div class="s-about">
              <div class="s-about__copy">
                <p>
                  Многие думают, что SEO — шаманство: платишь, специалист
                  «что-то крутит», и сайт то выходит в ТОП, то нет. На деле это
                  технология: аудит, семантика, правки на сайте, внешняя работа
                  и постоянный контроль позиций.
                </p>
                <p>
                  Мы не предлагаем продвижение по запросам, которые никто не
                  ищет. В ядро попадают фразы с реальным спросом — те, что
                  приводят клиентов, а не красивые цифры в отчёте.
                </p>
              </div>
              <div class="s-plain">
                {
                  seoPlainSpeak.map((item) => (
                    <article class="s-plain__item">
                      <strong>{item.jargon}</strong>
                      <p>{item.plain}</p>
                    </article>
                  ))
                }
              </div>
            </div>
          </section>

          <section class="s-section s-reveal" id="work" data-s-section>
            <div class="s-section__head">
              <h2>Из чего состоит работа</h2>
              <p>Четыре блока — от целей и аудита до внутренней и внешней оптимизации.</p>
            </div>
            <div class="s-pillars" data-s-pillars>
              <div class="s-pillars__nav" role="tablist" aria-label="Этапы SEO" data-s-pillars-nav>
                <span class="s-pillars__thumb" data-s-pillars-thumb aria-hidden="true"></span>
                {
                  seoPillars.map((p, i) => (
                    <button
                      type="button"
                      class:list={["s-pillars__btn", { "is-active": i === 0 }]}
                      role="tab"
                      data-pillar={p.id}
                      data-i={i}
                      aria-selected={i === 0 ? "true" : "false"}
                    >
                      <em>0{i + 1}</em>
                      {p.title}
                    </button>
                  ))
                }
              </div>
              {
                seoPillars.map((p, i) => (
                  <div
                    class:list={["s-pillars__panel", { "is-active": i === 0 }]}
                    role="tabpanel"
                    data-pillar-panel={p.id}
                    hidden={i !== 0}
                  >
                    <h3>{p.title}</h3>
                    <p>{p.lead}</p>
                    <ul>
                      {p.items.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </div>
                ))
              }
            </div>
          </section>

          <section class="s-section s-section--tint s-reveal" id="result" data-s-section>
            <div class="s-section__head">
              <h2>В результате от SEO вы получите</h2>
              <p>Три понятных эффекта — не «видимость ради видимости».</p>
            </div>
            <div class="s-outcomes">
              {
                seoOutcomes.map((o, i) => (
                  <article class="s-outcome">
                    <span class="s-outcome__n">0{i + 1}</span>
                    <h3>{o.title}</h3>
                    <p>{o.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="s-section s-reveal" id="start" data-s-section>
            <div class="s-section__head">
              <h2>С чего начать</h2>
              <p>Четыре шага — от заявки до коммерческого предложения.</p>
            </div>
            <div class="s-steps">
              {
                seoSteps.map((s) => (
                  <article class="s-step">
                    <span class="s-step__n">{s.n}</span>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="s-section s-section--pricing s-reveal" id="pricing" data-s-section>
            <div class="s-section__head">
              <h2>Стоимость</h2>
              <p>
                Расчёт индивидуальный: ниша и конкуренция в регионе. Частный
                сад в Воронеже и металлопрокат — разные бюджеты. Ниже — стартовые
                ориентиры.
              </p>
            </div>
            <p class="s-price-note">
              * Первые 4 месяца по тарифу. Далее — оплата по факту нахождения
              фраз в ТОП-10.
            </p>

            <div class="s-regions" role="group" aria-label="Регион тарифа" data-s-regions>
              <span class="s-regions__thumb" data-s-regions-thumb aria-hidden="true"></span>
              {
                seoRegions.map((r, i) => (
                  <button
                    type="button"
                    class:list={[{ "is-active": i === 0 }]}
                    data-region={r.id}
                    data-i={i}
                  >
                    {r.label}
                  </button>
                ))
              }
            </div>

            <div class="s-tariffs">
              {
                seoTariffs.map((t) => (
                  <article class:list={["s-tariff", { "s-tariff--featured": t.featured }]}>
                    {t.featured ? <span class="s-tariff__badge">Частый выбор</span> : null}
                    <h3 class="s-tariff__name">{t.name}</h3>
                    <p class="s-tariff__phrases">{t.phrases} фраз</p>
                    <p
                      class="s-tariff__price"
                      data-price
                      data-price-region={t.prices.region}
                      data-price-msk={t.prices.msk}
                      data-price-spb={t.prices.spb}
                    >
                      {t.prices.region.toLocaleString("ru-RU")} ₽
                    </p>
                    <p class="s-tariff__period">в месяц · стартовые 4 месяца</p>
                    <div class="s-tariff__meta">
                      <div>
                        Бекап: <strong>{t.backup}</strong>
                      </div>
                      <div>
                        Контент: <strong>{t.contentHours}</strong> · Техподдержка:{" "}
                        <strong>{t.techHours}</strong>
                      </div>
                      <div>
                        Контекст: <strong>{t.ads}</strong>
                      </div>
                    </div>
                    <ul class="s-tariff__features">
                      {t.features.map((f) => (
                        <li class={f.ok ? "is-on" : "is-off"}>
                          <span aria-hidden="true">{f.ok ? "→" : "×"}</span>
                          {f.label}
                        </li>
                      ))}
                    </ul>
                    <a href="#seo-cta" class="s-btn s-btn--primary">Запросить тариф</a>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="s-section s-reveal" id="advantages" data-s-section>
            <div class="s-section__head">
              <h2>Наши преимущества</h2>
              <p>
                Цель — максимальная отдача от бюджета. Опыт в разных нишах
                помогает получать результат при разумных вложениях.
              </p>
            </div>
            <div class="s-adv">
              {
                seoAdvantages.map((a) => (
                  <article>
                    <h3>{a.title}</h3>
                    <p>{a.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          {
            seoCases.length > 0 && (
              <section class="s-section s-reveal" id="cases" data-s-section>
                <div class="s-section__head">
                  <h2>Кейсы по SEO</h2>
                  <p>Реальные проекты с оплатой по позициям и понятными цифрами.</p>
                </div>
                <div class="s-cases">
                  {seoCases.map((c) => (
                    <a href={`/keysy/${c.category}/${c.slug}/`} class="s-case">
                      <span class="s-case__media" aria-hidden="true">
                        <img src={c.cover} alt="" loading="lazy" />
                      </span>
                      <span class="s-case__shade" aria-hidden="true" />
                      <span class="s-case__copy">
                        <strong>{c.client}</strong>
                        <span>
                          {c.metric} · {c.metricLabel}
                        </span>
                      </span>
                    </a>
                  ))}
                </div>
                <p style="margin-top:1.25rem">
                  <a class="s-btn s-btn--ghost" href="/keysy/seo/">
                    Все SEO-кейсы
                  </a>
                </p>
              </section>
            )
          }

          <section class="s-section s-reveal" id="honest" data-s-section>
            <div class="s-section__head">
              <h2>Чего не обещаем</h2>
              <p>Чтобы «запуск» не читался как гарантия ТОП-10 через месяц.</p>
            </div>
            <div class="s-nos">
              {
                seoNos.map((item) => (
                  <article class="s-no">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="s-section s-reveal" id="faq" data-s-section>
            <div class="s-section__head">
              <h2>Частые вопросы</h2>
              <p>Оплата по факту, сроки ТОП, отличие от трафика и тарифы.</p>
            </div>
            <div class="s-faq">
              {
                seoFaq.map((item) => (
                  <details class="s-faq__item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))
              }
            </div>
          </section>
          </div>

          <section id="seo-cta" class="s-cta s-reveal" data-s-section>
            <div class="s-cta__copy">
              <div>
                <h2>Нужны клиенты из поиска?</h2>
                <p>
                  Есть сайт — и нужны заявки. Оставьте контакты: разберём нишу,
                  скажем, что реально продвигать, и пришлём расчёт.
                </p>
                <ul class="s-cta__points">
                  <li>Разбор ниши и конкуренции в вашем регионе</li>
                  <li>Подготовка ~1 мес. · ТОП планово 2–6 мес.</li>
                  <li>Расчёт тарифа — без скрытых «пакетов»</li>
                  <li>Оплата по факту позиций, не «за процесс»</li>
                </ul>
              </div>
              <div class="s-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="seo-form" class="s-form">
              <label class="visually-hidden" for="seo-name">Ваше имя</label>
              <input
                id="seo-name"
                type="text"
                name="name"
                placeholder="Ваше имя"
                autocomplete="name"
                required
              />
              <label class="visually-hidden" for="seo-phone">Телефон</label>
              <input
                id="seo-phone"
                type="tel"
                name="phone"
                placeholder="Телефон"
                autocomplete="tel"
                required
              />
              <label class="visually-hidden" for="seo-site">Адрес сайта</label>
              <input
                id="seo-site"
                type="url"
                name="site"
                placeholder="Адрес сайта"
                autocomplete="url"
              />
              <label class="visually-hidden" for="seo-region">Регион продвижения</label>
              <select id="seo-region" name="region">
                <option value="">Регион продвижения</option>
                <option>Регионы РФ</option>
                <option>Москва и Московская область</option>
                <option>Санкт-Петербург и Ленинградская область</option>
              </select>
              <label class="visually-hidden" for="seo-message">Ниша и задача</label>
              <textarea
                id="seo-message"
                name="message"
                rows="3"
                placeholder="Ниша и задача — коротко"
              ></textarea>
              <label class="s-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с нашей{" "}
                  <a
                    class="cookie-link"
                    href={legalDocs.privacy}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    >политикой</a
                  >.
                </span>
              </label>
              <button type="submit" class="s-btn s-btn--primary">Отправить заявку</button>
              <p id="seo-form-hint" class="s-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Продвижение сайта · оплата по факту ТОП-10</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/prodvizhenie.ts";
    </script>
  </body>
</html>
