---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/razrabotka.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import { getCasesByCategory } from "../data/cases";
import {
  webNos,
  webSpeed,
  webBrand,
  webCms,
  webProducts,
  webSpectrum,
  webPlatforms,
  webProof,
  webDevice,
  webFaq,
} from "../data/web-service";
import { breadcrumbJsonLd } from "../lib/breadcrumb-jsonld";

const webCases = getCasesByCategory("web").slice(0, 4);

const heroFlanks = {
  strict: {
    label: "Строгий стиль",
    text: "Корпоративный сайт без шума: спокойная типографика, сетка, доверие.",
  },
  concept: {
    label: "Концепт",
    text: "Живые эффекты, параллакс и 3D — когда сайт должен запомниться.",
  },
} as const;

const pageTitle = "Разработка сайтов — ПРАЙМ";
const pageDescription =
  "Разработка сайтов: лендинг, мультилендинг, визитка, корпоратив и магазин. Bitrix, Webasyst, WordPress, Next.js, Astro, Laravel, Vue, Node.js, 1С — быстрее и дешевле кастома с нуля.";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: webFaq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
const crumbsLd = breadcrumbJsonLd(
  [
    { label: "Главная", href: "/" },
    { label: "Разработка сайтов" },
  ],
  {
    origin: Astro.site?.origin ?? "https://prime-ltd.su",
    currentPath: "/razrabotka-saytov/",
  },
);

---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="web">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <SiteSeo
      title={pageTitle}
      description={pageDescription}
      path="/razrabotka-saytov/"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700&family=Orbitron:wght@700;800;900&family=Sora:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell serviceActive="web" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Разработка сайтов</strong>
          </p>
          <a href="#web-cta" class="v6-btn" data-ink-btn>Оставить заявку</a>
        </header>

        <div class="v6-content v6-content--web">
          <section class="w-hero" data-web-hero>
            <div class="w-hero__beam" aria-hidden="true" data-hero-beam>
              <span class="w-hero__beam-glow"></span>
              <span class="w-hero__beam-core"></span>
              <span class="w-hero__beam-noise"></span>
            </div>

            <p class="w-hero__word" aria-hidden="true" data-hero-wordmark>
              <span class="w-hero__word-outline">ПРАЙМ</span>
              <span class="w-hero__word-ghost">ПРАЙМ</span>
            </p>

            <div class="w-robot-shell" data-robot-shell>
              <div class="w-robot-shell__loader" aria-hidden="true">
                <span></span>
              </div>
              <canvas class="w-robot-canvas" data-spline-robot></canvas>
              <div class="w-robot-shell__fade" aria-hidden="true"></div>
              <div class="w-robot-shell__fallback" aria-hidden="true">
                <p>ПРАЙМ</p>
              </div>
            </div>

            <div class="w-hero__inner">
              <div class="w-hero__top">
                <h1>
                  Сайты, которые<br />
                  <span class="w-hero__rotate" aria-live="polite">
                    <span
                      class="w-hero__rotate-word is-in"
                      data-rotate-word
                      data-rotate-words="собирают заявки|удивляют|продают|запоминаются"
                      >собирают заявки</span
                    >
                  </span>
                </h1>
                <p class="w-hero__lead">
                  Живой 3D и чёткая структура. Лендинги, визитки, корпоративы и
                  магазины — на готовых блоках или с обычной разработкой под задачу.
                </p>
              </div>

              <div class="w-hero__stage">
                <aside class="w-flank w-flank--strict">
                  <p class="w-flank__label">{heroFlanks.strict.label}</p>
                  <div class="w-flank__plaque">
                    <p class="w-flank__title">
                      Классика<br />и строгость
                    </p>
                    <p>{heroFlanks.strict.text}</p>
                  </div>
                </aside>

                <div class="w-hero__stage-gap" aria-hidden="true"></div>

                <aside class="w-flank w-flank--concept" data-hero-concept>
                  <p class="w-flank__label">{heroFlanks.concept.label}</p>
                  <div class="w-flank__glow" aria-hidden="true"></div>
                  <div class="w-flank__card">
                    <p class="w-flank__title">
                      Презентации<br />и удивление
                    </p>
                    <p>{heroFlanks.concept.text}</p>
                    <ul class="w-flank__tags" aria-hidden="true">
                      <li>parallax</li>
                      <li>3D</li>
                      <li>motion</li>
                    </ul>
                  </div>
                </aside>
              </div>

              <div class="w-hero__foot">
                <div class="w-hero__actions">
                  <a href="#web-cta" class="w-btn w-btn--primary" data-ink-btn>Оставить заявку</a>
                  <a href="#spectrum" class="w-btn w-btn--ghost">Смотреть стили</a>
                </div>
                <a href="#spectrum" class="w-scroll" aria-label="Дальше">
                  <span class="w-scroll__ring">scroll down</span>
                  <span class="w-scroll__arrow">↓</span>
                </a>
              </div>
            </div>
          </section>

          <section class="w-proof w-reveal" data-specs aria-labelledby="web-proof-title">
            <div class="w-proof__head">
              <p class="w-proof__eyebrow">{webProof.eyebrow}</p>
              <h2 id="web-proof-title">{webProof.title}</h2>
              <p class="w-proof__lead">{webProof.lead}</p>
            </div>

            <div class="w-proof__layout">
              <article class="w-proof__hero">
                <p class="w-proof__label">{webProof.hero.label}</p>
                <p class="w-proof__value" aria-label={`${webProof.hero.prefix}${webProof.hero.value}${webProof.hero.suffix}`}>
                  <span class="w-proof__prefix">{webProof.hero.prefix}</span>
                  <span data-count={webProof.hero.value}>0</span>
                  <span class="w-proof__suffix">{webProof.hero.suffix}</span>
                </p>
                <div class="w-proof__copy">
                  <h3 class="w-proof__title">{webProof.hero.title}</h3>
                  <p class="w-proof__text">{webProof.hero.text}</p>
                </div>
                <div class="w-proof__meter" aria-hidden="true">
                  <div class="w-proof__meter-track">
                    <span class="w-proof__meter-fill" data-meter={webProof.hero.meterBase}></span>
                  </div>
                  <div class="w-proof__meter-labels">
                    <span>шаблонная база · {webProof.hero.meterBase}%</span>
                    <span>донастройка · {webProof.hero.meterTune}%</span>
                  </div>
                </div>
                <ol class="w-proof__steps">
                  {webProof.hero.steps.map((s) => (
                    <li>
                      <span class="w-proof__steps-n">{s.n}</span>
                      <strong>{s.title}</strong>
                      <p>{s.text}</p>
                    </li>
                  ))}
                </ol>
              </article>

              <div class="w-proof__rail">
                {webProof.items.map((item, i) => (
                  <article class={`w-proof__card w-proof__card--${i + 1}`}>
                    <p class="w-proof__label">{item.label}</p>
                    <p class="w-proof__value">
                      {item.value != null ? (
                        <span data-count={item.value}>0</span>
                      ) : (
                        <span class="w-proof__word">{item.display}</span>
                      )}
                      {item.unit ? <span class="w-proof__suffix">{item.unit}</span> : null}
                    </p>
                    <h3 class="w-proof__title">{item.title}</h3>
                    <p class="w-proof__text">{item.text}</p>
                    <ul class="w-proof__chips">
                      {item.chips.map((chip) =>
                        typeof chip === "string" ? (
                          <li>{chip}</li>
                        ) : (
                          <li class="w-proof__chip" tabindex="0">
                            <span class="w-proof__chip-label">{chip.label}</span>
                            <span class="w-proof__tip" role="tooltip">
                              <strong>{chip.what}</strong>
                              <em>{chip.how}</em>
                            </span>
                          </li>
                        ),
                      )}
                    </ul>
                  </article>
                ))}
              </div>
            </div>
          </section>

          <section class="w-section w-reveal" id="spectrum">
            <div class="w-section__head">
              <h2>{webSpectrum.title}</h2>
              <p>{webSpectrum.lead}</p>
            </div>

            <div class="w-compare" data-compare>
              <div class="w-compare__stage" data-compare-stage>
                <div class="w-compare__layer w-compare__layer--live" data-demo-live>
                  <div class="w-live">
                    <div class="w-live__mesh" data-live-mesh>
                      <div class="w-live__mesh-inner"></div>
                    </div>
                    <div class="w-live__orb w-live__orb--a" data-depth="0.04"><i></i></div>
                    <div class="w-live__orb w-live__orb--b" data-depth="0.08"><i></i></div>
                    <div class="w-live__orb w-live__orb--c" data-depth="0.12"><i></i></div>
                    <div
                      class="w-live__float w-live__float--a"
                      data-float
                      data-swap-card
                      data-slot="a"
                    >
                      <div class="w-live__float-inner" data-swap-face>
                        <span data-swap-value>+46%</span>
                        <small data-swap-label>к заявкам</small>
                      </div>
                    </div>
                    <div
                      class="w-live__float w-live__float--b"
                      data-float
                      data-swap-card
                      data-slot="b"
                    >
                      <div class="w-live__float-inner" data-swap-face>
                        <span data-swap-value>TOP</span>
                        <small data-swap-label>в выдаче</small>
                      </div>
                    </div>
                    <div class="w-live__stage" data-live-stage>
                      <p class="w-live__kicker">Живой блок</p>
                      <h4 class="w-live__title">Двигайте курсором</h4>
                      <div class="w-chart" data-chart>
                        <span style="--h:38%"></span>
                        <span style="--h:52%"></span>
                        <span style="--h:44%"></span>
                        <span style="--h:68%"></span>
                        <span style="--h:81%"></span>
                        <span style="--h:96%"></span>
                      </div>
                      <div class="w-live__stat">
                        <strong data-live-count="128">0</strong>
                        <span>заявок / мес.</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div
                  class="w-compare__layer w-compare__layer--strict"
                  data-compare-before
                  style="--compare: 52%"
                >
                  <div class="w-strict">
                    <header class="w-strict__bar">
                      <strong class="w-strict__logo">ACME · B2B</strong>
                      <nav>
                        <span>О нас</span>
                        <span>Услуги</span>
                        <span>Контакты</span>
                      </nav>
                    </header>
                    <div class="w-strict__hero">
                      <p class="w-strict__kicker">Корпоративный сайт</p>
                      <h4>Промышленные поставки<br />без лишнего шума</h4>
                      <p class="w-strict__lead">
                        Чёткая структура. Спокойная типографика. Никакой анимации.
                      </p>
                      <span class="w-strict__btn">Оставить заявку</span>
                    </div>
                    <div class="w-strict__row">
                      <div>
                        <em>01</em>
                        <span>Аудит</span>
                      </div>
                      <div>
                        <em>02</em>
                        <span>Поставка</span>
                      </div>
                      <div>
                        <em>03</em>
                        <span>Сервис</span>
                      </div>
                    </div>
                  </div>
                </div>

                <div class="w-compare__handle" data-compare-handle style="left: 52%">
                  <button
                    type="button"
                    class="w-compare__knob"
                    data-compare-knob
                    role="slider"
                    aria-valuemin="10"
                    aria-valuemax="90"
                    aria-valuenow="52"
                    aria-label="Сравнить строгий стиль и эффекты"
                  >
                    <span aria-hidden="true">↔</span>
                  </button>
                </div>

                <p class="w-compare__badge w-compare__badge--strict" aria-hidden="true">
                  {webSpectrum.strict.label}
                </p>
                <p class="w-compare__badge w-compare__badge--live" aria-hidden="true">
                  {webSpectrum.live.label}
                </p>
              </div>

              <div class="w-compare__copy">
                <article>
                  <p class="w-demo__label w-demo__label--muted">{webSpectrum.strict.label}</p>
                  <h3>{webSpectrum.strict.title}</h3>
                  <p>{webSpectrum.strict.text}</p>
                </article>
                <article>
                  <p class="w-demo__label">{webSpectrum.live.label}</p>
                  <h3>{webSpectrum.live.title}</h3>
                  <p>{webSpectrum.live.text}</p>
                </article>
              </div>
            </div>
          </section>

          <section class="w-section w-reveal">
            <div class="w-section__head">
              <h2>Зачем строить с нуля то, что рынок уже решил</h2>
              <p>
                Не тратим месяцы на проектирование и ручную вёрстку — берём
                проверенную основу и собираем под ваш бренд.
              </p>
            </div>
            <div class="w-nos">
              {
                webNos.map((item, i) => (
                  <article>
                    <span class="w-nos__mark">без 0{i + 1}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="w-section w-reveal">
            <div class="w-speed" data-speed-parallax>
              <div class="w-speed__scene" aria-hidden="true">
                <div class="w-speed__mesh" data-speed-mesh></div>
                <span class="w-speed__orb w-speed__orb--1" data-speed-depth="0.08"></span>
                <span class="w-speed__orb w-speed__orb--2" data-speed-depth="0.14"></span>
                <span class="w-speed__orb w-speed__orb--3" data-speed-depth="0.05"></span>
                <span class="w-speed__chip w-speed__chip--1" data-speed-float="1">−60%</span>
                <span class="w-speed__chip w-speed__chip--2" data-speed-float="-1">быстрее</span>
                <span class="w-speed__chip w-speed__chip--3" data-speed-float="0.7">без «с нуля»</span>
              </div>
              <div class="w-speed__copy">
                <p class="w-speed__stat">
                  <strong>−60%</strong>
                  <span>времени программиста на шаблонной основе</span>
                </p>
                <h2>{webSpeed.title}</h2>
                <p>{webSpeed.lead}</p>
                <p>{webSpeed.rest}</p>
              </div>
              <div class="w-speed__points">
                {
                  webSpeed.points.map((p) => (
                    <article data-speed-card>
                      <h3>{p.title}</h3>
                      <p>{p.text}</p>
                    </article>
                  ))
                }
              </div>
            </div>
          </section>

          <section class="w-section w-reveal">
            <div class="w-section__head">
              <h2>Под ваш бренд — не «как у всех»</h2>
              <p>
                Компонентная система: хедеры, карточки, формы, футеры. От строгого
                до живого — под задачу бизнеса.
              </p>
            </div>
            <div class="w-split">
              <div class="w-split__card w-split__card--accent">
                <h3>Есть брендбук</h3>
                <p>{webBrand.withBook}</p>
              </div>
              <div class="w-split__card">
                <h3>Пока нет материалов</h3>
                <p>{webBrand.without}</p>
              </div>
            </div>
          </section>

          <section class="w-section w-reveal">
            <div class="w-section__head">
              <h2>Платформы и удобство контента</h2>
              <p>
                Bitrix, Webasyst, WordPress, мультилендинг, Next.js, Astro, Laravel, Vue, Node.js и 1С — стек под задачу.
              </p>
            </div>
            <div class="w-marquee" aria-hidden="true">
              <div class="w-marquee__track">
                {[...webPlatforms, ...webPlatforms].map((p) => (
                  <span>{p.name}</span>
                ))}
              </div>
            </div>

            <div class="w-rail" data-rail>
              <div class="w-rail__toolbar">
                <p class="w-rail__hint">Листайте стек</p>
                <div class="w-rail__nav">
                  <button type="button" class="w-rail__btn" data-rail-prev aria-label="Назад">
                    ←
                  </button>
                  <button type="button" class="w-rail__btn" data-rail-next aria-label="Вперёд">
                    →
                  </button>
                </div>
              </div>
              <div class="w-rail__viewport" data-rail-viewport>
                <div class="w-rail__track" data-rail-track>
                  {
                    webPlatforms.map((p, i) => (
                      <article class="w-rail__card" data-rail-card style={`--i:${i}`}>
                        <span class="w-rail__idx">{String(i + 1).padStart(2, "0")}</span>
                        <h3>{p.name}</h3>
                        <p>{p.text}</p>
                      </article>
                    ))
                  }
                </div>
              </div>
            </div>
            <div class="w-cms">
              {
                webCms.map((c) => (
                  <article>
                    <h3>{c.title}</h3>
                    <p>{c.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="w-device w-reveal" id="products" data-device aria-labelledby="web-device-title">
            <div class="w-device__copy">
              <p class="w-device__eyebrow">{webDevice.eyebrow}</p>
              <h2 id="web-device-title">{webDevice.title}</h2>
              <p class="w-device__lead">{webDevice.lead}</p>

              <div class="w-device__tabs" role="tablist" aria-label="Форматы сайта">
                {
                  webProducts.map((p, i) => (
                    <button
                      type="button"
                      class:list={["w-device__tab", i === 0 && "is-active"]}
                      role="tab"
                      id={`device-tab-${p.id}`}
                      aria-selected={i === 0 ? "true" : "false"}
                      aria-controls={`device-panel-${p.id}`}
                      data-device-tab={p.id}
                      data-device-index={i}
                    >
                      <span class="w-device__tab-idx">0{i + 1}</span>
                      <span class="w-device__tab-body">
                        <strong>{p.title}</strong>
                        <em>{p.price}</em>
                      </span>
                    </button>
                  ))
                }
              </div>

              {
                webProducts.map((p, i) => (
                  <div
                    class:list={["w-device__panel", i === 0 && "is-active"]}
                    role="tabpanel"
                    id={`device-panel-${p.id}`}
                    aria-labelledby={`device-tab-${p.id}`}
                    data-device-panel={p.id}
                    hidden={i !== 0}
                  >
                    <p>{p.lead}</p>
                    <p class="w-device__note">{p.note}</p>
                    <div class="w-device__tags">
                      {p.tags.map((t) => (
                        <span>{t}</span>
                      ))}
                    </div>
                    <a href="#web-cta" class="w-btn w-btn--primary" data-ink-btn>Обсудить {p.title.toLowerCase()}</a>
                  </div>
                ))
              }
            </div>

            <div class="w-device__stage" aria-hidden="true">
              <div class="w-device__pulse" data-orbit-pulse>
                <i></i>
                <i></i>
                <i></i>
              </div>

              <ul class="w-device__orbit">
                {
                  webDevice.orbit.map((chip, i) => (
                    <li>
                      <span class="w-device__orbit-ripple"></span>
                      <span class="w-device__orbit-icon">{["◇", "▣", "◎", "◈", "⬡", "✦", "▣", "◇"][i] ?? "◆"}</span>
                      <span class="w-device__orbit-label">{chip}</span>
                    </li>
                  ))
                }
              </ul>

              {
                webDevice.floats.map((f, i) => (
                  <div class={`w-device__float w-device__float--${i + 1}`}>
                    <strong>{f.value}</strong>
                    <span>{f.label}</span>
                  </div>
                ))
              }

              <div class="w-phone-gallery" data-phone-gallery>
                <div class="w-phone w-phone--ghost w-phone--left">
                  <div class="w-phone__bezel">
                    <div class="w-phone__island"></div>
                    <div class="w-phone__screen">
                      <img
                        data-phone-ghost="prev"
                        src={webProducts[webProducts.length - 1].screen}
                        alt=""
                        loading="lazy"
                      />
                    </div>
                    <div class="w-phone__home"></div>
                  </div>
                </div>

                <div class="w-phone w-phone--ghost w-phone--right">
                  <div class="w-phone__bezel">
                    <div class="w-phone__island"></div>
                    <div class="w-phone__screen">
                      <img
                        data-phone-ghost="next"
                        src={webProducts[1].screen}
                        alt=""
                        loading="lazy"
                      />
                    </div>
                    <div class="w-phone__home"></div>
                  </div>
                </div>

                <div class="w-phone w-phone--main" data-phone>
                  <div class="w-phone__bezel">
                    <div class="w-phone__island"></div>
                    <div class="w-phone__screen">
                      {
                        webProducts.map((p, i) => (
                          <figure
                            class:list={["w-phone__slide", i === 0 && "is-active"]}
                            data-phone-slide={p.id}
                          >
                            <img src={p.screen} alt="" loading={i === 0 ? "eager" : "lazy"} />
                            <figcaption>
                              <span>{p.badge}</span>
                              <strong>{p.title}</strong>
                            </figcaption>
                          </figure>
                        ))
                      }
                    </div>
                    <div class="w-phone__home"></div>
                  </div>
                </div>
              </div>

              <div class="w-device__dots" role="tablist" aria-label="Форматы в телефоне">
                {
                  webProducts.map((p, i) => (
                    <button
                      type="button"
                      class:list={["w-device__dot", i === 0 && "is-active"]}
                      role="tab"
                      aria-selected={i === 0 ? "true" : "false"}
                      aria-controls={`device-panel-${p.id}`}
                      aria-label={p.title}
                      data-device-dot={i}
                    />
                  ))
                }
              </div>
            </div>
          </section>

          {
            webCases.length > 0 && (
              <section class="w-section w-reveal">
                <div class="w-section__head">
                  <h2>Кейсы по разработке</h2>
                  <p>От лендингов до магазинов — живые проекты, не макеты.</p>
                </div>
                <div class="w-cases">
                  {webCases.map((c) => (
                    <a href={`/keysy/${c.category}/${c.slug}/`} class="w-case">
                      <span class="w-case__media" aria-hidden="true">
                        <img src={c.cover} alt="" loading="lazy" />
                      </span>
                      <span class="w-case__shade" aria-hidden="true" />
                      <span class="w-case__copy">
                        <strong>{c.client}</strong>
                        <span>
                          {c.metric} · {c.metricLabel}
                        </span>
                      </span>
                    </a>
                  ))}
                </div>
                <p class="w-cases__more">
                  <a class="w-btn w-btn--line" href="/keysy/web/">
                    Все кейсы по разработке
                  </a>
                </p>
              </section>
            )
          }

          <section class="w-section w-reveal" id="faq">
            <div class="w-section__head">
              <h2>Частые вопросы</h2>
              <p>Шаблоны, сроки, форматы, стек и демо до старта.</p>
            </div>
            <div class="w-faq">
              {
                webFaq.map((item) => (
                  <details class="w-faq__item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))
              }
            </div>
          </section>

          <section id="web-cta" class="w-cta">
            <div class="w-cta__copy">
              <div>
                <h2>Хотите доверить создание сайта надёжным рукам?</h2>
                <p>
                  Оставьте заявку — подберём формат, покажем демо и оценим срок.
                </p>
                <ul class="w-cta__points">
                  <li>Демо шаблона до старта работ</li>
                  <li>Стиль: от строгого до эффектов</li>
                  <li>Лендинг, визитка, корпоратив или магазин</li>
                  <li>Срок — 1,5–3 мес. вместо 5–6 «с нуля»</li>
                </ul>
              </div>
              <div class="w-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="web-form" class="w-form">
              <label class="visually-hidden" for="web-name">Ваше имя</label>
              <input
                id="web-name"
                type="text"
                name="name"
                placeholder="Ваше имя"
                autocomplete="name"
                required
              />
              <label class="visually-hidden" for="web-phone">Телефон</label>
              <input
                id="web-phone"
                type="tel"
                name="phone"
                placeholder="Телефон"
                autocomplete="tel"
                required
              />
              <label class="visually-hidden" for="web-site">Сайт или соцсеть</label>
              <input
                id="web-site"
                type="url"
                name="site"
                placeholder="Сайт или соцсеть (если есть)"
                autocomplete="url"
              />
              <div class="w-select">
                <label class="w-select__label" for="web-type">Что нужно</label>
                <select id="web-type" name="type" data-w-select>
                  <option value="">Что нужно</option>
                  <option>Лендинг</option>
                  <option>Сайт-визитка</option>
                  <option>Корпоративный сайт</option>
                  <option>Интернет-магазин</option>
                  <option>Доработка текущего</option>
                </select>
              </div>
              <div class="w-select">
                <label class="w-select__label" for="web-style">Стиль сайта</label>
                <select id="web-style" name="style" data-w-select>
                  <option value="">Стиль сайта</option>
                  <option>Строгий / корпоративный</option>
                  <option>С эффектами и анимацией</option>
                  <option>Пока не определились</option>
                </select>
              </div>
              <label class="visually-hidden" for="web-message">Ниша и задача</label>
              <textarea
                id="web-message"
                name="message"
                rows="3"
                placeholder="Ниша и задача — коротко"
              ></textarea>
              <label class="w-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с нашей{" "}
                  <a
                    class="cookie-link"
                    href={legalDocs.privacy}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    >политикой</a
                  >.
                </span>
              </label>
              <button type="submit" class="w-btn w-btn--primary" data-ink-btn>Отправить заявку</button>
              <p id="web-form-hint" class="w-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Разработка сайтов · лендинг · магазин</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/razrabotka.ts";
      import "../scripts/web-robot.ts";
    </script>
  </body>
</html>
