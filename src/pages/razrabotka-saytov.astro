---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/razrabotka.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import { getCasesByCategory } from "../data/cases";
import {
  webNos,
  webSpeed,
  webBrand,
  webCms,
  webProducts,
  webSpectrum,
  webPlatforms,
} from "../data/web-service";

const webCases = getCasesByCategory("web").slice(0, 4);

const heroChips = [
  {
    title: "Архитектура",
    text: "готовые блоки UI под бренд — без месяцев дизайна с нуля.",
    badge: "UI kit",
  },
  {
    title: "Стек",
    text: "Bitrix, Webasyst, Next.js, Astro — под задачу бизнеса.",
    badge: "5 платформ",
  },
] as const;
---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="web">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Разработка сайтов: лендинг, мультилендинг, визитка, корпоратив и магазин. Bitrix, Webasyst, Next.js, Astro — быстрее и дешевле кастома с нуля."
    />
    <title>Разработка сайтов — ПРАЙМ</title>
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Sora:wght@400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell serviceActive="web" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Разработка сайтов</strong>
          </p>
          <a href="#web-cta" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content v6-content--web">
          <section class="w-hero" data-web-hero>
            <p class="w-hero__word" aria-hidden="true">ПРАЙМ</p>

            <div class="w-robot-shell" data-robot-shell>
              <div class="w-robot-shell__loader" aria-hidden="true">
                <span></span>
              </div>
              <canvas class="w-robot-canvas" data-spline-robot></canvas>
              <div class="w-robot-shell__fade" aria-hidden="true"></div>
              <div class="w-robot-shell__fallback" aria-hidden="true">
                <p>ПРАЙМ</p>
              </div>
            </div>

            <div class="w-hero__inner">
              <div class="w-hero__top">
                <h1>Сайты, которые<br />собирают заявки</h1>
                <p class="w-hero__lead">
                  Живой 3D и чёткая структура. Лендинги, визитки, корпоративы и
                  магазины на готовой архитектуре — быстрее и дешевле разработки
                  «с нуля».
                </p>
              </div>

              <div class="w-hero__spacer" aria-hidden="true"></div>

              <div class="w-hero__foot">
                <div class="w-hero__chips">
                  {
                    heroChips.map((m) => (
                      <div class="w-hero__chip">
                        <strong>{m.title}</strong>
                        <span>{m.text}</span>
                        <em>{m.badge}</em>
                      </div>
                    ))
                  }
                </div>
                <div class="w-hero__actions">
                  <a href="#web-cta" class="w-btn w-btn--primary">Оставить заявку</a>
                  <a href="#products" class="w-btn w-btn--ghost">Форматы и цены</a>
                </div>
                <a href="#spectrum" class="w-scroll" aria-label="Дальше">
                  <span class="w-scroll__ring">scroll down</span>
                  <span class="w-scroll__arrow">↓</span>
                </a>
              </div>
            </div>
          </section>

          <div class="w-specs w-reveal" data-specs>
            <div class="w-specs__item">
              <strong><span data-count="80">0</span>%</strong>
              <span>меньше часов на базу</span>
            </div>
            <div class="w-specs__item">
              <strong><span data-count="4">0</span></strong>
              <span>формата сайта</span>
            </div>
            <div class="w-specs__item">
              <strong><span data-count="5">0</span></strong>
              <span>платформ на выбор</span>
            </div>
            <div class="w-specs__item">
              <strong>недели</strong>
              <span>срок вместо месяцев</span>
            </div>
          </div>

          <section class="w-section w-reveal" id="spectrum">
            <div class="w-section__head">
              <h2>{webSpectrum.title}</h2>
              <p>{webSpectrum.lead}</p>
            </div>
            <div class="w-spectrum">
              <article class="w-demo w-demo--strict">
                <p class="w-demo__label">{webSpectrum.strict.label}</p>
                <div class="w-demo__frame" aria-hidden="true">
                  <div class="w-strict">
                    <header class="w-strict__bar">
                      <strong class="w-strict__logo">ACME · B2B</strong>
                      <nav>
                        <span>О нас</span>
                        <span>Услуги</span>
                        <span>Контакты</span>
                      </nav>
                    </header>
                    <div class="w-strict__hero">
                      <p class="w-strict__kicker">Корпоративный сайт</p>
                      <h4>Промышленные поставки<br />без лишнего шума</h4>
                      <p class="w-strict__lead">
                        Чёткая структура. Спокойная типографика. Никакой анимации.
                      </p>
                      <span class="w-strict__btn">Оставить заявку</span>
                    </div>
                    <div class="w-strict__row">
                      <div>
                        <em>01</em>
                        <span>Аудит</span>
                      </div>
                      <div>
                        <em>02</em>
                        <span>Поставка</span>
                      </div>
                      <div>
                        <em>03</em>
                        <span>Сервис</span>
                      </div>
                    </div>
                  </div>
                </div>
                <h3>{webSpectrum.strict.title}</h3>
                <p>{webSpectrum.strict.text}</p>
              </article>

              <article class="w-demo w-demo--live">
                <p class="w-demo__label">{webSpectrum.live.label}</p>
                <div
                  class="w-demo__frame w-demo__frame--live"
                  aria-hidden="true"
                  data-demo-live
                >
                  <div class="w-live">
                    <div class="w-live__mesh" data-live-mesh>
                      <div class="w-live__mesh-inner"></div>
                    </div>
                    <div class="w-live__orb w-live__orb--a" data-depth="0.04"><i></i></div>
                    <div class="w-live__orb w-live__orb--b" data-depth="0.08"><i></i></div>
                    <div class="w-live__orb w-live__orb--c" data-depth="0.12"><i></i></div>
                    <div class="w-live__float w-live__float--a" data-float>
                      <div class="w-live__float-inner">
                        <span>+46%</span>
                        <small>к заявкам</small>
                      </div>
                    </div>
                    <div class="w-live__float w-live__float--b" data-float>
                      <div class="w-live__float-inner">
                        <span>TOP</span>
                        <small>в выдаче</small>
                      </div>
                    </div>
                    <div class="w-live__stage" data-live-stage>
                      <p class="w-live__kicker">Живой блок</p>
                      <h4 class="w-live__title">Двигайте курсором</h4>
                      <div class="w-chart" data-chart>
                        <span style="--h:38%"></span>
                        <span style="--h:52%"></span>
                        <span style="--h:44%"></span>
                        <span style="--h:68%"></span>
                        <span style="--h:81%"></span>
                        <span style="--h:96%"></span>
                      </div>
                      <div class="w-live__stat">
                        <strong data-live-count="128">0</strong>
                        <span>заявок / мес.</span>
                      </div>
                    </div>
                  </div>
                </div>
                <h3>{webSpectrum.live.title}</h3>
                <p>{webSpectrum.live.text}</p>
              </article>
            </div>
          </section>

          <section class="w-section w-reveal">
            <div class="w-section__head">
              <h2>Зачем строить с нуля то, что рынок уже решил</h2>
              <p>
                Не тратим месяцы на проектирование и ручную вёрстку — берём
                проверенную основу и собираем под ваш бренд.
              </p>
            </div>
            <div class="w-nos">
              {
                webNos.map((item, i) => (
                  <article>
                    <span class="w-nos__mark">без 0{i + 1}</span>
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="w-section w-reveal">
            <div class="w-speed">
              <div class="w-speed__copy">
                <p class="w-speed__stat">
                  <strong>−80%</strong>
                  <span>времени программиста на шаблонной основе</span>
                </p>
                <h2>{webSpeed.title}</h2>
                <p>{webSpeed.lead}</p>
                <p>{webSpeed.rest}</p>
              </div>
              <div class="w-speed__points">
                {
                  webSpeed.points.map((p) => (
                    <article>
                      <h3>{p.title}</h3>
                      <p>{p.text}</p>
                    </article>
                  ))
                }
              </div>
            </div>
          </section>

          <section class="w-section w-reveal">
            <div class="w-section__head">
              <h2>Под ваш бренд — не «как у всех»</h2>
              <p>
                Компонентная система: хедеры, карточки, формы, футеры. От строгого
                до живого — под задачу бизнеса.
              </p>
            </div>
            <div class="w-split">
              <div class="w-split__card w-split__card--accent">
                <h3>Есть брендбук</h3>
                <p>{webBrand.withBook}</p>
              </div>
              <div class="w-split__card">
                <h3>Пока нет материалов</h3>
                <p>{webBrand.without}</p>
              </div>
            </div>
          </section>

          <section class="w-section w-reveal">
            <div class="w-section__head">
              <h2>Платформы и удобство контента</h2>
              <p>
                Bitrix, Webasyst, мультилендинг, Next.js и Astro — стек под задачу.
              </p>
            </div>
            <div class="w-marquee" aria-hidden="true">
              <div class="w-marquee__track">
                {[...webPlatforms, ...webPlatforms].map((p) => (
                  <span>{p.name}</span>
                ))}
              </div>
            </div>
            <div class="w-platforms">
              {
                webPlatforms.map((p) => (
                  <article>
                    <h3>{p.name}</h3>
                    <p>{p.text}</p>
                  </article>
                ))
              }
            </div>
            <div class="w-cms">
              {
                webCms.map((c) => (
                  <article>
                    <h3>{c.title}</h3>
                    <p>{c.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="w-section w-reveal" id="products">
            <div class="w-section__head">
              <h2>Форматы и цены</h2>
              <p>
                Подберём решение под задачу и дадим доступ к демо — чтобы
                протестировать функционал до старта.
              </p>
            </div>
            <div class="w-products">
              {
                webProducts.map((p) => (
                  <article
                    class:list={[
                      "w-product",
                      p.id === "shop" && "w-product--shop",
                    ]}
                  >
                    <div class="w-product__top">
                      <h3>{p.title}</h3>
                      <span class="w-product__price">{p.price}</span>
                    </div>
                    <p>{p.lead}</p>
                    <p class="w-product__note">{p.note}</p>
                    <div class="w-product__tags">
                      {p.tags.map((t) => (
                        <span>{t}</span>
                      ))}
                    </div>
                  </article>
                ))
              }
            </div>
          </section>

          {
            webCases.length > 0 && (
              <section class="w-section w-reveal">
                <div class="w-section__head">
                  <h2>Кейсы по разработке</h2>
                  <p>От лендингов до магазинов — живые проекты, не макеты.</p>
                </div>
                <div class="w-cases">
                  {webCases.map((c) => (
                    <a href={`/keysy/${c.category}/${c.slug}/`} class="w-case">
                      <span class="w-case__media" aria-hidden="true">
                        <img src={c.cover} alt="" loading="lazy" />
                      </span>
                      <span class="w-case__shade" aria-hidden="true" />
                      <span class="w-case__copy">
                        <strong>{c.client}</strong>
                        <span>
                          {c.metric} · {c.metricLabel}
                        </span>
                      </span>
                    </a>
                  ))}
                </div>
                <p class="w-cases__more">
                  <a class="w-btn w-btn--line" href="/keysy/web/">
                    Все кейсы по разработке
                  </a>
                </p>
              </section>
            )
          }

          <section id="web-cta" class="w-cta w-reveal">
            <div class="w-cta__copy">
              <div>
                <h2>Хотите доверить создание сайта надёжным рукам?</h2>
                <p>
                  Оставьте заявку — подберём формат, покажем демо и оценим срок.
                </p>
                <ul class="w-cta__points">
                  <li>Демо шаблона до старта работ</li>
                  <li>Стиль: от строгого до эффектов</li>
                  <li>Лендинг, визитка, корпоратив или магазин</li>
                  <li>Срок — недели, не месяцы «с нуля»</li>
                </ul>
              </div>
              <div class="w-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="web-form" class="w-form">
              <input type="text" name="name" placeholder="Ваше имя" required />
              <input type="tel" name="phone" placeholder="Телефон" required />
              <input type="url" name="site" placeholder="Сайт или соцсеть (если есть)" />
              <select name="type">
                <option value="">Что нужно</option>
                <option>Лендинг</option>
                <option>Сайт-визитка</option>
                <option>Корпоративный сайт</option>
                <option>Интернет-магазин</option>
                <option>Доработка текущего</option>
              </select>
              <select name="style">
                <option value="">Стиль сайта</option>
                <option>Строгий / корпоративный</option>
                <option>С эффектами и анимацией</option>
                <option>Пока не определились</option>
              </select>
              <textarea
                name="message"
                rows="3"
                placeholder="Ниша и задача — коротко"></textarea>
              <label class="w-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с нашей{" "}
                  <a
                    class="cookie-link"
                    href={legalDocs.privacy}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    >политикой</a
                  >.
                </span>
              </label>
              <button type="submit" class="w-btn w-btn--primary">Отправить заявку</button>
              <p id="web-form-hint" class="w-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Разработка сайтов · лендинг · магазин</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/razrabotka.ts";
      import "../scripts/web-robot.ts";
    </script>
  </body>
</html>
