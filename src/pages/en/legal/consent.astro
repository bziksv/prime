---
import LegalDocLayout from "../../../components/LegalDocLayout.astro";

const title = "Consent to personal data processing — PRIME";
const description =
  "Consent to personal data processing, including cookies, for the English version of prime-ltd.su.";
---

<LegalDocLayout title={title} description={description} path="/en/legal/consent/">
  <h1>Consent to personal data processing (including cookies)</h1>
  <p class="legal-lead">
    For <a href="https://prime-ltd.su/en/">https://prime-ltd.su/en/</a>. Related:
    <a href="/en/legal/privacy/">Privacy policy</a>,
    <a href="/en/legal/cookies/">Cookie policy</a>.
  </p>
  <p>
    By ticking the form checkbox or otherwise confirming, you freely give PRIME LLC (ООО «ПРАЙМ»,
    INN 3665107119, Voronezh, Moskovsky Prospekt 19, office 19) consent to process your personal
    data — including contact details from forms, technical data and cookies — for responding to
    requests, operating and improving the site, analytics where enabled, and related lawful
    purposes described in the Privacy policy.
  </p>
  <p>
    You may withdraw consent by emailing
    <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>. Full details and rights are in the
    Privacy policy.
  </p>
</LegalDocLayout>
