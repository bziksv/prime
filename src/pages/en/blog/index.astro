---
import "../../../styles/concept-v6.css";
import "../../../styles/concept-v6-media.css";
import "../../../styles/blog.css";
import PortalShell from "../../../components/PortalShell.astro";
import CookieConsent from "../../../components/CookieConsent.astro";
import CookieFooterNotice from "../../../components/CookieFooterNotice.astro";
import SiteSeo from "../../../components/SiteSeo.astro";
import { v6Icons } from "../../../data/v6-media";
import {
  blogPosts,
  getBaseViews,
  getReadingMinutes,
  toSearchDoc,
} from "../../../data/blog";
import { contactsPath } from "../../../i18n/contacts-content";
import {
  EN_BLOG_SLUGS,
  blogIndexI18n,
  blogPostPath,
  blogUi,
  formatReadingTimeLocale,
  formatViewsLocale,
  localizeBlogPost,
} from "../../../i18n/blog";
import { breadcrumbJsonLd } from "../../../lib/breadcrumb-jsonld";
import { jsonForScript } from "../../../lib/json-for-script";

const locale = "en" as const;
const ui = blogUi(locale);
const indexUi = blogIndexI18n(locale);
const posts = blogPosts
  .filter((p) => (EN_BLOG_SLUGS as readonly string[]).includes(p.slug))
  .map((p) => localizeBlogPost(p, locale));
const featured = posts[0];
const contactsHref = contactsPath(locale);

const categories = (() => {
  const map = new Map<string, number>();
  for (const p of posts) {
    map.set(p.category, (map.get(p.category) ?? 0) + 1);
  }
  return [...map.entries()]
    .map(([name, count]) => ({ name, count }))
    .sort((a, b) => b.count - a.count || a.name.localeCompare(b.name, "en"));
})();

const searchDocs = posts.map(toSearchDoc);

const blogDescription = `PRIME Blog: practical articles on SEO, ads, SMM, and digital marketing — from agency project experience.`;
const blogOgImage = (featured?.cover || "").split("?")[0] || undefined;
const crumbsLd = breadcrumbJsonLd(
  [
    { label: ui.home, href: "/en/" },
    { label: ui.blog },
  ],
  {
    origin: Astro.site?.origin ?? "https://prime-ltd.su",
    currentPath: "/en/blog/",
  },
);
---

<!doctype html>
<html lang="en" data-concept="v6" data-page="blog" data-locale="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={blogDescription} />
    <title>{ui.blog} — {ui.brand}</title>
    <SiteSeo
      title={`${ui.blog} — ${ui.brand}`}
      description={blogDescription}
      path="/en/blog/"
      image={blogOgImage}
      locale="en"
    />
    <link rel="alternate" hreflang="ru" href={new URL("/blog/", Astro.site ?? "https://prime-ltd.su").href} />
    <link rel="alternate" hreflang="en" href={new URL("/en/blog/", Astro.site ?? "https://prime-ltd.su").href} />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={jsonForScript(crumbsLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell active="blog" locale="en" />

      <main id="main" class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label={ui.menu} aria-controls="v6-sidebar" aria-expanded="false">☰</button>
          <p class="v6-breadcrumb">
            <a href="/en/">{ui.home}</a> · <strong>{ui.blog}</strong>
          </p>
          <a href={contactsHref} class="v6-btn">{ui.leaveRequest}</a>
        </header>

        <div class="v6-content" data-blog-index>
          <script type="application/json" data-blog-index-i18n set:html={jsonForScript(indexUi)} />
          <script type="application/json" data-blog-docs set:html={jsonForScript(searchDocs)} />

          <section class="b-hero">
            <p class="b-hero__kicker">{indexUi.kicker}</p>
            <h1>{ui.blog}</h1>
            <p class="b-hero__lead">{indexUi.lead}</p>

            <div class="b-search" role="search">
              <label class="b-search__label" for="blog-search-input">{indexUi.searchLabel}</label>
              <div class="b-search__row">
                <span class="b-search__icon" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                    <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="2"></circle>
                    <path d="M20 20l-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
                  </svg>
                </span>
                <input
                  id="blog-search-input"
                  type="search"
                  data-blog-search
                  placeholder={indexUi.searchPlaceholder}
                  autocomplete="off"
                  spellcheck="false"
                  enterkeyhint="search"
                />
                <kbd class="b-search__kbd">⌘K</kbd>
                <button type="button" class="b-search__clear" data-blog-search-clear hidden aria-label={indexUi.clearSearch}>
                  ×
                </button>
              </div>
              <p class="b-search__hint">{indexUi.searchHint}</p>
            </div>
          </section>

          <div class="b-toolbar">
            <div class="b-cats" role="group" aria-label={indexUi.catsLabel}>
              <button
                type="button"
                class="b-cat is-active"
                data-blog-cat="all"
                aria-pressed="true"
              >
                {indexUi.allLabel} <span>{posts.length}</span>
              </button>
              {
                categories.map((c) => (
                  <button
                    type="button"
                    class="b-cat"
                    data-blog-cat={c.name}
                    aria-pressed="false"
                  >
                    {c.name} <span>{c.count}</span>
                  </button>
                ))
              }
            </div>
            <p class="b-status" data-blog-status role="status" aria-live="polite"></p>
          </div>

          {
            featured ? (
              <a
                href={blogPostPath(featured.slug, locale)}
                class="b-featured"
                data-blog-featured
                data-slug={featured.slug}
                data-category={featured.category}
              >
                <div class="b-featured__media">
                  <img src={featured.cover} alt="" loading="eager" />
                </div>
                <div class="b-featured__body">
                  <div class="b-featured__meta">
                    <span class="b-featured__cat">{featured.category}</span>
                    <span class="b-meta-chip">{formatReadingTimeLocale(getReadingMinutes(featured), locale)}</span>
                    <span class="b-meta-chip">{formatViewsLocale(getBaseViews(featured), locale)} {indexUi.viewsShort}</span>
                  </div>
                  <h2>{featured.title}</h2>
                  <p>{featured.excerpt}</p>
                  <span class="b-read">
                    {indexUi.featuredRead}
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                  </span>
                </div>
              </a>
            ) : null
          }

          <div class="b-grid" data-blog-grid></div>
          <div class="b-more" data-blog-more hidden>
            <button type="button" class="b-more__btn" data-blog-more-btn>
              {indexUi.showMore}
            </button>
            <p class="b-more__meta" data-blog-more-meta></p>
          </div>
          <p class="b-empty" data-blog-empty hidden></p>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>{ui.brand}</strong>
            <p>{ui.footerTagline}</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} {ui.brand}</p>
          <CookieFooterNotice locale="en" />
        </footer>
      </main>
    </div>

    <CookieConsent locale="en" />
    <script>
      import "../../../scripts/concept-v6.ts";
      import "../../../scripts/blog-ui.ts";
    </script>
  </body>
</html>
