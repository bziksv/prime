---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/analitika.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import {
  analyticsWhy,
  analyticsProblem,
  analyticsTrack,
  analyticsFeatures,
  analyticsExtra,
  analyticsPlans,
  analyticsNote,
  analyticsOutcomes,
  analyticsNos,
  analyticsFaq,
} from "../data/analytics-service";
import { breadcrumbJsonLd } from "../lib/breadcrumb-jsonld";
import { serviceJsonLd } from "../lib/service-jsonld";

const pageTitle = "Сквозная аналитика — ПРАЙМ";
const pageDescription =
  "Сквозная аналитика Roistat: реклама → сайт → CRM. Коллтрекинг, формы, email. Видно, какой канал даёт заявки и продажи. Интеграция и настройка.";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: analyticsFaq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
const crumbsLd = breadcrumbJsonLd(
  [
    { label: "Главная", href: "/" },
    { label: "Сквозная аналитика" },
  ],
  {
    origin: Astro.site?.origin ?? "https://prime-ltd.su",
    currentPath: "/skvoznaya-analitika/",
  },
);

const serviceLd = serviceJsonLd({
  name: "Сквозная аналитика",
  description: pageDescription,
  path: "/skvoznaya-analitika/",
  serviceType: "Сквозная аналитика",
  origin: Astro.site?.origin ?? "https://prime-ltd.su",
});

---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="analytics">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <SiteSeo
      title={pageTitle}
      description={pageDescription}
      path="/skvoznaya-analitika/"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preload" as="image" href="/images/v6/photos/analytics-hero.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;1,6..12,400&family=Oxanium:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell serviceActive="analytics" />

      <main id="main" class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню" aria-controls="v6-sidebar" aria-expanded="false">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Сквозная аналитика</strong>
          </p>
          <a href="#analytics-cta" class="v6-btn">Оставить заявку</a>
        </header>

        <div class="v6-content">
          <section class="n-hero" data-n-hero>
            <div class="n-hero__bg" aria-hidden="true" data-parallax-analytics-bg></div>
            <div class="n-hero__veil" aria-hidden="true"></div>

            <div class="n-hero__mesh" aria-hidden="true" data-n-mesh>
              <svg class="n-mesh" viewBox="0 0 640 420" preserveAspectRatio="xMidYMid slice">
                <defs>
                  <radialGradient id="n-mesh-glow" cx="50%" cy="40%" r="55%">
                    <stop offset="0%" stop-color="rgba(107,124,255,0.35)"></stop>
                    <stop offset="100%" stop-color="rgba(107,124,255,0)"></stop>
                  </radialGradient>
                </defs>
                <circle class="n-mesh__aura" cx="420" cy="160" r="160" fill="url(#n-mesh-glow)"></circle>
                <g class="n-mesh__links" fill="none" stroke="rgba(241,243,248,0.18)" stroke-width="1">
                  <path d="M80 70 L180 120 L290 90 L400 150 L520 110"></path>
                  <path d="M120 220 L210 180 L310 240 L430 200 L560 260"></path>
                  <path d="M180 120 L210 180 L290 90 L310 240 L400 150 L430 200"></path>
                  <path d="M290 90 L310 240 L400 150 L520 110 L560 260"></path>
                </g>
                <g class="n-mesh__nodes" fill="#9aa8ff">
                  <circle cx="80" cy="70" r="3.5"></circle>
                  <circle cx="180" cy="120" r="4.5" class="n-mesh__node--hot"></circle>
                  <circle cx="290" cy="90" r="3.5"></circle>
                  <circle cx="400" cy="150" r="5" class="n-mesh__node--hot"></circle>
                  <circle cx="520" cy="110" r="3.5"></circle>
                  <circle cx="120" cy="220" r="3"></circle>
                  <circle cx="210" cy="180" r="4" class="n-mesh__node--hot"></circle>
                  <circle cx="310" cy="240" r="3.5"></circle>
                  <circle cx="430" cy="200" r="4.5" class="n-mesh__node--hot"></circle>
                  <circle cx="560" cy="260" r="3.5"></circle>
                </g>
                <circle class="n-mesh__ping" cx="210" cy="180" r="4"></circle>
                <circle class="n-mesh__ping n-mesh__ping--2" cx="400" cy="150" r="4"></circle>
                <circle class="n-mesh__ping n-mesh__ping--3" cx="430" cy="200" r="4"></circle>
              </svg>
            </div>

            <div class="n-hero__copy">
              <p class="n-brand">ПРАЙ<em>М</em></p>
              <h1>
                Сквозная аналитика — видно, какой канал <span>даёт продажи</span>
              </h1>
              <p class="n-hero__lead">
                Связка рекламы, сайта и CRM на базе Roistat: звонки, формы и
                email с источником. Платите за каналы, которые реально работают.
              </p>
              <div class="n-hero__actions">
                <a href="#analytics-cta" class="n-btn n-btn--primary n-btn--glow"
                  >Подключить аналитику</a
                >
                <a href="#plans" class="n-btn n-btn--ghost">Смотреть тарифы</a>
              </div>
            </div>

            <div class="n-hero__flow" aria-hidden="true" data-n-flow>
              <div class="n-flow">
                <div class="n-flow__head">
                  <span class="n-flow__live"><i></i> LIVE TRACE</span>
                  <span class="n-flow__tag">ads → site → CRM</span>
                </div>

                <div class="n-flow__node is-active" data-n-node="0">
                  <span class="n-flow__dot"></span>
                  <div>
                    <strong>Реклама</strong>
                    <span>Директ · Ads · офлайн</span>
                  </div>
                  <em class="n-flow__hit" data-n-hit>клик</em>
                </div>
                <div class="n-flow__wire">
                  <i class="n-flow__packet"></i>
                  <i class="n-flow__packet n-flow__packet--delay"></i>
                </div>
                <div class="n-flow__node" data-n-node="1">
                  <span class="n-flow__dot"></span>
                  <div>
                    <strong>Сайт</strong>
                    <span>визит · форма · звонок</span>
                  </div>
                  <em class="n-flow__hit" data-n-hit>лид</em>
                </div>
                <div class="n-flow__wire n-flow__wire--2">
                  <i class="n-flow__packet"></i>
                  <i class="n-flow__packet n-flow__packet--delay"></i>
                </div>
                <div class="n-flow__node" data-n-node="2">
                  <span class="n-flow__dot"></span>
                  <div>
                    <strong>CRM · сделка</strong>
                    <span>источник → результат</span>
                  </div>
                  <em class="n-flow__hit" data-n-hit>sale</em>
                </div>

                <div class="n-flow__stats">
                  <div>
                    <span>ROAS</span>
                    <strong data-n-roas>4.2×</strong>
                  </div>
                  <div>
                    <span>сделки / сут</span>
                    <strong data-n-deals>18</strong>
                  </div>
                  <div>
                    <span>атрибуция</span>
                    <strong data-n-attr>on</strong>
                  </div>
                </div>
              </div>
            </div>
          </section>

          <section class="n-why n-reveal">
            <div>
              <h2>Для чего нужна сквозная аналитика</h2>
              <p>{analyticsWhy.lead}</p>
              <p>{analyticsWhy.channels}</p>
              <p>{analyticsWhy.answer}</p>
            </div>
            <div class="n-why__stat">
              <strong data-analytics-stat>до 300%</strong>
              <span>потенциал оптимизации рекламы при ясной атрибуции каналов</span>
            </div>
          </section>

          <section class="n-section n-reveal">
            <div class="n-section__head">
              <h2>Что ломается без сквозной связки</h2>
              <p>Косвенные цифры не отвечают, кто реально привёл клиента.</p>
            </div>
            <div class="n-problem">
              {
                analyticsProblem.map((p) => (
                  <article>
                    <h3>{p.title}</h3>
                    <p>{p.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="n-section n-reveal">
            <div class="n-section__head">
              <h2>Какие каналы отслеживаем</h2>
              <p>
                Roistat фиксирует обращения, которые обычная веб-аналитика
                «теряет» — и создаёт заявку в CRM с источником.
              </p>
            </div>
            <div class="n-track">
              {
                analyticsTrack.map((t) => (
                  <article>
                    <h3>{t.title}</h3>
                    <p>{t.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="n-section n-reveal">
            <div class="n-section__head">
              <h2>Возможности системы</h2>
              <p>Базовый контур и расширенный функционал под рост продаж.</p>
            </div>
            <div class="n-features">
              {
                analyticsFeatures.map((f) => (
                  <article class="n-feature">
                    <h3>{f.title}</h3>
                    <p>{f.text}</p>
                  </article>
                ))
              }
            </div>
            <div class="n-extra">
              {analyticsExtra.map((e) => <span>{e}</span>)}
            </div>
          </section>

          <section class="n-section n-reveal" id="plans">
            <div class="n-section__head">
              <h2>Стоимость</h2>
              <p>Тарифы зависят от суммы визитов по всем проектам аккаунта.</p>
            </div>
            <div class="n-plans">
              {
                analyticsPlans.map((p) => (
                  <article
                    class:list={["n-plan", p.featured && "n-plan--featured"]}
                  >
                    {p.featured && <span class="n-plan__badge">Частый выбор</span>}
                    <p class="n-plan__visits">{p.visits} визитов / мес</p>
                    <p class="n-plan__price">{p.price}</p>
                    <p class="n-plan__unit">{p.unit}</p>
                    <p>{p.projects} · сайтов без ограничений</p>
                    <a href="#analytics-cta" class="n-btn n-btn--line">Оставить заявку</a>
                  </article>
                ))
              }
            </div>
            <p class="n-note">{analyticsNote}</p>
          </section>

          <section class="n-section n-reveal">
            <div class="n-section__head">
              <h2>Что меняется после внедрения</h2>
              <p>Не ещё один отчёт — связка, по которой можно резать и усиливать бюджет.</p>
            </div>
            <div class="n-outcomes">
              {
                analyticsOutcomes.map((item) => (
                  <article class="n-outcome">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="n-section n-reveal">
            <div class="n-section__head">
              <h2>Чего не обещаем</h2>
              <p>Чтобы сквозная аналитика не звучала как «волшебная кнопка».</p>
            </div>
            <div class="n-nos">
              {
                analyticsNos.map((item) => (
                  <article class="n-no">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="n-section n-reveal" id="faq">
            <div class="n-section__head">
              <h2>Частые вопросы</h2>
              <p>Метрика, CRM, коллтрекинг и сроки внедрения.</p>
            </div>
            <div class="n-faq">
              {
                analyticsFaq.map((item) => (
                  <details class="n-faq__item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))
              }
            </div>
          </section>

          <section id="analytics-cta" class="n-cta n-reveal">
            <div>
              <h2>Предложение интересно?</h2>
              <p>
                Оставьте заявку — свяжемся и подберём тариф под визиты и CRM.
                Или позвоните: +7 (473) 203-01-24.
              </p>
              <div class="n-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="analytics-form" class="n-form">
              <label class="visually-hidden" for="analytics-name">Ваше имя</label>
              <input
                id="analytics-name"
                type="text"
                name="name"
                placeholder="Ваше имя"
                autocomplete="name"
                required
              />
              <label class="visually-hidden" for="analytics-phone">Телефон</label>
              <input
                id="analytics-phone"
                type="tel"
                name="phone"
                placeholder="Телефон"
                autocomplete="tel"
                required
              />
              <label class="visually-hidden" for="analytics-site">Адрес сайта</label>
              <input
                id="analytics-site"
                type="url"
                name="site"
                placeholder="Адрес сайта"
                autocomplete="url"
              />
              <label class="visually-hidden" for="analytics-crm">CRM / учёт</label>
              <select id="analytics-crm" name="crm">
                <option value="">CRM / учёт</option>
                <option>Bitrix24</option>
                <option>amoCRM</option>
                <option>1С</option>
                <option>Другая / пока нет</option>
              </select>
              <label class="visually-hidden" for="analytics-message">Каналы и объём трафика</label>
              <textarea
                id="analytics-message"
                name="message"
                rows="3"
                placeholder="Каналы и объём трафика — коротко"
              ></textarea>
              <label class="n-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с{" "}
                  <span class="n-form__check-link"
                    >нашей{" "}
                    <a
                      class="cookie-link"
                      href={legalDocs.privacy}
                      target="_blank"
                      rel="nofollow noopener noreferrer">политикой</a>.</span
                  >
                </span>
              </label>
              <button type="submit" class="n-btn n-btn--primary">Отправить заявку</button>
              <p id="analytics-form-hint" class="n-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Сквозная аналитика · Roistat · CRM</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </main>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/analitika.ts";
    </script>
  </body>
</html>
