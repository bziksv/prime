---
import "../styles/concept-v6.css";
import "../styles/concept-v6-media.css";
import "../styles/partnerstvo.css";
import PortalShell from "../components/PortalShell.astro";
import CookieConsent from "../components/CookieConsent.astro";
import CookieFooterNotice from "../components/CookieFooterNotice.astro";
import SiteSeo from "../components/SiteSeo.astro";
import { v6Icons } from "../data/v6-media";
import { legalDocs } from "../data/legal";
import {
  partnerBenefits,
  partnerSteps,
  partnerStats,
  partnerCases,
  partnerWhy,
  partnerOutcomes,
  partnerNos,
  partnerFaq,
} from "../data/partnerstvo";
import { breadcrumbJsonLd } from "../lib/breadcrumb-jsonld";

const marquee = [...partnerCases, ...partnerCases];

const pageTitle = "Партнерство — ПРАЙМ";
const pageDescription =
  "Партнёрство с ПРАЙМ: рекомендуйте интернет-маркетинг, получайте процент. Прозрачные отчёты, договор и выплаты раз в месяц.";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: partnerFaq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
const crumbsLd = breadcrumbJsonLd(
  [
    { label: "Главная", href: "/" },
    { label: "Партнерство" },
  ],
  {
    origin: Astro.site?.origin ?? "https://prime-ltd.su",
    currentPath: "/partnerstvo/",
  },
);

---

<!doctype html>
<html lang="ru" data-concept="v6" data-page="partnerstvo">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <SiteSeo
      title={pageTitle}
      description={pageDescription}
      path="/partnerstvo/"
    />
    <link rel="icon" href="/images/v6/favicon.ico" sizes="any" />
    <link rel="icon" href={v6Icons.logoMark} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Unbounded:wght@500;700&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
  </head>
  <body>
    <div class="v6-app">
      <PortalShell active="partnerstvo" />

      <div class="v6-main">
        <header class="v6-topbar">
          <button id="v6-burger" type="button" class="v6-burger" aria-label="Меню">☰</button>
          <p class="v6-breadcrumb">
            <a href="/">Главная</a> · <strong>Партнерство</strong>
          </p>
          <a href="#partner-cta" class="v6-btn">Стать партнёром</a>
        </header>

        <div class="v6-content">
          <section class="p-hero" data-parallax-hero>
            <div class="p-hero__photo" aria-hidden="true" data-parallax-hero-bg></div>
            <div class="p-hero__orb p-hero__orb--1" aria-hidden="true"></div>
            <div class="p-hero__orb p-hero__orb--2" aria-hidden="true"></div>
            <div class="p-hero__orb p-hero__orb--3" aria-hidden="true"></div>
            <div class="p-hero__grid" aria-hidden="true"></div>
            <div class="p-hero__inner">
              <p class="p-kicker">Партнёрская программа</p>
              <h1>Рекомендуете ПРАЙМ — <em>зарабатываете</em> вместе с нами</h1>
              <p class="p-hero__lead">
                Приводите клиентов на SEO, контекст и разработку. Мы ведём проекты,
                отчитываемся каждый месяц и платим партнёрам по факту — официально
                и прозрачно.
              </p>
              <div class="p-hero__actions">
                <a href="#partner-cta" class="p-btn p-btn--primary">Стать партнёром</a>
                <a href="#why" class="p-btn p-btn--ghost">Почему с нами</a>
              </div>
            </div>
            <div class="p-hero__stripe" aria-hidden="true"></div>
          </section>

          <div class="p-marquee" aria-hidden="true">
            <div class="p-marquee__track">
              {
                marquee.map((c) => (
                  <span>
                    {c.name}
                    <em>{c.tag}</em>
                  </span>
                ))
              }
            </div>
          </div>

          <section id="why" class="p-section p-reveal">
            <div class="p-section__head">
              <h2>Почему стоит сотрудничать с нами</h2>
              <p>Те же принципы, что на оригинальном сайте — только в упаковке, которой хочется делиться.</p>
            </div>
            <div class="p-benefits">
              {
                partnerBenefits.map((b, i) => (
                  <article class={`p-benefit p-benefit--${b.tone}`}>
                    <span class="p-benefit__idx">0{i + 1}</span>
                    <h3>{b.title}</h3>
                    <p>{b.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="p-section p-reveal">
            <div class="p-section__head">
              <h2>Что вы получаете как партнёр</h2>
              <p>Коротко и по делу — без скрытых условий.</p>
            </div>
            <ul class="p-why">
              {partnerWhy.map((item) => <li>{item}</li>)}
            </ul>
          </section>

          <section class="p-section p-reveal">
            <div class="p-section__head">
              <h2>Нам есть чем гордиться — кейсы</h2>
              <p>Проекты, которые мы ведём и которыми не стесняемся делиться с партнёрами.</p>
            </div>
            <div class="p-cases">
              {
                partnerCases.map((c) => (
                  <a href={c.href} class="p-case" data-parallax-card>
                    <span class="p-case__media" aria-hidden="true">
                      <img src={c.image} alt="" loading="lazy" data-parallax-img />
                    </span>
                    <span class="p-case__shade" aria-hidden="true"></span>
                    <span class="p-case__copy">
                      <strong>{c.name}</strong>
                      <span>{c.tag}</span>
                    </span>
                  </a>
                ))
              }
            </div>
            <p style="margin-top:1.25rem">
              <a class="p-btn p-btn--ghost" href="/keysy/">Смотреть все кейсы</a>
            </p>
          </section>

          <section class="p-section p-reveal">
            <div class="p-section__head">
              <h2>Как начать сотрудничество</h2>
              <p>Четыре шага — от письма до первой передачи клиента.</p>
            </div>
            <div class="p-steps">
              {
                partnerSteps.map((s) => (
                  <article class="p-step">
                    <span class="p-step__n">{s.n}</span>
                    <h3>{s.title}</h3>
                    <p>{s.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="p-section p-reveal">
            <div class="p-section__head">
              <h2>И немного цифр</h2>
              <p>Инфографика партнёрской программы — ориентиры по срокам и выплатам.</p>
            </div>
            <div class="p-stats">
              {
                partnerStats.map((s) => (
                  <article class="p-stat">
                    <strong class="p-stat__value">
                      <span
                        class="p-stat__num"
                        data-value={s.value}
                        data-decimals={"decimals" in s ? s.decimals : 0}
                      >
                        0
                      </span>
                      {s.suffix}
                    </strong>
                    <span class="p-stat__label">{s.label}</span>
                    <p class="p-stat__desc">{s.desc}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="p-section p-reveal">
            <div class="p-section__head">
              <h2>Что получаете как партнёр</h2>
              <p>Доход с рекомендаций — без ведения проектов и «серых» схем.</p>
            </div>
            <div class="p-outcomes">
              {
                partnerOutcomes.map((item) => (
                  <article class="p-outcome">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="p-section p-reveal">
            <div class="p-section__head">
              <h2>Чего здесь нет</h2>
              <p>Чтобы партнёрство не путали с MLM и обещаниями «с первого звонка».</p>
            </div>
            <div class="p-nos">
              {
                partnerNos.map((item) => (
                  <article class="p-no">
                    <h3>{item.title}</h3>
                    <p>{item.text}</p>
                  </article>
                ))
              }
            </div>
          </section>

          <section class="p-section p-reveal" id="faq">
            <div class="p-section__head">
              <h2>Частые вопросы</h2>
              <p>Кто подходит, как платим и нужно ли вести проект самому.</p>
            </div>
            <div class="p-faq">
              {
                partnerFaq.map((item) => (
                  <details class="p-faq__item">
                    <summary>{item.q}</summary>
                    <p>{item.a}</p>
                  </details>
                ))
              }
            </div>
          </section>

          <section id="partner-cta" class="p-cta p-reveal">
            <div>
              <h2>Оставьте заявку — и мы свяжемся</h2>
              <p>
                Мы на рынке с 2015 года — за это время немало агентств закрылось.
                Расскажите формат сотрудничества: ответим, разберём условия и пришлём договор.
              </p>
              <div class="p-cta__contacts">
                <a href="mailto:info@prime-ltd.su">info@prime-ltd.su</a>
                <a href="tel:+74732030124">+7 (473) 203-01-24</a>
              </div>
            </div>
            <form id="partner-form" class="p-form">
              <label class="visually-hidden" for="partner-name">Ваше имя</label>
              <input
                id="partner-name"
                type="text"
                name="name"
                placeholder="Ваше имя"
                autocomplete="name"
                required
              />
              <label class="visually-hidden" for="partner-phone">Телефон</label>
              <input
                id="partner-phone"
                type="tel"
                name="phone"
                placeholder="Телефон"
                autocomplete="tel"
                required
              />
              <label class="visually-hidden" for="partner-email">Email</label>
              <input
                id="partner-email"
                type="email"
                name="email"
                placeholder="Email"
                autocomplete="email"
              />
              <label class="visually-hidden" for="partner-type">Формат сотрудничества</label>
              <select id="partner-type" name="type">
                <option value="">Формат сотрудничества</option>
                <option>Рекомендации клиентов</option>
                <option>Агентство / подрядчик</option>
                <option>Фриланс / консультант</option>
                <option>Другое</option>
              </select>
              <label class="visually-hidden" for="partner-message">О себе и аудитории</label>
              <textarea
                id="partner-message"
                name="message"
                rows="3"
                placeholder="Коротко о себе и аудитории"
              ></textarea>
              <label class="p-form__check">
                <input type="checkbox" name="agree" required />
                <span>
                  Согласен на обработку персональных данных в соответствии с нашей{" "}
                  <a
                    class="cookie-link"
                    href={legalDocs.privacy}
                    target="_blank"
                    rel="nofollow noopener noreferrer"
                    >политикой</a
                  >.
                </span>
              </label>
              <button type="submit" class="p-btn p-btn--primary">Отправить заявку</button>
              <p id="partner-form-hint" class="p-form-hint" hidden></p>
            </form>
          </section>
        </div>

        <footer class="v6-footer">
          <div class="v6-footer__brand">
            <strong>ПРАЙМ</strong>
            <p>Партнёрская программа · интернет-маркетинг</p>
          </div>
          <p>© 2015–{new Date().getFullYear()} ПРАЙМ</p>
          <CookieFooterNotice />
        </footer>
      </div>
    </div>

    <CookieConsent />
    <script>
      import "../scripts/partnerstvo.ts";
    </script>
  </body>
</html>
